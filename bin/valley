#!/usr/bin/env bash
# valley — the S1 integrator's verbs, as a plain shell script.
#
# EVICTION CLAUSE (owner-ratified; the decision node is
# archive/.the-valley/decisions/dcr-74c3158-valley-cli-lifecycle.md).
# This tool is deliberately a shell script: it runs from any checkout with
# nothing but git and coreutils — no machinery, the portability stance of
# ida-b9f646c. It GRADUATES to its own repo and a real language the moment
# ANY tripwire is crossed:
#   - it grows past ~300 lines;
#   - it needs persistent state, config, or a daemon
#     (CROSSED by review's notes, which outlive the session in
#     $XDG_STATE_HOME/valley/notes.);
#   - it needs dependencies beyond git + coreutils
#     (CROSSED by Phase 1's tail/replay, which need the nats CLI, and again
#     by checks, which needs the cue CLI, again by review's [a]pprove, which
#     needs the attest helper, and again by status, ready, unready and
#     withdraw, which are a Go program (status/) this script runs —
#     graduation is now due; recording the decision node is part of taking it.);
#   - its behavior gets subtle enough to need real tests
#     (CROSSED by checks: glob matching is pinned by the policy-deriver
#     flake check, not by reading the code.);
#   - it needs nontrivial parsing or concurrency
#     (CROSSED by checks: glob-to-regex translation and -z diff parsing.).
# The size tripwire (~300 lines) is crossed too. Which way to take the
# graduation is dcr-2aa1a12, still `proposed`.
# Graduation is a deliberate act, recorded as a decision node.
# Precedent: klaus — born in cosmo, graduated deliberately.

set -euo pipefail

# Every verb reads the repository's own objects. A replacement ref makes one
# object stand in for another wherever git looks it up, so a fetched or
# planted refs/replace/* could change the diff a reviewer reads, the policy
# a derivation composes, and the tree a request is filed for. git is told
# to ignore them, whatever configuration says, and the variables that point
# it at other objects or at another replacement namespace are dropped. What
# chooses the repository and the person's own configuration are kept: a
# fetch of the owning valley needs that configuration, and neither changes
# what an object id reads as once replacement refs are off.
export GIT_NO_REPLACE_OBJECTS=1
unset GIT_REPLACE_REF_BASE GIT_GRAFT_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

# The version the package stamped on this script when nix built it
# (nix/packages.nix): the CLI's version and the commit it was built from.
# A script run straight from a checkout has none. It is taken here and
# unset, so no program this script runs inherits a stamp that is not its
# own; self-update is handed it explicitly.
VALLEY_STAMP="${VALLEY_VERSION:-}"
unset VALLEY_VERSION

die() {
  printf 'valley: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
valley — S1 integrator verbs for a valley project

usage: valley <verb> [args]

  pending [--all] [--repo <name>] [--checks] [--json] [-v]
                   list what is waiting to land, in three sections: ready,
                   the ready changes whose active version has not landed;
                   branches, each branch on origin that main does not
                   reach and that is no change's active head; and drafts,
                   the changes whose record says they are drafts. each
                   entry is a block. its first line is its name, with its
                   head's age and author: handle and version for a change,
                   the branch for a branch, and handle and version on its
                   branch for a draft. under it come its title (the
                   record's for a change, followed by the first linked
                   knot's id; the subject of its first own commit for a
                   branch), then the commits and the diff it
                   adds to its base: the nearest other entry its head
                   strictly contains, or main. a stack is its top entry,
                   then every entry the top contains, listed under it at
                   one indentation, each before the entries it contains
                   (ancestry alone: approving the top lands everything
                   listed under it, and the top says how many). each
                   listed entry is on the one listed after it, or says
                   `on <base>`, as at a fork. a listed entry is marked
                   when it is from another section. a
                   change also says `includes <handle>` for a change its
                   head contains that is no entry, such as a withdrawn
                   one, and `uncertain` when the version may have landed
                   without its evidence being stored. the stack with the
                   latest commit comes first. lines fit the terminal, or
                   80 columns off one; titles are cut short with …, names
                   never. names are bold on a terminal unless NO_COLOR is
                   set.
                     --all        every project the serving host
                                  publishes, each headed by its name (see
                                  changes below)
                     --repo NAME  that one project
                     --checks     add a line to each change with the
                                  checks the policy requires of it, by
                                  cost, as checks derives them
                     --json       print valley-pending/v1: the
                                  valley-changes/v1 shape, with the
                                  pending changes in changes and the
                                  drafts in drafts
                     -v           warn on stderr when a plan graph is
                                  missing or unreadable
                   needs the valley-go helper.
  changes --json [--all] [--repo <name>] [-v]
                   print every change origin holds a record of, in every
                   state, as one JSON object, valley-changes/v1, for front
                   ends to read (docs/architecture.md): each version's
                   head, title and branch, how far it has landed
                   (landed, landed-recorded, uncertain or not-landed),
                   its pending request and its last outcome, the knots in
                   refs/the-valley/knots that link it
                   (valley:<project>/<change id>, active first), and
                   the branches no change is on. -v warns on stderr when a
                   plan graph is missing or unreadable.
                   handles are unique across
                   everything listed: a change id recorded in more than
                   one repository listed has the handle <repo>:<prefix>
                   in each. without --all it covers this
                   repository. --all covers every project the serving
                   host lists at refs/the-valley/projects in its instance
                   repository, which policy/valley names at main's tip on
                   origin; each project's URL is the instance's with its
                   last path segment replaced, and is read through a clone
                   kept under $XDG_CACHE_HOME/valley/repos. a url that
                   opens with a dash, names a <transport>:: helper such
                   as ext::, or has a scheme other than ssh, git, https or
                   file is refused. a repository that cannot be read is
                   listed with its error. --repo limits it to one
                   project. landed means on main's first-parent history
                   with no merge above it. landed-recorded needs a landed
                   commit with one parent and the integrator's transfer
                   statement for the version's request name, verified;
                   the integrator's outcome record for that name saying
                   land at the version's head; and the integrator's merge
                   of the head onto the landed commit's parent giving the
                   landed tree. the statement is verified with these:
                   VALLEY_KNOWN_SIGNERS names the registry's known-signers
                   file and VALLEY_INTEGRATOR_SIGNER the integrator's
                   signing name, and attest checks the note.
                   needs the valley-go helper.
  review [-v] <change>
                   page through the change's branch: its log and diff vs
                   origin/main, or a stack layer by layer (below). above
                   each change's diff, review shows every knot in the plan
                   graph that links the change, as `does oc-6335749 (open):
                   <title>` (valley-go does). a missing or unreadable graph
                   shows no knots; -v warns on stderr. then choose:
                     [a]pprove    file an integration request for the
                                  head shown. runs the
                                  checks the composed policy requires of
                                  this change over a throwaway worktree of
                                  that head, signs each result as an
                                  attestation, and publishes the evidence
                                  and the request ref to origin in ONE
                                  atomic push. this files the request;
                                  it does not wait for integration or
                                  update your local checkout. use status
                                  to read the result. the policy comes
                                  from the target's tip and the owning
                                  valley's, as checks describes below,
                                  so your checkout
                                  can be on any branch. a change the policy
                                  requires no check of is filed too, as a
                                  request with no evidence, and says so.
                                  approving a change already requested is
                                  how it is filed again. at a head rebased
                                  onto a moved main it replaces the request
                                  ref under a lease and names the head it
                                  replaced; at the same head it leaves the
                                  ref alone and publishes only the new
                                  evidence, which the create-only
                                  attestation namespace refuses when this
                                  signer has already attested that tree
                                  (bd-7b7d58f). every write of the request
                                  ref is leased, filing included, so an
                                  approval that lost a race is refused
                                  rather than clobbering the one that won.
                                  needs the attest helper and
                                  VALLEY_ATTEST_KEY, the ed25519 key this
                                  host signs with, whenever a check is
                                  required; VALLEY_ATTEST_NAME is the name it
                                  signs under, defaulting to this host's.
                     [v]iew full diff
                                  page the change's whole diff, with
                                  notes taken as below, and ask again
                     [r]eject     delete the remote branch (confirmed first)
                     [s]kip       do nothing
                   a change with a record is first set against its
                   approved version: the greatest version below the one
                   shown whose exact head an integration request or a
                   land, stale or reject outcome on origin names, under
                   c-<change id> or a branch name of the change that
                   nothing else maps to (valley-go compare). with none,
                   or an ambiguous one, review pages the whole diff. when
                   each version's diff from its merge base with main
                   changes the same files the same way (valley-delta-v1),
                   review prints `<change> v<n> at <head>: clean restack
                   of approved v<m> at <old head>.`, the two bases, and
                   the commits main landed between them, and pages
                   nothing. otherwise it pages `changed since approved
                   v<m>`, the files whose change differs, git
                   range-diff of the two versions, and the shown
                   version's diff of those files. a changed commit
                   message or author is shown either way. this is
                   information only: it files nothing and skips no check.
                   when [a]pprove's checks fail, the prompt says approving
                   needs a new head and stops offering [a]pprove until the
                   change has one. any other refusal keeps the prompt as
                   it was.
                   [a]pprove files the head shown, for a branch no record
                   is on too: it refuses, naming both heads, when the
                   branch on origin has moved off that head since.
                   [a]pprove is the only way a change reaches main from
                   here, and approve below is the same act without the
                   pager.
                   Nothing in this script writes the protected ref: the
                   integrator does, having judged the request.
                   a stale branch (won't fast-forward from main) is first
                   offered:
                     [b]ase       rebase it onto origin/main, as rebase
                                  does below, then re-review the diff that
                                  would actually land
                   [a]pprove is offered there too: a stale branch is nothing
                   the integrator cannot apply, so it need not be rebased
                   first.
                   a change whose record is not ready says so above its
                   diff, and again in place of the prompt, which then
                   offers only [v]iew full diff and [s]kip:
                     `<change> v<n> is a draft: its owner (<owner>) hasn't
                     marked it ready, so it can't be approved yet.`
                     `<change> is withdrawn: there is nothing to approve.`
                   a draft is often a change an agent is still working on.
                   [a]pprove would be refused, and so would [b]ase, since
                   adding the rebased head as a version would ready the
                   change behind its owner's back. [r]eject records
                   nothing on the change: it would only delete a branch
                   its owner may still be working on. a change unreadied
                   or withdrawn while the review is open is still refused
                   by [a]pprove and [b]ase, which read the record again.
                   a branch no record is on has no state, and is offered
                   the usual prompt.
                   while paging, press v: less opens the diff in $EDITOR.
                   every line you insert there is a note. it is anchored to
                   the file and new-side line it sits on — to the file alone
                   when it sits above the first hunk. range-diff gives no
                   line numbers, so on a changed version a note keeps its
                   file and line only in the shown version's diff at the
                   end of the page. each note is then appended to
                   $XDG_STATE_HOME/valley/notes/<branch>.md (default
                   ~/.local/state) and printed after the verdict. notes
                   survive [b]ase. lines you change or delete instead of
                   inserting are ignored, with a warning.
                   a change whose active version names no branch is
                   refused, since notes and [r]eject act on a branch;
                   approve files its head without one.
                   a stack is reviewed one layer at a time, bottom first.
                   its layers are what pending lists under the change: the
                   changes not landed and the branches no record is on
                   that its head contains (valley-go stack). review first
                   lists them, warns of a lower layer that is a draft or
                   withdrawn, since the integrator lands nothing above it,
                   and says how the review goes: [n] through the layers,
                   and approving the top lands them all. a stack whose
                   bottom does not fast-forward from main is then asked,
                   before any layer is paged, as in `one, at the bottom,
                   does not fast-forward from main:`:
                     [b]ase all <n>
                                  rebase the whole stack onto origin/main,
                                  as rebase does below, then list it again
                                  and page the rebased layers, so the
                                  heads paged are the heads approved
                     [s]top       end the review; nothing done
                   a rebase that is refused or left unfinished says what
                   happened, and then only [s]top is offered.
                   it then shows each layer, headed `change <k> of <n>:
                   <name> on <below>`, as a change alone is shown: set
                   against its own change's approved version, or its log
                   and diff against the layer below it paged, with notes
                   kept under that layer's branch.
                   after each lower layer it asks, naming the layer and
                   its place, as in `two, 2 of 3:`:
                     [n]ext layer go on to the layer above; the usual
                                  answer
                     [a]pprove    approve that layer at the head shown,
                                  as review of it would. this lands it
                                  and every layer under it, which the
                                  prompt names (`one alone`, `one and
                                  two`, `the <k> up to <name>`), and
                                  ends the review
                     [v]iew full diff
                                  page that layer's log and diff against
                                  the layer below it, and ask again
                     [s]top       end the review; nothing done
                   after the top it asks, as in `three, 3 of 3:`:
                     [a]pprove all <n>
                                  approve the top at the head shown,
                                  which lands every layer
                     [v]iew full diff
                                  page the top's log and diff against
                                  the layer below it, and ask again
                     [r]eject <name>
                                  delete the top's branch (confirmed
                                  first)
                     [s]top       end the review; nothing done
                   only the top is offered [r]eject. when a layer's checks
                   fail, its prompt says approving needs a new head and
                   stops offering [a]pprove, as for any change. a layer
                   that is not ready says so as a change alone does, under
                   its heading and in its prompt. neither it nor any layer
                   above it is offered [a]pprove, since approving one would
                   land it: each prompt above it says `it would bring
                   <name>, change <k> of <n>, which is a draft` (or
                   withdrawn) in its place. a top that is not ready is not
                   offered [r]eject either. every layer's notes are printed
                   at the end.
  approve [--head <sha>] <change>
                   do what review's [a]pprove does for the change, without
                   paging it: the same checks, the same refusals, the same
                   leased request write and the same output. exits non-zero
                   when it refuses. a change with a record is approved at
                   exactly one head, and its request is filed as
                   refs/the-valley/integration-requests/main/c-<change id>,
                   at that head:
                     --head SHA   approve exactly this head, which must be
                                  one of the record's version heads,
                                  active or not. a front end passes the
                                  head it showed, so a record that moves
                                  after review cannot change what lands.
                   without --head, approve shows the active version's head
                   and title and asks to confirm them, on a terminal; off
                   one it refuses. a branch no record is on is approved at
                   its tip on origin, which --head must name if it is
                   given (review's [a]pprove files the head it showed, and
                   refuses once the branch on origin has moved off it), under
                   the branch's request name: the branch with
                   each / replaced by -. a branch whose request name would
                   be c-<change id> is refused, since that name is the
                   change's.
                   approve refuses, before any check runs, a head that does
                   not fast-forward from main and would bring a version of
                   another change that has not landed: a layer above the
                   bottom of a stale stack. the refusal names the command
                   that rebases the stack, valley rebase <change>. this is
                   the project's choice, not a rule the integrator needs:
                   approved as it is, the stack would land as one commit
                   recorded against this request alone, so the changes
                   under it would have no landing record of their own, and
                   the checks would run over a head that has to be rebased
                   anyway. a stale head with no change under it, such as
                   the bottom layer of a stack or a change alone, is
                   approved as it is, and the integrator merges it onto
                   main.
  rebase <change>  rebase the change's whole stack onto origin/main, as
                   review's [b]ase does: the layers valley-go stack lists
                   under the change, and the change itself. in a throwaway
                   worktree, bottom first, each layer's own commits go onto
                   the rebased layer below it, and the bottom's onto
                   origin/main, so each layer keeps its own diff. commits
                   under the bottom that a lower change landed through the
                   integrator drop out, since main holds them; that landing
                   is read as changes reads it, with VALLEY_KNOWN_SIGNERS
                   and VALLEY_INTEGRATOR_SIGNER. one atomic
                   push then moves every layer's branch, each leased on the
                   tip read: every branch moves, or none does. last, bottom
                   first, each change gains its rebased head as a new
                   version, as valley.principal names, the way ready
                   --if-active does: only while the change is still ready
                   at the head the rebase began with.
                   it refuses, with nothing changed, a stack holding a
                   change that is not ready, records no branch, or whose
                   branch is missing on origin or is not at its recorded
                   head; a plain branch that is the branch of a change not
                   in the stack; two layers on one branch; a merge among the
                   commits to be rebased, or a version head of a change
                   that is not ready or not in the stack, since a rebase
                   gives each commit a new id; and a stack holding a change
                   while git config valley.principal names no one. a
                   conflict in any layer pushes nothing, records nothing
                   and names the layer.
                   a change alone prints its new head. a
                   stack prints a manifest: one line for each layer, with
                   its old and new head, whether its branch was pushed, and
                   whether a version was added. then, for each change left
                   unfinished, the valley ready command that finishes it,
                   and the exit status is non-zero. rebasing again refuses
                   a change whose branch holds a head no version records,
                   and prints the same command. last, it names each ready
                   change or branch outside the stack that is left on an
                   old head of a layer, such as a second stack on a lower
                   layer, with the rebase that moves it; it does not move
                   it. rebase does not re-review the result. a stack that
                   already fast-forwards from main is left as it is.
  status [--json] [-v] <change>
                   read the request and the integrator's last decision from
                   origin. distinguish waiting, a decision that needs
                   attention, and a change integrated into origin/main.
                   a change with a record is read at its active version's
                   head, under c-<change id>, and the status says the
                   version, its title, the owner, and how far the version
                   has landed, as changes reads it. a refusal for a record
                   that is not ready, or for a merge in the change's
                   commits, is a state of its own.
                   after integration, show how to update the local checkout.
                   fetches objects without moving local branches or files;
                   no checks run and no request is filed.
                     --json       print the status as one JSON object,
                                  valley-status/v1, for front ends to read
                                  (docs/architecture.md), with the knots
                                  in the plan graph that link the change.
                                  an error prints no object: it goes to
                                  stderr and the exit status is non-zero.
                     -v           with --json, warn on stderr when the plan
                                  graph is missing or unreadable
                   needs the valley-go helper.
  ready [--head <sha>] [--change <id>] [--if-active <sha>] [--stamp] [<branch>]
                   mark a head of the branch ready, as a new version of its
                   change, in the change's record on origin:
                   refs/the-valley/changes/main/<change id>. the branch
                   defaults to the current one. the head is --head, or else
                   origin/<branch>, and it must be on origin already. the
                   first ready of a change makes v1; each later one adds
                   the next version, at a head other than the active
                   version's. a draft or a withdrawn change comes back this
                   way: at the active version's head, it is ready again at
                   that version, and at another head it gains the next
                   version. prints the handle and version, e.g.
                   `cosmo nxvp v2 ready`.
                   the change id is --change, else the head commit's jj
                   change-id header, else a Change-Id: trailer in its
                   message, else a new one, which is printed. a header and
                   a trailer that disagree are refused. so is a change
                   whose commits from its merge base with origin/main hold
                   a merge, or that has more than one merge base.
                     --if-active SHA
                                  add the version only while the change
                                  is ready at an active version whose head
                                  is SHA. the record ref is leased on the
                                  record read, so nothing comes between
                                  that check and the write. rebase readies
                                  the head it rebased this way.
                     --stamp      amend the head of your local branch to
                                  carry the id as a Change-Id: trailer and
                                  push the branch, leased, before marking it
                                  ready. it only starts a new change: it
                                  is refused for a change that has a
                                  record on origin already, and for a head
                                  already on origin.
                   the record names the principal your key pushes as, read
                   from git config valley.principal; the host refuses one
                   naming anyone else. the record ref is pushed leased on
                   the value read. a new change is owned by the principal
                   that readies it, and a later version may come from its
                   owner, the operator, or a restack holder while the
                   change is ready.
                   a record never makes anything land, and approve is
                   still the only way to main. the integrator reads
                   records only to refuse: it lands no request that would
                   bring a version of a change that is not ready.
                   needs the valley-go helper.
  unready <change>
                   make a ready change a draft in its record on origin, as
                   its owner or the operator. a draft is a pause: it voids
                   nothing, and approvals of its active version stand when
                   it is readied again. ready brings it back. prints e.g.
                   `cosmo nxvp v2 draft`. needs the valley-go helper.
  withdraw <change>
                   mark a ready change or a draft withdrawn in its record
                   on origin, as its owner or the operator. withdrawing
                   voids everything outstanding on the change: its
                   integration requests, and the approvals and reviews of
                   every version, so a change brought back needs fresh
                   approvals. ready brings it back, at the same version
                   or a new one. prints e.g. `cosmo nxvp v2 withdrawn`.
                   needs the valley-go helper.
                   the integrator lands no request that would bring a
                   version of a change that is not ready, so unready and
                   withdraw both stop a
                   pending integration request, under c-<change id> or a
                   branch's request name. each says so when origin holds
                   one. a draft's request stands and lands once the change
                   is ready again. withdrawing voids the request: the
                   integrator deletes it on its next pass while the change
                   is still withdrawn. withdraw warns, since a ready before
                   then leaves the request standing: only a holder of the
                   request grant may touch a request ref, so the operator
                   must drop it then.
  knot <verb> [args]
                   read and write the project's plan graph: knots, at
                   refs/the-valley/knots on origin. a knot is an outcome,
                   a bug, an idea or a question; `knot schema` prints the
                   types, their statuses, active and terminal, the fields
                   and the edges. a write is one commit on the ref, made
                   without a checkout and pushed with a lease on the tip
                   it was made on; no review is involved. a write that
                   loses the lease is made again on the new tip, up to 5
                   tries. every verb takes --project NAME, another
                   project on the same host, and --json. exit status 3
                   is a conflict. needs the valley-go helper, and
                   git config valley.principal for every write.
                     new <type> <title> [--parent ID] [--blocked-by ID]...
                         [--owner P] [--target PROJECT] [--body -]
                                  make a knot. its id is the type's prefix
                                  and 7 hex digits of the sha-256 of the
                                  title's slug.
                     show <id> [--json]
                                  its fields, body and comments, and the
                                  edges both ways
                     list [--type T] [--status S] [--owner P] [--ready]
                                  every knot. --status takes a status,
                                  active or terminal. --ready lists the
                                  active, unclaimed knots whose blockers
                                  are all terminal.
                     set <id> <field>=<value>... [--if <field>=<value>]...
                         [--force]
                                  change status, title, source, owner,
                                  target or graduated_into. a field that
                                  another write changed meanwhile is a
                                  conflict unless --force. --if requires
                                  a field to hold a value first.
                     link <id> (--blocked-by ID | --parent ID | --change X)...
                     unlink <id> (--blocked-by ID | --parent ID | --change X)...
                                  add or drop an edge. a change is
                                  valley:<project>/<change id> or a github
                                  pull request url. outcomes and bugs link
                                  the changes that do the work, and a
                                  question links the change that records
                                  its answer in the source.
                     edit <id> --body -
                                  replace the body with stdin
                     comment <id> (-m TEXT | --body -)
                                  add a comment. comments are never
                                  changed or deleted.
                     claim <id> --run RUN
                                  claim an active outcome or bug for a
                                  run; an open outcome becomes
                                  in-progress. a knot claimed already is
                                  a conflict.
                     unclaim <id>
                                  release the claim. a claim that
                                  changes before the release lands is
                                  a conflict.
                     schema [--json]
                                  print the model
  plan [--project NAME | --all] [--owner P] [--json]
                   show the project's plan graph as a tree, to see where
                   things stand. the roots are the outcomes with no
                   parent, the milestones, each with its progress: its
                   descendants that are terminal and not abandoned, out
                   of those not abandoned, as a count and a bar. under
                   each come its children, indented, in the order they
                   were created, then by title. each knot has a glyph for
                   its state (○ ready, ◐ in progress, ⊘ blocked, ◇
                   active, ✓ done, ✗ abandoned), its id and title, and,
                   while active, its claim and the claim's age (marked
                   stale past a day), its owner, and what blocks it. a
                   blocker that ended abandoned, discarded, superseded or
                   dropped clears the knot, and is marked with how it
                   ended. a reference to another project's knot,
                   <project>:<id>, is marked dangling when that
                   project's graph cannot be read or holds no such knot.
                   a root whose descendants are all terminal is one
                   line. three sections follow. waiting on you: the
                   active outcomes and bugs and the open questions the
                   operator owns, then the changes ready for
                   approval, as pending lists them. in flight: the
                   claimed knots, oldest claim first. open residuals:
                   the open bugs, under their parent. the operator is
                   git config valley.principal, or --owner. lines fit
                   the terminal as pending's do; glyphs are coloured on
                   a terminal unless NO_COLOR is set.
                     --project NAME  another project on the same host
                     --all        every project the serving host
                                  publishes, each under its name, as
                                  pending --all reads them. a project
                                  that cannot be read is reported in
                                  its own section
                     --owner P    read P as the operator
                     --json       print valley-plan/v1: every knot with
                                  what the graph derives of it, and the
                                  three sections (docs/architecture.md)
                   needs the valley-go helper.
  checks [<base> [<head>]]
                   print the check names the composed verification policy
                   (dcr-f41f718) requires of the change between two
                   commits, which class made each one required, and the
                   change's carry mode: how far an approval of it carries
                   across a rebase, the strictest of exact, same-class and
                   same-paths among the classes it matched. It prints: no
                   check is run, nothing is gated, nothing is written.
                   base defaults to the merge base with main, head to HEAD.
                   by default both layers come from the target's tip
                   (origin/main), never from your checkout: the project's
                   own layer is policy/project there, and the owning valley
                   is named one line at policy/valley there, fetched and
                   read at policy/instance in that repository's integrated
                   tip. a valley's own config repository carries
                   policy/instance and uses it. a target carrying no
                   policy/project is derived under the floor alone; a floor
                   that is not there is refused. this is what the
                   integrator reads, so the answer is the same from any
                   branch, however stale. an option overrides each layer,
                   which is the only way to derive against a layer that
                   does not govern — the worked example under
                   examples/policy/, say:
                     --schema FILE    default $VALLEY_VERIFICATION_SCHEMA
                     --instance DIR   default the owning valley's floor
                     --project DIR    default policy/project at the target
                   naming a layer stops this reading the source it
                   replaced. the schema is the shape a policy is written
                   in rather than a layer, so it ships with this tool: the
                   package sets VALLEY_VERIFICATION_SCHEMA to its own copy.
                   with that unset, as when this script runs straight from
                   a the-valley checkout, it is schema/verification.cue in
                   the checkout.
                   after the report, two lines group the required checks
                   by the cost the policy declares, `quick` or `slow`. a
                   slow check takes minutes or needs special hardware. the
                   cost changes nothing required: approving runs every
                   required check whatever its cost, and the integrator
                   requires evidence for every one.
                     --names          print only the required check names,
                                      one per line
                     --cost COST      with --names, only the quick or
                                      the slow ones, e.g.
                                      `valley checks --names --cost slow`
  tail [subject]   watch bus events scroll by (default subject: valley.>);
                   the server comes from the nats CLI's own config
                   (NATS_URL or a nats context; default localhost)
  replay [dir]     publish one ref-updated event per current ref of the
                   repo at dir (default: .) — rebuilds the stream's
                   projection, e.g. after nats stream purge valley
  self-update [-v] [--retry | --rollback | --pin | --unpin]
              [--repo <url>] [--branch <name>]
                   install the tip of a branch of the-valley into your
                   default nix profile, in place of its valley element,
                   once that exact commit builds and passes a smoke test.
                   a commit that fails is skipped until the branch moves,
                   or until --retry. it is off until --repo or
                   git config valley.selfUpdate.repo names the
                   repository; the branch is valley.selfUpdate.branch,
                   or main. --rollback reinstalls the previous build, and
                   --pin and --unpin freeze and release the install.
                   `valley help self-update` gives every step. needs the
                   valley-go helper and nix.
  --version        print this valley's version: the package's version and
                   the commit it was built from, e.g. 0.1.0-97db597, with
                   -dirty after it for a tree with uncommitted changes and
                   -unknown in its place when nix knew no commit. run
                   straight from a checkout, it says it is unstamped.
  help [self-update]
                   show this help, or self-update's

A change is named by its full change id, by its handle — the shortest
prefix of the id, four letters at least, that no other change recorded on
origin shares, written <repo>:<handle> too, with this repository's name —
or by its branch. A name written origin/<branch> is always
a branch. A handle that is also a branch on origin is refused unless the
change is on that branch. review, approve and rebase read a branch name,
written either way, against every record on origin: when exactly one
record's active version is on the branch, the name is that change, as if
its id were given, and when more than one's is, the verb refuses and lists
their ids. A change whose active version has landed — its head is on
main's first-parent history with no merge above it, or the integrator's
outcome record and verified transfer statement record that exact head
landing — is skipped, so a branch can be used again once its change has
landed. unready, withdraw and status read a branch the same way. A
branch no record's active version is on is acted on as a branch. A
change with a record is reviewed, approved and rebased at the
head its active version records, never at its branch's tip: review shows
that head and its [a]pprove approves it, and rebase and review's
[r]eject refuse, naming both, when the branch's tip on origin is another
commit. approve approves the head bound to it, wherever the branch is.
[r]eject deletes the branch under a lease on the recorded head. approve,
rebase, and review's [a]pprove and [b]ase refuse a change whose record is
not ready, naming its state, and review offers none of them for a change
that is not ready when it shows it. Each reads the record again just before it
acts, and again before approve files or rebase pushes, and refuses when
the change is not ready. rebase also refuses when the change's
record has changed at all since it began, and approve when the head it
approves is not a version's. A name that read as a plain branch is
read again before approve files or rebase pushes. If it names a change by
then, rebase refuses, and approve files only while the change is ready at
the head it began with. An approval already past that last check can
still file if the change is unreadied or withdrawn in the moment before
its push; the integrator refuses to land it, since it lands no request
that would bring a version of a change that is not ready, whatever the
request is named.
The integrator reads the records last just before it moves main, so a
change paused in that moment can still land at the head the operator
approved, and never at any other.

Runs from any checkout of the project; needs only git and coreutils,
except tail and replay, which also need the nats CLI (natscli), checks,
which also needs the cue CLI, review's notes, which need less, approve
and review's [a]pprove, which need both the cue CLI and the attest
helper, and status, ready, unready, withdraw, review, approve and rebase,
which need the valley-go helper, as pending, changes, knot, plan and
self-update do. nix run .#valley bundles all of them. self-update also
needs nix. Deriving a policy fetches the owning valley's repository, so
checks and approving also need whatever reaching it takes.
No config but valley.principal, which ready, rebase, knot and plan read,
and valley.selfUpdate.repo and .branch, which self-update reads; no batch
mode; and no state but the notes file, the handle cache pending and
changes write for completion, and self-update's record of what it
installed — the judgment stays with the human.
EOF
}

fetch_origin() {
  git fetch --prune --quiet origin
}

# Resolve the pager as git would for a diff: pager.diff first (per-command
# pager configs — e.g. home-manager's delta module — set pager.diff and leave
# core.pager alone), then git var GIT_PAGER (core.pager, GIT_PAGER, PAGER,
# less). pager.<cmd> may legally be a boolean; treat true/false — and an
# empty or missing value — as unset and fall back. The value is
# shell-interpreted, hence sh -c.
diff_pager() {
  local pager
  pager="$(git config --get pager.diff || true)"
  case "$pager" in '' | true | false) pager="$(git var GIT_PAGER)" ;; esac
  printf '%s' "$pager"
}

# Page a file rather than a pipe, so less's v key has something to hand
# $EDITOR: with a real file open, v runs LESSEDIT, whose default
# `%E ?lm+%lm. %g` is the editor, +<line>, and the file name. That file is
# the review buffer, and editing it is how notes get written (see
# collect_notes). A pipe has no name, so less refuses to edit one — which is
# why review no longer pipes.
#
# The configured diff pager stays the renderer, but as less's input
# preprocessor rather than as the pager. It still reads the buffer on stdin
# exactly as it did when it was the pager, less displays what it emits, and
# less still calls the raw buffer "the current file" — so v edits the diff
# and not the rendering. The alternative was to page the buffer with no
# filter at all: exact, and it throws delta's rendering away, which is the
# worse trade for a verb whose whole job is reading a diff.
#
# What this costs is the line number. A filter that restructures the diff —
# delta's default rendering does — makes %lm a line of the rendered view, so
# the editor opens near the cursor rather than on it. A structure-preserving
# filter (pager.diff = `delta --color-only`) makes it exact. No anchor
# depends on it: a note is anchored by where it was inserted, not by where
# the editor opened.
page_file() {
  local file="$1" pager
  [ -t 1 ] || { cat -- "$file"; return; } # a non-tty just cats
  pager="$(diff_pager)"
  case "${pager%%[[:space:]]*}" in
    less | */less)
      # Already less: give it the file and there is no filter to run.
      sh -c "$pager \"\$1\"" sh "$file"
      return
      ;;
  esac
  # Without less there is no editor key; fall back to filtering into a pipe.
  command -v less > /dev/null 2>&1 || {
    sh -c "$pager" < "$file"
    return
  }
  # -R because the filter's color is the whole point of running it, and no
  # LESSCLOSE because a stray one would run against a buffer we still read.
  LESSOPEN="|$pager < %s" env -u LESSCLOSE less -R -- "$file"
}

# pending is valley-go's (status/pending.go). The fetch first keeps this
# checkout's remote-tracking branches current, as pending always has. The
# helper runs valley checks for --checks, so it is told how this script was
# run.
cmd_pending() {
  command -v valley-go > /dev/null 2>&1 \
    || die "pending needs the valley-go helper; nix run .#valley bundles it"
  fetch_origin
  VALLEY_COMMAND="$0" exec valley-go pending "$@"
}

# For a change with a record, what is rejected is the head its record
# names. So the branch is deleted only while its tip is that head, and the
# delete is leased on it. When the tip is another commit, reject refuses
# and names both, and deletes nothing. A branch no record names is deleted
# as before.
#
# reject runs inside a condition, where bash suspends `set -e`, so the push
# is checked by hand.
reject() {
  local branch="$1" answer
  local -a lease=()
  if [ -n "$CHANGE_HEAD" ]; then
    check_recorded_tip "$branch" "nothing deleted" || return 1
    lease=("--force-with-lease=refs/heads/$branch:$CHANGE_HEAD")
  fi
  printf 'really delete origin/%s? [y/N] ' "$branch"
  read -r answer || answer=""
  case "$answer" in
    y | Y | yes)
      if ! git push --quiet "${lease[@]}" origin --delete "$branch"; then
        refuse "origin did not delete $branch, which may have moved since the fetch; nothing deleted"
        return 1
      fi
      echo "rejected $branch: deleted from origin"
      ;;
    *) echo "kept $branch" ;;
  esac
}

# ----------------------------------------------------------------------
# review notes — the lines the reviewer inserts into the paged diff.
#
# The buffer the reviewer pages is a file, so the pager's editor key can open
# it (page_file). Whatever comes back with lines inserted is read as notes:
# no marker, no syntax, no mode — an inserted line is a note because it was
# not there before. What a note is *about* is where it sits, so each one is
# anchored to the file and the new-side line number of the diff line above
# it, which is the pair a reviewer would otherwise have to copy out by hand.

# The scratch directory holding the buffer and its pristine copy, and the
# notes taken so far in this review — a global because [b]ase pages a second
# time and the notes from the first pass are not thereby withdrawn.
REVIEW_TMP=""
NOTES=()

cleanup_review_tmp() {
  [ -n "$REVIEW_TMP" ] || return 0
  rm -rf "$REVIEW_TMP"
  REVIEW_TMP=""
}

# Where a branch's notes live. XDG_STATE_HOME is the right home for them:
# they are neither config nor cache, and losing them loses judgment.
notes_file() {
  printf '%s/valley/notes/%s.md\n' "${XDG_STATE_HOME:-$HOME/.local/state}" "$1"
}

# The anchor of every line of the buffer, by line: the file that line belongs
# to, and the new-side line number it sits on. Built in one pass so that
# anchoring a note is a lookup. An empty path means the line is above every
# file (the log); line 0 means the line is a file header, above every hunk.
ANCHOR_PATH=()
ANCHOR_LINE=()

anchor_buffer() {
  local file="$1" line path="" at=0 next=0 inhunk=0 rest
  ANCHOR_PATH=()
  ANCHOR_LINE=()
  while IFS= read -r line; do
    # Header lines are only headers outside a hunk: inside one, every line
    # carries a +/-/space prefix, so a diff of a diff cannot be misread.
    if [ "$inhunk" -eq 1 ]; then
      case "$line" in
        ' '* | '+'* | '')
          at="$next" # this line's own new-side number
          next=$((next + 1))
          ;;
        '-'* | \\*) ;; # a removal or the no-newline marker: no new-side line
        *) inhunk=0 ;;
      esac
    fi
    if [ "$inhunk" -eq 0 ]; then
      case "$line" in
        'diff --git '*)
          path=""
          # The b/ side, so a rename anchors to the name it will have.
          if [[ "$line" =~ ^diff\ --git\ a/(.*)\ b/(.*)$ ]]; then
            path="${BASH_REMATCH[2]}"
          fi
          at=0
          ;;
        '@@ '*)
          rest="${line#*+}" # -12,7 +34,9 @@ -> 34,9 @@
          at="${rest%%[!0-9]*}"
          [ -n "$at" ] || at=0
          next="$at"
          inhunk=1
          ;;
      esac
    fi
    ANCHOR_PATH+=("$path")
    ANCHOR_LINE+=("$at")
  done < "$file"
}

# The anchor for a note inserted after buffer line n, as it is written down.
anchor_of() {
  local n="$1" path line
  [ "$n" -ge 1 ] || { printf '(unanchored)'; return; }
  path="${ANCHOR_PATH[n - 1]:-}"
  line="${ANCHOR_LINE[n - 1]:-0}"
  if [ -z "$path" ]; then
    printf '(unanchored)'
  elif [ "$line" -eq 0 ]; then
    printf '%s' "$path"
  else
    printf '%s:%s' "$path" "$line"
  fi
}

# The notes in an edited buffer, one `anchor: text` line each. git says where
# the reviewer's lines landed; a hunk that removes nothing is an insertion,
# and the line it was inserted after is the anchor. A hunk that removes
# something is an edit of the diff itself — it anchors to nothing, since the
# line it would name is the line it changed — so it is dropped with a count.
notes_in() {
  local orig="$1" edited="$2" line rest at old insert=0 touched=0 text
  anchor_buffer "$orig"
  while IFS= read -r line; do
    case "$line" in
      '@@ '*)
        rest="${line#@@ -}" # 12,0 +13,2 @@ -> 12,0 +13,2 @@
        at="${rest%%[!0-9]*}"
        rest="${rest#"$at"}"
        old=1
        case "$rest" in
          ,*)
            rest="${rest#,}"
            old="${rest%%[!0-9]*}"
            ;;
        esac
        if [ "$old" -eq 0 ]; then
          insert=1
        else
          insert=0
          touched=$((touched + old))
        fi
        ;;
      '+'*)
        # Only inside an insertion hunk: the +++ of git's own header is not
        # a note, and neither is the new side of an edit.
        [ "$insert" -eq 1 ] || continue
        text="${line#+}"
        text="${text#"${text%%[![:space:]]*}"}"
        [ -n "$text" ] || continue # a blank line says nothing
        printf '%s: %s\n' "$(anchor_of "$at")" "$text"
        ;;
    esac
  done < <(git --no-pager diff --no-ext-diff --no-index -U0 -- "$orig" "$edited")
  [ "$touched" -eq 0 ] || printf \
    'valley: warning: %d changed or deleted diff line(s) ignored — a note is a line you insert\n' \
    "$touched" >&2
}

# Read the notes out of the paged buffer and keep them: appended to the
# branch's notes file under the commit they were taken against, and held for
# the print that follows the verdict. A notes file that cannot be written is
# a warning, never a failure — the notes are still printed, and a review is
# not undone by a missing directory.
collect_notes() {
  local branch="$1" sha="$2" file dir
  local -a found=()
  mapfile -t found < <(notes_in "$REVIEW_TMP/review.orig" "$REVIEW_TMP/review.diff")
  [ "${#found[@]}" -gt 0 ] || return 0
  NOTES+=("${found[@]}")
  file="$(notes_file "$branch")"
  dir="${file%/*}"
  mkdir -p "$dir" 2> /dev/null && {
    printf '## %s at %s\n\n' "$branch" "$sha"
    printf '%s\n' "${found[@]}"
    printf '\n'
  } >> "$file" 2> /dev/null && return 0
  printf 'valley: warning: could not write %s — the notes are printed only\n' \
    "$file" >&2
}

print_notes() {
  local branch="$1"
  [ "${#NOTES[@]}" -gt 0 ] || return 0
  printf '\n%d note(s) on %s, appended to %s:\n' \
    "${#NOTES[@]}" "$branch" "$(notes_file "$branch")"
  printf '  %s\n' "${NOTES[@]}"
}

# ----------------------------------------------------------------------
# review sets the version it shows of a change against the change's
# approved version: the greatest version below it whose head a request or
# an outcome on origin names (valley-go compare, status/compare.go). The
# logic is valley-go's, and this script prints what it says:
#
#   - none: there is no approved version to compare with, so review pages
#     the whole diff, as for any change. Any note valley-go gives, such as
#     an approved version it could not compare, heads the page.
#   - clean: the file delta is the approved version's. review prints that
#     in a few lines, with the landings between the two bases, and pages
#     nothing.
#   - changed: review pages the files whose change differs, the
#     range-diff between the two versions, and the shown version's diff
#     of those files. range-diff's hunks carry no line numbers, so a note
#     taken beside them is unanchored. That last diff is in git's ordinary
#     form, so a note taken there keeps its file and line (anchor_buffer).
#
# A changed commit message or author is in valley-go's text either way.
# [v]iew full diff pages the whole diff at every prompt. The comparison
# files no request and skips no check: [a]pprove is the same act whatever
# it says.
#
# compare_shown <change ID> <version> <head>: compare the version shown,
# against main's tip as the fetch left it. Leaves none, clean or changed
# in COMPARE_KIND, and the text to show in $REVIEW_TMP/compare. A plain
# branch is none, and so is a comparison valley-go could not make, with a
# warning.
COMPARE_KIND=none
compare_shown() {
  local out="$REVIEW_TMP/compare.out" tip
  COMPARE_KIND=none
  : > "$REVIEW_TMP/compare"
  [ -n "$1" ] || return 0
  if ! tip="$(git rev-parse --verify --quiet refs/remotes/origin/main)" \
    || ! valley-go compare --tip "$tip" "$1" "$2" "$3" > "$out"; then
    printf 'valley: warning: could not compare v%s of change %s with its approved version; reviewing it in full\n' \
      "$2" "$1" >&2
    return 0
  fi
  IFS= read -r COMPARE_KIND < "$out" || COMPARE_KIND=""
  case "$COMPARE_KIND" in
    none | clean | changed) tail -n +2 "$out" > "$REVIEW_TMP/compare" ;;
    *)
      printf 'valley: warning: valley-go compare answered %s, which this script does not read; reviewing it in full\n' \
        "$COMPARE_KIND" >&2
      COMPARE_KIND=none
      ;;
  esac
}

# show_compared <notes key> <head> <heading> <knots> <writer> [<arg>…]:
# show what compare_shown found, under the heading when there is one. A
# clean restack is printed, and nothing is paged. A changed version pages
# the comparison. Otherwise the writer writes the whole diff, and it is
# paged. Notes taken in a page are kept under the notes key, against the
# head.
#
# Knots follow the heading when there is one. Otherwise they follow the
# first line of the comparison or full diff, which names the change.
show_compared() {
  local key="$1" sha heading="$3" knots="$4"
  sha="$(git rev-parse --short "$2")"
  shift 4
  {
    if [ -n "$heading" ]; then
      printf '%s\n' "$heading"
      [ -z "$knots" ] || printf '%s\n' "$knots"
      cat "$REVIEW_TMP/compare"
      [ "$COMPARE_KIND" != none ] || "$@"
    else
      {
        cat "$REVIEW_TMP/compare"
        [ "$COMPARE_KIND" != none ] || "$@"
      } | under_first "$knots"
    fi
  } > "$REVIEW_TMP/review.diff"
  if [ "$COMPARE_KIND" = clean ]; then
    cat "$REVIEW_TMP/review.diff"
    cleanup_review_tmp
  else
    page_buffer "$key" "$sha"
  fi
}

# under_first <lines>: copy stdin, inserting <lines> after the first line.
under_first() {
  local first
  IFS= read -r first || [ -n "$first" ] || return 0
  printf '%s\n' "$first"
  [ -z "$1" ] || printf '%s\n' "$1"
  cat
}

# DOES caches the output of `valley-go does` for the review (status/does.go):
# one `<change ID>\tdoes <knot ID> (<status>): <title>` line per knot.
DOES=""

# read_does [-v]: read the plan graph once for every change in the review.
# A missing or unreadable graph leaves DOES empty; -v warns on stderr.
read_does() {
  local ids=() k
  DOES=""
  if [ "${#L_NAME[@]}" -gt 1 ]; then
    for ((k = 0; k < ${#L_ID[@]}; k++)); do
      [ -z "${L_ID[k]}" ] || ids+=("${L_ID[k]}")
    done
  elif [ -n "$CHANGE_ID" ]; then
    ids=("$CHANGE_ID")
  fi
  [ "${#ids[@]}" -gt 0 ] || return 0
  DOES="$(valley-go does "$@" "${ids[@]}")" || DOES=""
}

# does_of <change ID>: print the `does ...` lines for one change from DOES.
does_of() {
  local line
  [ -n "$1" ] || return 0
  while IFS= read -r line; do
    [ "${line%%$'\t'*}" != "$1" ] || printf '%s\n' "${line#*$'\t'}"
  done <<< "$DOES"
}

# full_diff <branch> <head>: the whole diff of a change alone: its log
# and its diff against origin/main.
full_diff() {
  local sha
  sha="$(git rev-parse --short "$2")"
  if [ -n "$CHANGE_HEAD" ]; then
    printf 'change %s v%s at %s, on branch %s, log against origin/main:\n\n' \
      "$CHANGE_HANDLE" "$CHANGE_VERSION" "$sha" "$1"
  else
    printf 'branch %s, log against origin/main:\n\n' "$1"
  fi
  git --no-pager log --oneline "origin/main..$2"
  printf '\n'
  git --no-pager diff "origin/main...$2"
}

# show_review <branch>: show a change alone. A change that is not ready
# says so first, before anything else shown of it (shown_not_ready). That
# notice becomes the heading, so the change's knots follow it.
show_review() {
  local branch="$1" head held
  head="$(change_head "$branch")"
  # [a]pprove approves exactly the head shown here (bind_review).
  [ -n "$CHANGE_ID" ] || APPROVE_HEAD="$head"
  held="$(shown_not_ready)" || held=""
  REVIEW_TMP="$(mktemp -d)"
  compare_shown "$CHANGE_ID" "$CHANGE_VERSION" "$head"
  show_compared "$branch" "$head" "$held" "$(does_of "$CHANGE_ID")" full_diff "$branch" "$head"
}

# view_full <branch>: [v]iew full diff for a change alone. It pages the
# change's whole diff, and keeps the notes taken in it.
view_full() {
  local head
  head="$(change_head "$1")"
  REVIEW_TMP="$(mktemp -d)"
  full_diff "$1" "$head" > "$REVIEW_TMP/review.diff"
  page_buffer "$1" "$(git rev-parse --short "$head")"
}

# page_buffer <branch> <sha>: page the buffer written to REVIEW_TMP, and
# keep the notes taken in it under the branch, against the commit shown.
page_buffer() {
  cp "$REVIEW_TMP/review.diff" "$REVIEW_TMP/review.orig"
  page_file "$REVIEW_TMP/review.diff" || true # quitting the pager early is not an error
  collect_notes "$1" "$2"
  cleanup_review_tmp
}

# Everything review and approve leave outside the repository: approve's
# throwaway worktree, the paged buffer, the two policy layers read out of
# their tips, and the scratch the policy deriver writes into. One handler,
# installed once by each of those verbs, so that no path through them —
# and no ctrl-C in the pager — leaves any of them behind. The rebase's
# worktree is valley-go's, which removes it itself.
cleanup_scratch() {
  cleanup_approve_wt
  cleanup_policy_tmp
  cleanup_instance_tmp
  cleanup_project_tmp
  cleanup_review_tmp
}

# [b]ase and the rebase verb are one piece of code, valley-go rebase
# (status/rebase.go). It rebases the change's whole stack in a throwaway
# worktree of its own — the user's checkout is never touched — pushes
# every layer's branch in one atomic push, leased on the tips it read, and
# adds each change's rebased head to its record as a new version. A
# change alone prints what rebase always has; a stack prints a manifest
# of what became of each layer. The judgment on the rebased diff stays
# with the human, back at the review prompt or in whatever front end ran
# the rebase verb.
#
# rebase_shown <head>: [b]ase for the change under review, while it is
# still at <head>, the head review showed of it.
rebase_shown() {
  valley-go rebase --head "$1" "${CHANGE_ID:-$CHANGE_NAME}"
}

# ----------------------------------------------------------------------
# approve — file an integration request for the branch under review.
#
# This is the one way a change reaches main from here: the checks the
# policy requires are run over the branch's tree and signed, the evidence
# and one request ref are published, and the integrator judges the request
# and lands it (archive/design/integration.md). main is never touched from here.
#
# Nothing in this script writes the protected ref. Whether a given pusher
# may write it is a fact about origin's pre-receive hook, so origin is
# where it is answered, and a verb that merged onto main locally would only
# be asking the same question in a worse place.
#
# What this verb removes is a second push. `attest run --push` publishes
# the branch and the attestation refs in one atomic push and knows nothing
# about a request ref, so filing a request by hand is two beats: the
# evidence, then the request after it. In between, evidence stands
# published for a change nobody has approved. So this verb does not
# use --push at all. `attest run` without it stores each note at its ref in
# the repository and stops, and one `git push --atomic` then carries the
# evidence and the request together — all of it or none of it. Nothing in
# attest had to change for that; the sequencing was the whole of it.
#
# The branch itself is not in that push. What is under review is
# origin/<branch>, so the commit the request names is already on origin and
# the objects with it.

# The tree the checks run over: a throwaway worktree of the branch, as
# [b]ase uses, so that what is checked is the branch's tree and not the
# operator's working copy. A global, so the traps clean it up whatever
# happens.
APPROVE_WT=""
# The head approve last ran the checks over and saw them fail, for the
# review prompt: see approve_failed_at.
CHECKS_FAILED_AT=""
cleanup_approve_wt() {
  [ -n "$APPROVE_WT" ] || return 0
  git worktree remove --force "$APPROVE_WT" > /dev/null 2>&1 || true
  rm -rf "$APPROVE_WT"
  APPROVE_WT=""
}

# Report and fail, without leaving the review. A refusal here is not a
# reason to end the session: the branch is still under review and the
# operator can still answer. die() is for the verbs that have nothing left
# to offer. The approve verb has nothing left to offer either, and turns a
# refusal into its exit status itself.
refuse() {
  printf 'valley: %s\n' "$*" >&2
  return 1
}

# The change segment of a request ref. The integrator reads a request as
# <prefix>/<target>/<change> and refuses a change segment holding a slash
# (integrator/refs.go), so a branch name with one is written with dashes
# instead. The ref that results is printed, never left to be assumed.
#
# The mapping is lossy: `topic/x` and `topic-x` are one change name and so
# one request ref, and this verb cannot tell a sibling's request from its
# own. That is bd-57f7f9f, and what is done about it here is to print the
# subject of any request being replaced, so a collision is visible at the
# moment it happens rather than after it.
change_name() {
  printf '%s' "${1//\//-}"
}

# One line of a commit, for saying which commit is meant. A request being
# replaced is usually this operator's own pre-rebase head and so is in
# this repository; one another operator filed may not be, and saying so is
# better than printing an id alone.
subject_of() {
  local s
  if s="$(git log -1 --format=%s "$1" 2>/dev/null)" && [ -n "$s" ]; then
    printf '%s' "$s"
  else
    printf 'subject not in this repository'
  fi
}

# The value of a ref on origin, as one id or the empty string. Failing to
# read it is not the same as reading that it is absent, so the two are
# separate answers: this returns 1 for a read that did not happen.
remote_ref() {
  local out
  out="$(git ls-remote origin "$1" 2>/dev/null)" || return 1
  printf '%s' "$out" | cut -f1
  return 0
}

# Where the checks this run signed are stored, for every failure that
# happens after they have run. One stanza, so no failure path invents its
# own wording. Called with no refs it says nothing.
report_local_evidence() {
  [ "$#" -gt 0 ] || return 0
  printf 'valley: the evidence is stored locally at:\n' >&2
  printf '  %s\n' "$@" >&2
}

# Whether origin already holds one of these attestation refs at a value
# other than the one being pushed. The namespace admits creations only, so
# that is the one refusal approving again will never clear: it is what a
# re-observation of a tree this signer has already attested runs into
# (bd-7b7d58f).
attestation_stands_elsewhere() {
  local digest="$1" remote spec have want
  shift
  remote="$(git ls-remote origin "refs/the-valley/attestations/$digest/*" 2>/dev/null)" || return 1
  for spec in "$@"; do
    have="$(printf '%s\n' "$remote" | awk -v r="$spec" '$2 == r { print $1 }')"
    [ -n "$have" ] || continue
    want="$(git rev-parse "$spec" 2>/dev/null)" || continue
    [ "$have" = "$want" ] || return 0
  done
  return 1
}

# Why a push carrying the request ref failed, said as precisely as the
# state allows. Every such push is leased, and a lease refuses when the
# ref it named is not where the read before it saw it — which covers three
# different events. Reading the ref again is what tells them apart, and a
# read that does not happen is its own answer rather than a guess.
#
# Anything the lease is not responsible for is origin's own refusal, and
# git has already printed it.
diagnose_request_push() {
  local ref="$1" pending="$2" now
  if ! now="$(remote_ref "$ref")"; then
    refuse "origin refused the push, and $ref could not be read again to say why. Nothing was published there and main is untouched"
    return 0
  fi
  if [ "$now" = "$pending" ]; then
    refuse "origin refused the push; nothing was published there and main is untouched"
  elif [ -z "$now" ]; then
    refuse "the pending request was consumed while this one was being prepared, which is what the integrator does when a change lands. The lease on $ref refused and nothing was published; fetch and review the branch again before approving it a second time"
  elif [ -z "$pending" ]; then
    refuse "a request for this change appeared while this one was being prepared, at $(git rev-parse --short "$now") ($(subject_of "$now")); the lease on $ref refused and nothing was published"
  else
    refuse "the pending request moved from $(git rev-parse --short "$pending") to $(git rev-parse --short "$now") while this one was being prepared; the lease on $ref refused, nothing was published, and the request stands where the other approval put it"
  fi
}

# File the request. Called in a condition, from the review prompt and from
# the approve verb alike, which suspends `set -e` for the whole call — so
# every step below is checked by hand, and the failures say what was
# published before they happened.
approve() {
  local branch="$1" target=main tip change head base digest root ref check spec what
  local key
  local -a signer=() required=() run=() evidence=()

  root="$(git rev-parse --show-toplevel)" || {
    refuse "not a git repository; nothing published"
    return 1
  }
  tip=refs/remotes/origin/main
  # A change with a record is filed at exactly the head bound to this
  # approval, under its own request name, c-<change ID>, and only while its
  # record says it is ready and lists that head as a version's. Where its
  # branch is does not matter: the request names the head.
  if [ -n "$CHANGE_ID" ]; then
    head="$APPROVE_HEAD"
    [ -n "$head" ] || {
      refuse "no head of change $CHANGE_HANDLE is bound to this approval; nothing published"
      return 1
    }
    check_record "nothing published" "" "$head" || return 1
    change="c-$CHANGE_ID"
    what="$CHANGE_HANDLE v$APPROVE_VERSION"
  elif [ -n "$APPROVE_HEAD" ]; then
    # A plain branch that review showed is filed at the head shown. The
    # last check before the push refuses if the branch on origin has moved
    # off it since.
    head="$APPROVE_HEAD"
    change="$(change_name "$branch")"
    what="$branch"
  else
    head="$(git rev-parse "refs/remotes/origin/$branch")" || {
      refuse "no such branch on origin: $branch; nothing published"
      return 1
    }
    change="$(change_name "$branch")"
    what="$branch"
  fi
  # c-<change ID> is the request name of the change with that ID, so a
  # branch is never filed under one.
  if [ -z "$CHANGE_ID" ] && [[ "$change" =~ ^c-[k-z]{32}$ ]]; then
    refuse "the branch $branch would be requested as $change, and that name is reserved for the change with the ID ${change#c-}; rename the branch, or name the change by its ID. Nothing published"
    return 1
  fi
  base="$(git merge-base "$tip" "$head")" || {
    refuse "$what and main share no history; nothing published"
    return 1
  }
  ref="refs/the-valley/integration-requests/$target/$change"
  local named="$branch" under of
  [ -z "$CHANGE_ID" ] || named="$CHANGE_HANDLE"

  # A head that does not fast-forward from main, and would bring a version
  # of another change that has not landed, is a layer above the bottom of
  # a stale stack. The integrator could land it all the same, as one
  # commit recorded against this request alone, and the changes under it
  # would have no landing record of their own. So it is refused before
  # any check runs over a head that has to be rebased anyway, and the
  # stack is rebased first. This is the project's choice, not a rule the
  # integrator needs. A stale head with no change under it, such as the
  # bottom layer of a stack or a change alone, is approved as it is, and
  # the integrator merges it onto main.
  if ! git merge-base --is-ancestor "$tip" "$head"; then
    if ! under="$(valley-go brings ${CHANGE_ID:+--change "$CHANGE_ID"} "$head")"; then
      refuse "could not read which changes $what would bring to main; nothing published"
      return 1
    fi
    if [ -n "$under" ]; then
      of="a version of $under"
      [ "$(printf '%s\n' "$under" | wc -l)" -eq 1 ] || of="versions of $(printf '%s\n' "$under" | join_lines)"
      refuse "$what does not fast-forward from main, and the commits it would bring hold $of, not landed. Approved as it is, it would land them with no landing record of their own; nothing published. Rebase the stack first: valley rebase $(printf '%q' "$named")"
      return 1
    fi
  fi

  # What the policy requires of the change, read out of exactly the
  # sources the integrator reads: both layers from the target's tip, which
  # review has just fetched, and the floor from the owning valley's own
  # tip. A change never supplies the policy that gates it, and neither does
  # the checkout this runs from — so the answer here is the same answer the
  # integrator will derive, from whatever branch the operator happens to be
  # on. It is printed for exactly that reason.
  policy_defaults "$root"
  resolve_instance_layer "$root" "$tip" || return 1
  resolve_project_layer "$root" "$tip" || return 1
  derive_required "$POLICY_SCHEMA" "$POLICY_INSTANCE" "$POLICY_PROJECT" \
    "$base" "$head" || return 1
  sort_into required "${!DERIVED_REQUIRED[@]}" || {
    refuse "could not sort the required checks; nothing published"
    return 1
  }

  # A change the policy asks nothing of is still a change, and approving
  # is how one reaches main. The integrator already lands a request that
  # requires no check and records the landing as one that required nothing
  # (archive/design/integration.md), so refusing to file it here would strand
  # exactly the changes the policy requires nothing of. Nothing is required,
  # so nothing is signed and no key is needed: what gets published is one
  # request ref and no evidence at all.
  if [ "${#required[@]}" -gt 0 ]; then
    key="${VALLEY_ATTEST_KEY:-}"
    [ -n "$key" ] || {
      refuse "no signing key: set VALLEY_ATTEST_KEY to the ed25519 key this host attests with. The host signs; nothing published"
      return 1
    }
    [ -f "$key" ] || {
      refuse "no signing key at $key; nothing published"
      return 1
    }
    command -v attest > /dev/null 2>&1 || {
      refuse "this choice needs the attest helper; nix run .#valley bundles it. Nothing published"
      return 1
    }
    signer=(--key "$key")
    [ -z "${VALLEY_ATTEST_NAME:-}" ] || signer+=(--name "$VALLEY_ATTEST_NAME")

    for check in "${required[@]}"; do
      case "${CHECK_RUNNER[$check]:-}" in
        nix) run+=(--check "$check=${CHECK_ATTRIBUTE[$check]}") ;;
        command) run+=(--command "$check=${CHECK_COMMAND[$check]}") ;;
        *)
          refuse "the policy requires $check but does not say how to run it; nothing published"
          return 1
          ;;
      esac
    done

    cleanup_approve_wt
    APPROVE_WT="$(mktemp -d)" || {
      refuse "no scratch directory to check $what in; nothing published"
      return 1
    }
    git worktree add --quiet --detach "$APPROVE_WT" "$head" || {
      cleanup_approve_wt
      refuse "could not check $what out to run its checks; nothing published"
      return 1
    }

    printf '\nchecking %s at %s: %s\n' "$what" "$(git rev-parse --short "$head")" \
      "$(printf '%s\n' "${required[@]}" | join_lines)"
    if ! attest run --repo "$APPROVE_WT" "${signer[@]}" "${run[@]}"; then
      cleanup_approve_wt
      CHECKS_FAILED_AT="$head"
      refuse "the checks did not pass; nothing published, main untouched"
      return 1
    fi
    digest="$(attest digest --repo "$APPROVE_WT")" || {
      cleanup_approve_wt
      refuse "could not digest the tree that was checked; nothing published"
      return 1
    }
    cleanup_approve_wt
    digest="${digest#*:}"

    # Every attestation stored for this tree, whoever signed it: the
    # evidence for this change is what the subject digest is keyed by, not
    # what this run happened to add to it.
    mapfile -t evidence < <(git for-each-ref --format='%(refname)' \
      "refs/the-valley/attestations/$digest")
    [ "${#evidence[@]}" -gt 0 ] || {
      refuse "no attestation is stored for $digest; nothing published"
      return 1
    }
  else
    printf '\n%s requires no check under %s + %s; filing the request with no evidence\n' \
      "$what" "$POLICY_INSTANCE_LABEL" "$POLICY_PROJECT_LABEL"
  fi

  # What origin already holds for this request, read once and remembered.
  # Approving the same change twice is ordinary: evidence expires, and a
  # change whose input closure moved under it is told to re-attest. So the
  # request ref may already exist, and what to do about it depends on
  # where it points. A read that does not happen is not a read that found
  # nothing, so it ends the verb here.
  local pending
  if ! pending="$(remote_ref "$ref")"; then
    refuse "could not read $ref from origin; nothing published"
    report_local_evidence ${evidence[@]+"${evidence[@]}"}
    return 1
  fi

  # The one push: every evidence ref as it stands, and the request ref
  # wherever it has to go. --atomic, so a hook that refuses any of them
  # leaves origin exactly as it was.
  #
  # Every write of the request ref is leased against exactly what the read
  # above saw, including when it saw nothing: git spells that expectation
  # `--force-with-lease=<ref>:` with an empty value, and it refuses if the
  # ref exists at all. So filing a change for the first time is a
  # compare-and-swap too. Without it, two operators filing one change at
  # once would have the second silently fast-forward the first away.
  #
  # A pending request at this same head is a re-attestation of the tree
  # already approved. The evidence is new and the ref does not move, so
  # the ref is left out of the refspec entirely — a push cannot carry a
  # compare-and-swap on a ref it is not changing, because git leaves an
  # up-to-date ref out of what it sends. Nothing this run does establishes
  # where that ref stands afterwards, so it is read again below.
  #
  # A pending request at a different head is a replacement. This is the
  # shape a change takes when main moved through its checks' input
  # closures: no attestation over the old tree can transfer again, so the
  # cure is a new head rebased onto the moved main — and that head is not
  # a descendant of the old one, which makes replacing the ref a
  # non-fast-forward update that git refuses unless told.
  #
  # The lease is the whole of the force, and the refspec carries no `+`.
  # A leading `+` sets git's per-ref force flag, and that flag defeats
  # every rejection the push rules produce — the lease's stale-info among
  # them. The two together are a plain force wearing a lease's name.
  local -a push=() lease=()
  for spec in ${evidence[@]+"${evidence[@]}"}; do push+=("$spec:$spec"); done
  if [ "$pending" != "$head" ]; then
    lease+=("--force-with-lease=$ref:$pending")
    push+=("$head:$ref")
  fi

  # The checks can take minutes, and the record may have moved meanwhile.
  # So it is read once more, just before anything is filed, and a name that
  # read as a plain branch is read again in case it names a change now.
  #
  # This is the last check, and a window remains between it and the push
  # below. A change unreadied or withdrawn in that window is filed all the
  # same. git compares only the refs a push changes, and the record ref is
  # not one of them, so no client can make the filing conditional on the
  # record. The integrator narrows the window: it lands no request that
  # would bring a version of a change that is not ready, whatever the
  # request is named, so a request filed in the window stays until the
  # change is ready again. It reads the records last just before it moves
  # the target, so only a record written in that moment is missed.
  if ! check_record "nothing published" "$head" "$APPROVE_HEAD"; then
    report_local_evidence ${evidence[@]+"${evidence[@]}"}
    return 1
  fi
  # A plain branch is filed at the head review showed only while the
  # branch on origin is still there. The operator reviewed a branch, and a
  # branch that moved holds commits nobody has read. A change with a
  # record is filed at its head wherever its branch is.
  if [ -z "$CHANGE_ID" ] && [ -n "$APPROVE_HEAD" ] && ! branch_at_shown "$branch"; then
    report_local_evidence ${evidence[@]+"${evidence[@]}"}
    return 1
  fi

  # Nothing required and the request already standing at this head leaves
  # nothing to push at all, and a push assembled with an empty refspec
  # would fall back to origin's default one. So none is made.
  local made_push=no
  if [ "${#push[@]}" -gt 0 ]; then
    made_push=yes
    if ! git push --atomic --quiet ${lease[@]+"${lease[@]}"} origin "${push[@]}"; then
      if [ "${#lease[@]}" -eq 0 ] \
        && attestation_stands_elsewhere "$digest" ${evidence[@]+"${evidence[@]}"}; then
        refuse "origin already holds an attestation for this tree from this signer, and that namespace admits creations only, so a second observation of the same tree has nowhere to go. That is bd-7b7d58f rather than anything approving again will clear. Nothing was published and main is untouched"
      else
        diagnose_request_push "$ref" "$pending"
      fi
      report_local_evidence ${evidence[@]+"${evidence[@]}"}
      return 1
    fi
  fi

  # The lines under the request line, which differ by what was found and
  # what was done about it.
  local -a standing=()

  if [ "$pending" = "$head" ]; then
    # The request ref was not in that push, so where it stands now is not
    # something this run established. Read it again rather than repeat
    # what was read before it: in between, the integrator may have landed
    # the change and consumed the ref, or another approval may have
    # replaced it.
    #
    # Nothing here writes it back. Re-creating a consumed request would
    # file a change already in the stream, which the commit rule calls out
    # as the state it consumes the ref to avoid; replacing a request
    # another approval has just filed would clobber the winner; and
    # either would be a second push behind the one this verb promises. So
    # what this does is say what is true and stop. Approving again is the
    # repair, and by then it takes the create or the replace path against
    # what is actually there.
    local after
    if ! after="$(remote_ref "$ref")"; then
      refuse "$ref could not be read again, so whether the request still stands at this head is not known here"
      report_local_evidence ${evidence[@]+"${evidence[@]}"}
      return 1
    fi
    if [ -z "$after" ]; then
      refuse "the request was consumed while this run was working, which is what the integrator does when a change lands. Nothing here re-filed it: a request for a change already in the stream is judged against an empty delta on every pass. Fetch and review $what again, and approve it once more if it has not landed"
      report_local_evidence ${evidence[@]+"${evidence[@]}"}
      return 1
    fi
    if [ "$after" != "$head" ]; then
      refuse "the request moved to $(git rev-parse --short "$after") ($(subject_of "$after")) while this run was working, so another approval filed it. Nothing here replaced it; approve again to replace it deliberately"
      report_local_evidence ${evidence[@]+"${evidence[@]}"}
      return 1
    fi
    if [ "$made_push" = yes ]; then
      standing+=("the request already stood at this head; the evidence is what was published")
    else
      standing+=("the request already stood at this head and nothing was required, so nothing needed publishing")
    fi
  elif [ -n "$pending" ]; then
    standing+=("replaced the pending request, which stood at $(git rev-parse --short "$pending") ($(subject_of "$pending"))")
  fi

  printf '\nApproved %s (%s): its integration request for origin/%s is filed.\n' \
    "$what" "$(git rev-parse --short "$head")" "$target"
  printf 'The integrator will decide whether this change can land.\n'
  printf 'Your local checkout has not changed.\n\n'
  printf 'Check the result: valley status %q\n\n' "$named"
  printf '  request  %s -> %s\n' "$ref" "$(git rev-parse --short "$head")"
  [ "${#standing[@]}" -eq 0 ] || printf '  %s\n' "${standing[@]}"
  if [ "${#evidence[@]}" -eq 0 ]; then
    printf '  evidence none — nothing was required, so nothing was signed\n'
    printf '  checks   none — the policy requires no check of this change\n'
  else
    printf '  evidence %s\n' "${evidence[@]}"
    printf '  checks   %s\n' "$(printf '%s\n' "${required[@]}" | join_lines)"
  fi
}

# status, ready, unready and withdraw are a Go program, valley-go
# (status/). status reads a change's request and outcome from origin,
# because what front ends read from it is a JSON contract, and because the
# read is subtle enough to want a real parser: an outcome record it does
# not recognise must read as unknown, never as success. It writes nothing
# and moves no local branch. ready, unready and withdraw write a change's
# record, in the one format the push hook reads it in (change/). knot
# reads and writes the plan graph at refs/the-valley/knots, in the one
# form the push hook validates (knot/), and plan shows that graph as a
# view.
cmd_go() {
  command -v valley-go > /dev/null 2>&1 \
    || die "$1 needs the valley-go helper; nix run .#valley bundles it"
  exec valley-go "$@"
}

# A change is named by its full change ID, its handle, or its branch.
# resolve_change reads the name with the helper and sets CHANGE_BRANCH, the
# branch to act on. When the name is a change's, it also sets the change's
# ID, handle, active version, state and owner, and CHANGE_HEAD, the head
# that version records. A branch name is a change's when exactly one record's
# active version is on that branch, and is refused when more than one's is.
# So whether a change's record is read never depends on how it is named,
# and review, approve and rebase cannot run without the helper.
#
# A change with a record is acted on at a head its record names, and never
# at the branch's tip: review at CHANGE_HEAD, and approve at the head bound
# to it (bind_head). rebase reads the record itself (status/rebase.go).
# The branch a record names is only where its head is expected to be, and
# anyone who can push the branch can move it, in the same push as the
# record if they like.
CHANGE_NAME="" CHANGE_ID="" CHANGE_HANDLE="" CHANGE_VERSION="" CHANGE_HEAD="" CHANGE_BRANCH="" CHANGE_STATE=""
CHANGE_OWNER=""

# read_resolved <line> <name…>: read a line of valley-go resolve into the
# variables named, one field each. A version's branch may be empty, and
# read runs consecutive tabs together, since a tab is whitespace to it: an
# empty branch would shift the state into the branch. So each tab is made
# a unit separator first, which read keeps apart.
read_resolved() {
  local resolved="$1"
  shift
  IFS=$'\x1f' read -r "$@" <<< "${resolved//$'\t'/$'\x1f'}"
}

# ready_hint <change ID> <branch>: the valley ready line that readies the
# change again, naming the branch unless its version records none.
ready_hint() {
  printf 'valley ready --change %s' "$1"
  [ -z "$2" ] || printf ' %q' "$2"
}

resolve_change() {
  local line kind
  CHANGE_NAME="$1"
  command -v valley-go > /dev/null 2>&1 \
    || die "review, approve and rebase read the change's record with the valley-go helper; nix run .#valley bundles it"
  line="$(valley-go resolve "$1")" || return 1
  read_resolved "$line" kind CHANGE_ID CHANGE_HANDLE CHANGE_VERSION CHANGE_HEAD CHANGE_BRANCH CHANGE_STATE CHANGE_OWNER
  case "$kind" in
    branch)
      CHANGE_BRANCH="$CHANGE_ID"
      CHANGE_ID=""
      ;;
    change)
      [[ "$CHANGE_HEAD" =~ ^[0-9a-f]{40}$ ]] \
        || die "valley-go resolve named the head $CHANGE_HEAD, which is no object ID"
      case "$CHANGE_STATE" in
        ready | draft | withdrawn) ;;
        *) die "valley-go resolve named the state $CHANGE_STATE, which this script does not read" ;;
      esac
      ;;
    *) die "valley-go resolve answered $line, which this script does not read" ;;
  esac
}

# need_branch <verb>: refuse a change whose active version records no
# branch. review acts on the change's branch: it files its notes under it
# and its [r]eject deletes it. rebase, which pushes it, refuses such a
# change in valley-go. approve files the head alone, so it approves such a
# change.
need_branch() {
  if [ -n "$CHANGE_ID" ] && [ -z "$CHANGE_BRANCH" ]; then
    die "change $CHANGE_HANDLE v$CHANGE_VERSION records no branch, and $1 acts on a change's branch. Approve its head alone: valley approve --head $CHANGE_HEAD $CHANGE_HANDLE"
  fi
}

# The commit review and approve act on: the recorded head for a change
# with a record, and otherwise the branch's head on origin.
change_head() {
  if [ -n "$CHANGE_HEAD" ]; then
    printf '%s\n' "$CHANGE_HEAD"
  else
    git rev-parse "refs/remotes/origin/$1"
  fi
}

# For a change with a record, refuse unless the branch's tip on origin is
# the recorded head, and name both. review's [r]eject acts on the branch
# itself: deleting it while it is elsewhere would delete a commit no
# version records. rebase asks the same in valley-go. approve does not ask
# this, since the request it files names the head it approves and not the
# branch. The second argument is what the refusal leaves undone.
check_recorded_tip() {
  local branch="$1" undone="$2" tip
  [ -n "$CHANGE_HEAD" ] || return 0
  tip="$(git rev-parse "refs/remotes/origin/$branch")" || {
    refuse "no such branch on origin: $branch; $undone"
    return 1
  }
  [ "$tip" = "$CHANGE_HEAD" ] && return 0
  refuse "change $CHANGE_HANDLE v$CHANGE_VERSION records the head $CHANGE_HEAD, and origin/$branch is at $tip; $undone. Ready the branch's head as a new version of $CHANGE_HANDLE to act on it"
}

# For a change with a record, read the record again from origin, and
# refuse unless the change is still ready at the head this run began with.
# A draft is paused and a withdrawn change given up, and neither is
# approved until it is readied again. The record was read when review or
# approve began, and another principal may unready, withdraw or ready a
# new version of the change while a review is open or the checks run. So
# approve reads it again before it runs the checks and before it files.
# These checks save a run that would come to nothing: the integrator makes
# the same one on origin, and lands no request for a change that is not
# ready. rebase makes its own checks in valley-go (status/rebase.go).
#
# A name that read as a plain branch can come to name a change meanwhile:
# someone readies the branch, and perhaps unreadies it, while the review
# is open. So the last check before approve files reads the original name
# again too. approve passes the head it is about to file as the second
# argument. When the name now names a change, the same rules hold: the
# change must be ready, and its recorded head must be that head. The first
# argument is what the refusal leaves undone.
#
# approve binds the head it approves (APPROVE_HEAD), and passes it as the
# third argument. For approve the change must be ready, and that head must
# be one of its version heads, whichever version is active by then: a
# record that moves after review cannot change what lands, since the
# request names the head approved.
check_record() {
  local undone="$1" acting="${2:-}" bound="${3:-}" line kind id handle version head branch state owner
  if [ -z "$CHANGE_ID" ]; then
    [ -n "$acting" ] || return 0
    if ! line="$(valley-go resolve "$CHANGE_NAME")"; then
      refuse "could not read $CHANGE_NAME again against origin's records; $undone"
      return 1
    fi
    read_resolved "$line" kind id handle version head branch state owner
    [ "$kind" = change ] || return 0
    if [ "$state" != ready ]; then
      refuse "$CHANGE_NAME is now change $handle v$version, which is $state, not ready; $undone. Ready it first: $(ready_hint "$id" "$branch")"
      return 1
    fi
    if [ "$head" != "$acting" ]; then
      refuse "$CHANGE_NAME is now change $handle v$version, which records the head $head, and this run began at $acting; $undone. Review it again by its handle"
      return 1
    fi
    return 0
  fi
  if ! line="$(valley-go resolve "$CHANGE_ID")"; then
    refuse "could not read the record of change $CHANGE_HANDLE again; $undone"
    return 1
  fi
  read_resolved "$line" kind id handle version head branch state owner
  if [ "$kind" != change ] || [ "$id" != "$CHANGE_ID" ]; then
    refuse "origin no longer holds a record of change $CHANGE_HANDLE; $undone"
    return 1
  fi
  if [ "$state" != ready ]; then
    refuse "change $CHANGE_HANDLE v$version is $state, not ready; $undone. Ready it first: $(ready_hint "$CHANGE_ID" "$branch")"
    return 1
  fi
  if [ -n "$bound" ]; then
    check_version "$undone" "$bound"
    return
  fi
  if [ "$head" != "$CHANGE_HEAD" ]; then
    refuse "change $CHANGE_HANDLE is at v$version, $head, and this run began at v$CHANGE_VERSION, $CHANGE_HEAD; $undone. Review it again at its new head"
    return 1
  fi
}

# For a change with a record, read its versions from origin again, and
# refuse unless the change is ready and the head given is one of its
# versions' heads. Sets APPROVE_VERSION and APPROVE_TITLE to that
# version's number and title. The first argument is what the refusal
# leaves undone.
APPROVE_VERSION="" APPROVE_TITLE=""
check_version() {
  local undone="$1" head="$2" out n vhead vstate title state=""
  local -a known=()
  APPROVE_VERSION="" APPROVE_TITLE=""
  if ! out="$(valley-go versions "$CHANGE_ID")"; then
    refuse "could not read the versions of change $CHANGE_HANDLE; $undone"
    return 1
  fi
  # read empties its variables at the end of its input, so the state is
  # kept apart from them.
  while IFS=$'\t' read -r n vhead vstate title; do
    state="$vstate"
    known+=("v$n at $vhead")
    if [ "$vhead" = "$head" ]; then
      APPROVE_VERSION="$n"
      APPROVE_TITLE="$title"
    fi
  done <<< "$out"
  if [ "$state" != ready ]; then
    refuse "change $CHANGE_HANDLE is $state, not ready; $undone. Ready it first: $(ready_hint "$CHANGE_ID" "$CHANGE_BRANCH")"
    return 1
  fi
  if [ -z "$APPROVE_VERSION" ]; then
    refuse "$head is no version of change $CHANGE_HANDLE, whose versions are $(printf '%s\n' "${known[@]}" | join_lines); $undone"
    return 1
  fi
}

# The head approve approves for a change with a record, in APPROVE_HEAD.
# With --head, it is exactly that head, which must be one of the record's
# version heads. A front end that shows the change its own way passes the
# head it showed, so what is approved is what was seen, whichever version
# the record makes active by then. Without --head, the operator is shown
# the active version's head and title and asked to confirm them, which
# needs a terminal; off one, approve refuses. The first argument is
# --head's value, or empty.
APPROVE_HEAD=""
bind_head() {
  local want="$1" sha answer
  APPROVE_HEAD=""
  if [ "$CHANGE_STATE" != ready ]; then
    refuse "change $CHANGE_HANDLE v$CHANGE_VERSION is $CHANGE_STATE, not ready; nothing published. Ready it first: $(ready_hint "$CHANGE_ID" "$CHANGE_BRANCH")"
    return 1
  fi
  if [ -n "$want" ]; then
    if ! [[ "$want" =~ ^[0-9a-f]{4,64}$ ]] \
      || ! sha="$(git rev-parse --verify --quiet "$want^{commit}")"; then
      refuse "--head takes the object ID of one of change $CHANGE_HANDLE's version heads, and $want is none here; nothing published"
      return 1
    fi
    check_version "nothing published" "$sha" || return 1
    APPROVE_HEAD="$sha"
    return 0
  fi
  check_version "nothing published" "$CHANGE_HEAD" || return 1
  if [ ! -t 0 ]; then
    refuse "approving change $CHANGE_HANDLE names the head it approves: off a terminal, pass it with --head. Its active version is v$APPROVE_VERSION at $CHANGE_HEAD, $APPROVE_TITLE: valley approve --head $CHANGE_HEAD $CHANGE_HANDLE. Nothing published"
    return 1
  fi
  printf 'approve change %s v%s at %s, %s? [y/N] ' \
    "$CHANGE_HANDLE" "$APPROVE_VERSION" "$CHANGE_HEAD" "$APPROVE_TITLE"
  read -r answer || answer=""
  case "$answer" in
    y | Y | yes) APPROVE_HEAD="$CHANGE_HEAD" ;;
    *)
      refuse "not approved; nothing published"
      return 1
      ;;
  esac
}

# review shows a change with a record at its active version's head, and
# its [a]pprove approves exactly that head. A plain branch is bound to the
# head review pages, when it pages it (show_review, use_layer), and approve
# files that head. approve with no review binds nothing, and files the
# branch's tip on origin as the fetch left it.
bind_review() {
  APPROVE_HEAD="" APPROVE_VERSION=""
  if [ -n "$CHANGE_ID" ]; then
    APPROVE_HEAD="$CHANGE_HEAD"
    APPROVE_VERSION="$CHANGE_VERSION"
  fi
}

# branch_at_shown <branch>: refuse unless the branch on origin is still at
# the head bound to this approval, and name both. origin itself is read,
# not the tracking ref: a push from another checkout moves the branch
# without moving this clone's ref. ls-remote matches a pattern against the
# tail of a ref name, so each ref it lists is compared whole.
branch_at_shown() {
  local out now
  out="$(git ls-remote origin "refs/heads/$1")" || {
    refuse "could not read $1 on origin to check that it is still at $APPROVE_HEAD, the head shown; nothing published"
    return 1
  }
  now="$(printf '%s\n' "$out" | awk -v r="refs/heads/$1" '$2 == r { print $1 }')"
  if [ -z "$now" ]; then
    refuse "origin/$1 is gone, and is no longer at $APPROVE_HEAD, the head shown; nothing published"
    return 1
  fi
  [ "$now" = "$APPROVE_HEAD" ] && return 0
  refuse "origin/$1 is at $now, and is no longer at $APPROVE_HEAD, the head shown; nothing published"
}

# The head the checks failed at in this review, short, while the change is
# still at it. Approving that head again would run the same checks over
# the same tree and fail the same way, so the prompt stops offering
# [a]pprove until the change has a new head. Fails when the checks have
# not failed at the head the change is at.
approve_failed_at() {
  if [ -z "$CHECKS_FAILED_AT" ] || [ "$CHECKS_FAILED_AT" != "$(change_head "$1")" ]; then
    return 1
  fi
  git rev-parse --short "$CHECKS_FAILED_AT"
}

# not_ready <handle> <version> <state> <owner>: the line review shows for a
# change whose record is not ready, above its diff and in its prompt.
# Prints nothing, and fails, for a ready change, and for a plain branch,
# which has no record. A draft is often a change an agent is still working
# on, so the prompt then offers only [v]iew full diff and [s]kip.
# [a]pprove would be refused. [b]ase is not offered either: rebase refuses
# such a change, since adding its rebased head as a version would ready it
# behind its owner's back. Nor is [r]eject, which records nothing on the
# change: it deletes the branch its owner may still be working on, and the
# record says what it said before. approve still reads the record again
# when it acts, since the state can change while the review is open.
not_ready() {
  case "$3" in
    draft) printf "%s v%s is a draft: its owner (%s) hasn't marked it ready, so it can't be approved yet." "$1" "$2" "$4" ;;
    withdrawn) printf '%s is withdrawn: there is nothing to approve.' "$1" ;;
    *) return 1 ;;
  esac
}

# shown_not_ready: not_ready for the change review is showing.
shown_not_ready() {
  not_ready "$CHANGE_HANDLE" "$CHANGE_VERSION" "$CHANGE_STATE" "$CHANGE_OWNER"
}

# Show the branch and take the verdict. Split out of cmd_review so that
# every way out of it — approve, reject, skip — is followed by the notes.
# A change that is not ready is asked as decide asks it: it can be neither
# approved nor rebased, so whether it fast-forwards from main changes
# nothing.
read_and_decide() {
  local branch="$1" choice failed answers
  show_review "$branch"
  # A stale branch's pre-rebase diff is not what would land; offer to rebase it
  # mechanically, then re-review what actually would. [a]pprove is offered
  # here as well, because the integrator applies a delta to the tip rather
  # than fast-forwarding: a stale branch is a request it can judge, and
  # rebasing first is a convenience rather than a precondition.
  while ! shown_not_ready > /dev/null \
    && ! git merge-base --is-ancestor refs/remotes/origin/main "$(change_head "$branch")"; do
    if failed="$(approve_failed_at "$branch")"; then
      printf '%s does not fast-forward from main. Its checks failed at %s, so approving needs a new head: [v]iew full diff, [b]ase onto main, [r]eject, [s]kip? ' \
        "$branch" "$failed"
      answers="v, b, r, or s"
    else
      printf '%s does not fast-forward from main: [a]pprove, [v]iew full diff, [b]ase onto main, [r]eject, [s]kip? ' \
        "$branch"
      answers="a, v, b, r, or s"
    fi
    read -r choice || die "stdin closed before an answer; nothing done"
    case "$choice" in
      a)
        if [ -n "$failed" ]; then
          echo "answer $answers"
        elif approve "$branch"; then
          return
        fi
        ;;
      v) view_full "$branch" ;;
      b)
        # A change with a record gains the rebased head as a new version,
        # so the review goes on at that version, as it does at the rebased
        # tip of a plain branch. A refused rebase has said why, and the
        # prompt comes back.
        if rebase_shown "$(change_head "$branch")"; then
          if [ -n "$CHANGE_ID" ]; then
            resolve_change "$CHANGE_ID" || die "could not read change $CHANGE_HANDLE again after the rebase"
            bind_review
          fi
          fetch_origin
          show_review "$branch"
        fi
        ;;
      r) reject "$branch" && return ;;
      s)
        echo "skipped $branch; nothing done"
        return
        ;;
      *) echo "answer $answers" ;;
    esac
  done
  decide "$branch"
}

# decide <branch> [<name> <n>]: the verdict on a change that fast-forwards
# from main, and on the top of a stack, which is never offered [b]ase. A
# change alone is asked about by its branch. The top of a stack of <n> is
# asked about by its <name>, as the stack lists it, and its prompt says
# that approving it lands all <n> layers. [v]iew full diff pages the
# change's whole diff, or the top layer's.
#
# A change that is not ready is asked about by the line not_ready gives,
# in place of the label, and is offered only [v]iew full diff and
# [s]kip, or [s]top. The top of a stack with a layer under it that is not
# ready says why it can't be approved (layer_held), and is offered the
# rest.
decide() {
  local branch="$1" name="${2:-}" n="${3:-}" choice failed answers own held=""
  local label="$1" approve="[a]pprove" reject="[r]eject" stop="[s]kip"
  local stopped="skipped $1; nothing done"
  own="$(shown_not_ready)" || own=""
  if [ -n "$n" ]; then
    label="$name, $n of $n" approve="[a]pprove all $n" reject="[r]eject $name" stop="[s]top"
    stopped="stopped reviewing $name at change $n of $n; nothing done"
    held="$(layer_held $((n - 1)))" || held=""
  fi
  while true; do
    failed=""
    if [ -n "$own" ]; then
      if [ -n "$n" ]; then
        printf '%s: %s [v]iew full diff, %s? ' "$label" "$own" "$stop"
      else
        printf '%s [v]iew full diff, %s? ' "$own" "$stop"
      fi
      answers="v or s"
    elif [ -n "$held" ]; then
      printf '%s: %s [v]iew full diff, %s, %s? ' "$label" "$held" "$reject" "$stop"
      answers="v, r, or s"
    elif failed="$(approve_failed_at "$branch")"; then
      printf '%s: its checks failed at %s, so approving needs a new head: [v]iew full diff, %s, %s? ' \
        "$label" "$failed" "$reject" "$stop"
      answers="v, r, or s"
    else
      printf '%s: %s, [v]iew full diff, %s, %s? ' "$label" "$approve" "$reject" "$stop"
      answers="a, v, r, or s"
    fi
    read -r choice || die "stdin closed before an answer; nothing done"
    case "$choice" in
      # A refusal from approve is not a verdict: it says what it did not do
      # and the prompt comes back, so the branch can still be rejected or
      # skipped. When the checks failed, approving the same head again is
      # no longer offered, nor is approving a change that is not ready.
      a)
        if [ -n "$failed" ] || [ -n "$own" ] || [ -n "$held" ]; then
          echo "answer $answers"
        elif approve "$branch"; then
          return
        fi
        ;;
      v)
        if [ -n "$n" ]; then
          view_layer $((n - 1))
        else
          view_full "$branch"
        fi
        ;;
      r)
        if [ -n "$own" ]; then
          echo "answer $answers"
        else
          reject "$branch" && return
        fi
        ;;
      s)
        echo "$stopped"
        return
        ;;
      *) echo "answer $answers" ;;
    esac
  done
}

# ----------------------------------------------------------------------
# A stack — a change with layers under it that have not landed — is
# reviewed one layer at a time, bottom first, each against the layer below
# it, the way it was built. Approving the top lands every layer under it,
# so reading the top against main alone would ask the operator to judge
# the whole stack as one diff.
#
# The layers are valley-go stack's (status/stack.go): one line each, bottom
# first, the change itself last, read here into one array per field.
# L_BRANCH is the branch a layer's notes are kept under: a branch's own
# name, or the branch a change's active version names. L_OWNER is a
# change's owner, as its record names it. L_NOTES holds the notes taken on
# each layer, for the print after the verdict.
L_KIND=() L_NAME=() L_BASE=() L_HEAD=() L_STATE=() L_TITLE=()
L_ID=() L_VERSION=() L_BRANCH=() L_OWNER=() L_NOTES=()
# The name review was given, which the top is read again by.
TOP_NAME=""

# read_stack: read the stack under the change review resolved. Each change
# under the top is read again with resolve, for its ID, version, branch
# and owner, and must still be at the head the stack names. The top must be
# what review resolved. Fails, having said why, when either does not hold
# or the helper cannot read the stack. Called in a condition, so each step
# is checked by hand.
read_stack() {
  local out line kind name base head state title k last
  local rkind id handle version rhead branch rstate owner
  L_KIND=() L_NAME=() L_BASE=() L_HEAD=() L_STATE=() L_TITLE=()
  L_ID=() L_VERSION=() L_BRANCH=() L_OWNER=() L_NOTES=()
  out="$(valley-go stack "${CHANGE_ID:-origin/$CHANGE_BRANCH}")" || return 1
  while IFS= read -r line; do
    read_resolved "$line" kind name base head state title
    if ! [[ "$kind" =~ ^(change|branch)$ && "$base" =~ ^[0-9a-f]{40}$ && "$head" =~ ^[0-9a-f]{40}$ ]]; then
      refuse "valley-go stack answered $line, which this script does not read"
      return 1
    fi
    L_KIND+=("$kind") L_NAME+=("$name") L_BASE+=("$base") L_HEAD+=("$head")
    L_STATE+=("$state") L_TITLE+=("$title") L_NOTES+=("")
    L_ID+=("") L_VERSION+=("") L_BRANCH+=("$name") L_OWNER+=("")
  done <<< "$out"
  last=$((${#L_NAME[@]} - 1))
  if [ "${L_HEAD[last]}" != "$(change_head "$CHANGE_BRANCH")" ] \
    || [ "${L_KIND[last]}" != "$([ -n "$CHANGE_ID" ] && echo change || echo branch)" ]; then
    refuse "$TOP_NAME moved while its stack was read"
    return 1
  fi
  L_ID[last]="$CHANGE_ID" L_VERSION[last]="$CHANGE_VERSION" L_BRANCH[last]="$CHANGE_BRANCH"
  L_OWNER[last]="$CHANGE_OWNER"
  for ((k = 0; k < last; k++)); do
    [ "${L_KIND[k]}" = change ] || continue
    line="$(valley-go resolve "${L_NAME[k]}")" || return 1
    read_resolved "$line" rkind id handle version rhead branch rstate owner
    if [ "$rkind" != change ] || [ "$rhead" != "${L_HEAD[k]}" ]; then
      refuse "change ${L_NAME[k]}, under $TOP_NAME, moved while the stack was read"
      return 1
    fi
    L_ID[k]="$id" L_VERSION[k]="$version" L_BRANCH[k]="$branch" L_STATE[k]="$rstate"
    L_OWNER[k]="$owner"
  done
}

# use_layer <k>: act on layer k as review acts on a change it was given,
# binding [a]pprove to the head the stack shows. A branch under the top is
# read again as origin/<branch>, which no handle can shadow.
use_layer() {
  local k="$1"
  CHANGE_ID="${L_ID[k]}" CHANGE_VERSION="${L_VERSION[k]}" CHANGE_BRANCH="${L_BRANCH[k]}"
  CHANGE_STATE="${L_STATE[k]}" CHANGE_OWNER="${L_OWNER[k]}" CHANGE_HANDLE="" CHANGE_HEAD=""
  CHANGE_NAME="origin/${L_NAME[k]}"
  [ "$k" -lt $((${#L_NAME[@]} - 1)) ] || CHANGE_NAME="$TOP_NAME"
  if [ -n "$CHANGE_ID" ]; then
    CHANGE_NAME="${L_NAME[k]}" CHANGE_HANDLE="${L_NAME[k]}" CHANGE_HEAD="${L_HEAD[k]}"
  fi
  bind_review
  [ -n "$CHANGE_ID" ] || APPROVE_HEAD="${L_HEAD[k]}"
}

# notes_key <k>: the branch layer k's notes are kept under. A change whose
# active version names no branch keeps them under its handle.
notes_key() {
  printf '%s' "${L_BRANCH[$1]:-${L_NAME[$1]}}"
}

# layer_label <k>: how a layer is named in the list: its name, then
# branch, or the change's state.
layer_label() {
  local k="$1"
  if [ "${L_KIND[k]}" = branch ]; then
    printf '%s (branch)' "${L_NAME[k]}"
  else
    printf '%s (%s)' "${L_NAME[k]}" "${L_STATE[k]}"
  fi
}

# What is coming: the layers bottom first, the lower layers the integrator
# would refuse, and what each answer lands.
summarize_stack() {
  local n="${#L_NAME[@]}" k
  printf '%s is a stack of %d changes; reviewing from the bottom, each against the one below it:\n' \
    "${L_NAME[n - 1]}" "$n"
  for ((k = 0; k < n; k++)); do
    printf '  %d. %s: %s\n' "$((k + 1))" "$(layer_label "$k")" "${L_TITLE[k]}"
  done
  for ((k = 0; k < n - 1; k++)); do
    case "${L_STATE[k]}" in
      draft | withdrawn)
        printf 'warning: %s, change %d of %d, is %s. The integrator refuses to land it or anything above it (refused-not-ready).\n' \
          "${L_NAME[k]}" "$((k + 1))" "$n" "$([ "${L_STATE[k]}" = draft ] && echo 'a draft' || echo withdrawn)"
        ;;
    esac
  done
  printf 'read each layer and go on with [n]; approving %s at the top lands all %d. [a] on a lower layer lands it and the layers under it, and ends the review.\n' \
    "${L_NAME[n - 1]}" "$n"
}

# base_stack: before any layer is paged, a stack whose bottom does not
# fast-forward from main is offered [b]ase, which rebases every layer as
# the rebase verb does (status/rebase.go), or [s]top. After a rebase the
# stack is read again and listed again, so the heads paged are the heads
# approved. A rebase refused or left unfinished has said what happened,
# and only [s]top is offered then. Fails when the review stops here.
base_stack() {
  local n choice offered="[b]ase" stopped="; nothing done"
  while ! git merge-base --is-ancestor refs/remotes/origin/main "${L_HEAD[0]}"; do
    n="${#L_NAME[@]}"
    if [ -n "$offered" ]; then
      printf '%s, at the bottom, does not fast-forward from main: [b]ase all %d onto main, [s]top? ' \
        "${L_NAME[0]}" "$n"
    else
      printf 'the stack under %s is not rebased: [s]top? ' "${L_NAME[n - 1]}"
    fi
    read -r choice || die "stdin closed before an answer; nothing done"
    case "$choice" in
      b)
        if [ -z "$offered" ]; then
          echo "answer s"
        elif rebase_shown "${L_HEAD[n - 1]}"; then
          fetch_origin
          if [ -n "$CHANGE_ID" ]; then
            resolve_change "$CHANGE_ID" || die "could not read change $CHANGE_HANDLE again after the rebase"
          fi
          bind_review
          read_stack || die "could not read the stack under $TOP_NAME again after the rebase"
          summarize_stack
        else
          offered="" stopped=""
        fi
        ;;
      s)
        echo "stopped reviewing ${L_NAME[n - 1]} before its first layer$stopped"
        return 1
        ;;
      *) echo "answer ${offered:+b or }s" ;;
    esac
  done
}

# layer_heading <k>: the line that heads layer k wherever it is shown.
layer_heading() {
  local k="$1" below=main
  [ "$k" -eq 0 ] || below="${L_NAME[k - 1]}"
  printf 'change %d of %d: %s on %s' "$((k + 1))" "${#L_NAME[@]}" "${L_NAME[k]}" "$below"
}

# layer_held <k>: why layer k can't be approved, when it or a layer under
# it is not ready. A layer that is not ready says so as a change alone
# does (not_ready). A layer above one says which: approving it would land
# that layer too, and the integrator lands nothing that would bring a
# version of a change that is not ready. Prints nothing, and fails, when
# every layer up to k is ready or a plain branch.
layer_held() {
  local k="$1" j
  not_ready "${L_NAME[k]}" "${L_VERSION[k]}" "${L_STATE[k]}" "${L_OWNER[k]}" && return
  for ((j = k - 1; j >= 0; j--)); do
    case "${L_STATE[j]}" in
      draft | withdrawn)
        printf "it would bring %s, change %d of %d, which is %s, so it can't be approved yet." \
          "${L_NAME[j]}" "$((j + 1))" "${#L_NAME[@]}" "$([ "${L_STATE[j]}" = draft ] && echo 'a draft' || echo withdrawn)"
        return
        ;;
    esac
  done
  return 1
}

# page_layer <k>: show layer k, as show_review shows a change alone. The
# layer shown is compared with its own change's approved version, so a
# lower layer is set against its own approval, not the top's. Its whole
# diff is against the layer below it. The notes taken in it are kept
# under its own branch. When it can't be approved, layer_held's line
# follows its heading, before the layer's knots.
page_layer() {
  local k="$1" heading held
  NOTES=()
  heading="$(layer_heading "$k")"
  if held="$(layer_held "$k")"; then heading+=$'\n'"$held"; fi
  REVIEW_TMP="$(mktemp -d)"
  compare_shown "${L_ID[k]}" "${L_VERSION[k]}" "${L_HEAD[k]}"
  show_compared "$(notes_key "$k")" "${L_HEAD[k]}" "$heading" "$(does_of "${L_ID[k]}")" layer_diff "$k"
  keep_layer_notes "$k"
}

# view_layer <k>: [v]iew full diff for layer k: its whole diff against
# the layer below it.
view_layer() {
  local k="$1"
  NOTES=()
  REVIEW_TMP="$(mktemp -d)"
  {
    layer_heading "$k"
    printf '\n'
    layer_diff "$k"
  } > "$REVIEW_TMP/review.diff"
  page_buffer "$(notes_key "$k")" "$(git rev-parse --short "${L_HEAD[k]}")"
  keep_layer_notes "$k"
}

# keep_layer_notes <k>: add the notes just taken to layer k's.
keep_layer_notes() {
  [ "${#NOTES[@]}" -gt 0 ] || return 0
  L_NOTES[$1]="${L_NOTES[$1]:+${L_NOTES[$1]}$'\n'}$(printf '%s\n' "${NOTES[@]}")"
}

# layer_diff <k>: layer k's whole diff: its log and its diff against the
# layer below it.
layer_diff() {
  local k="$1" below=main head base sha on
  [ "$k" -eq 0 ] || below="${L_NAME[k - 1]}"
  head="${L_HEAD[k]}" base="${L_BASE[k]}"
  sha="$(git rev-parse --short "$head")"
  on="$below at $(git rev-parse --short "$base")"
  if [ "${L_KIND[k]}" = branch ]; then
    printf 'branch %s, log against %s:\n\n' "${L_NAME[k]}" "$on"
  elif [ -n "${L_BRANCH[k]}" ]; then
    printf 'change %s v%s at %s, on branch %s, log against %s:\n\n' \
      "${L_NAME[k]}" "${L_VERSION[k]}" "$sha" "${L_BRANCH[k]}" "$on"
  else
    printf 'change %s v%s at %s, log against %s:\n\n' "${L_NAME[k]}" "${L_VERSION[k]}" "$sha" "$on"
  fi
  git --no-pager log --oneline "$base..$head"
  printf '\n'
  git --no-pager diff "$base...$head"
}

# Show each layer under the top and ask after each, naming the layer and
# its place: [n]ext layer goes on to the layer above, [a]pprove approves
# that layer at the head shown, which lands it and every layer under it,
# as the prompt names them, [v]iew full diff pages the layer's whole diff,
# and [s]top ends the review. [r]eject is not offered under the top:
# deleting a lower layer's branch would leave the layers above still
# holding it. [a]pprove is not offered at or above a layer that is not
# ready, and the prompt says why in its place (layer_held). After the
# top, its verdict is taken as for any change, with a prompt that names
# the top and says approving it lands all n.
review_stack() {
  local n top k choice answers failed lands held
  summarize_stack
  base_stack || return 0
  printf '\n'
  n="${#L_NAME[@]}" top=$((${#L_NAME[@]} - 1))
  for ((k = 0; k < top; k++)); do
    page_layer "$k"
    case "$k" in
      0) lands="${L_NAME[0]} alone" ;;
      1) lands="${L_NAME[0]} and ${L_NAME[1]}" ;;
      *) lands="the $((k + 1)) up to ${L_NAME[k]}" ;;
    esac
    held="$(layer_held "$k")" || held=""
    while true; do
      failed=""
      [ "$CHECKS_FAILED_AT" != "${L_HEAD[k]}" ] || failed="$(git rev-parse --short "${L_HEAD[k]}")"
      if [ -n "$held" ]; then
        printf '%s, %d of %d: %s [n]ext layer, [v]iew full diff, [s]top? ' \
          "${L_NAME[k]}" "$((k + 1))" "$n" "$held"
        answers="n, v, or s"
      elif [ -n "$failed" ]; then
        printf '%s, %d of %d: its checks failed at %s, so approving needs a new head: [n]ext layer, [v]iew full diff, [s]top? ' \
          "${L_NAME[k]}" "$((k + 1))" "$n" "$failed"
        answers="n, v, or s"
      else
        printf '%s, %d of %d: [n]ext layer, [a]pprove %s, [v]iew full diff, [s]top? ' \
          "${L_NAME[k]}" "$((k + 1))" "$n" "$lands"
        answers="n, a, v, or s"
      fi
      read -r choice || die "stdin closed before an answer; nothing done"
      case "$choice" in
        n) break ;;
        a)
          if [ -n "$failed" ] || [ -n "$held" ]; then
            echo "answer $answers"
            continue
          fi
          use_layer "$k"
          if approve "$CHANGE_BRANCH"; then
            return
          fi
          use_layer "$top"
          ;;
        v) view_layer "$k" ;;
        s)
          echo "stopped reviewing ${L_NAME[top]} at change $((k + 1)) of $n, ${L_NAME[k]}; nothing done"
          return
          ;;
        *) echo "answer $answers" ;;
      esac
    done
  done
  page_layer "$top"
  use_layer "$top"
  decide "${L_BRANCH[top]}" "${L_NAME[top]}" "$n"
}

# The notes taken on every layer, each under its own branch.
print_stack_notes() {
  local k
  for ((k = 0; k < ${#L_NAME[@]}; k++)); do
    [ -n "${L_NOTES[k]}" ] || continue
    mapfile -t NOTES <<< "${L_NOTES[k]}"
    print_notes "$(notes_key "$k")"
  done
}

cmd_review() {
  local name="" verbose=() arg
  for arg in "$@"; do
    case "$arg" in
      -v) verbose=(-v) ;;
      -*) die "usage: valley review [-v] <change>" ;;
      *)
        [ -z "$name" ] || die "usage: valley review [-v] <change>"
        name="$arg"
        ;;
    esac
  done
  [ -n "$name" ] || die "usage: valley review [-v] <change>"
  set -- "$name"
  resolve_change "$1" || exit 1
  need_branch review
  local branch="$CHANGE_BRANCH"
  TOP_NAME="$1"
  fetch_origin
  git rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null \
    || die "no such branch on origin: $branch"
  bind_review
  trap cleanup_scratch EXIT
  trap 'exit 130' INT TERM
  # The verdict disposes of the change; the notes are what the human made
  # of it, so they are printed whatever the verdict was. A stack that
  # cannot be read is reviewed whole against main, as a change with
  # nothing under it is.
  if ! read_stack; then
    printf 'valley: warning: the stack under %s could not be read; reviewing it whole, against main\n' "$1" >&2
    L_NAME=()
  fi
  read_does "${verbose[@]}"
  if [ "${#L_NAME[@]}" -gt 1 ]; then
    review_stack
    print_stack_notes
  else
    read_and_decide "$branch"
    print_notes "$branch"
  fi
}

# approve and rebase are review's [a]pprove and [b]ase without the pager,
# for a front end that has shown the change its own way. Each runs the
# code its key runs, approve and valley-go rebase, so the verb and the key
# cannot drift apart. A change is named as resolve_change reads it, and
# rebase reads its name the same way, in valley-go.
#
# approve of a change with a record approves exactly one head (bind_head):
# --head's, or the active version's once the operator confirms it on a
# terminal. A plain branch is approved at its tip on origin, as the fetch
# left it, and --head, when given, must be that tip.
cmd_approve() {
  local name="" want=""
  local usage="usage: valley approve [--head <sha>] <change>"
  while [ $# -gt 0 ]; do
    case "$1" in
      --head)
        [ $# -ge 2 ] || die "$usage"
        want="$2"
        shift 2
        ;;
      --head=*)
        want="${1#--head=}"
        shift
        ;;
      -*) die "$usage" ;;
      *)
        [ -z "$name" ] || die "$usage"
        name="$1"
        shift
        ;;
    esac
  done
  [ -n "$name" ] || die "$usage"
  resolve_change "$name" || exit 1
  local branch="$CHANGE_BRANCH" tip
  fetch_origin
  trap cleanup_scratch EXIT
  trap 'exit 130' INT TERM
  if [ -n "$CHANGE_ID" ]; then
    bind_head "$want" || exit 1
  else
    tip="$(git rev-parse --verify --quiet "refs/remotes/origin/$branch")" \
      || die "no such branch on origin: $branch"
    if [ -n "$want" ] && [ "$(git rev-parse --verify --quiet "$want^{commit}" || true)" != "$tip" ]; then
      die "origin/$branch is at $tip, not $want; nothing published"
    fi
  fi
  # In a condition, as the review prompt calls it: approve checks each of
  # its own steps, and has already said why when it refuses.
  approve "$branch" || exit 1
}

cmd_rebase() {
  case "${1:-}" in -*) die "usage: valley rebase <change>" ;; esac
  [ $# -eq 1 ] || die "usage: valley rebase <change>"
  command -v valley-go > /dev/null 2>&1 \
    || die "review, approve and rebase read the change's record with the valley-go helper; nix run .#valley bundles it"
  fetch_origin
  exec valley-go rebase "$1"
}

# tail and replay are thin wrappers over the nats CLI — anything they do,
# plain nats and git can do. They are the only verbs needing more than git
# and coreutils.
need_nats() {
  command -v nats >/dev/null 2>&1 \
    || die "this verb needs the nats CLI (natscli); nix run .#valley bundles it"
}

cmd_tail() {
  [ $# -le 1 ] || die "usage: valley tail [subject]"
  need_nats
  exec nats sub "${1:-valley.>}"
}

# One ref-updated event per existing ref, from git for-each-ref alone. A
# ref's prior value is not derivable from the repository, so `old` is the
# all-zero id — the same payload a push creating the ref would produce.
# The payload construction mirrors the host module's publisher hook
# (nix/valley-host.nix); change one only with the other.
cmd_replay() {
  [ $# -le 1 ] || die "usage: valley replay [repo-dir]"
  need_nats
  local dir="${1:-.}" repo sha ref event count=0
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 \
    || die "not a git repository: $dir"
  if [ "$(git -C "$dir" rev-parse --is-bare-repository)" = true ]; then
    repo="$(basename "$(git -C "$dir" rev-parse --absolute-git-dir)" .git)"
  else
    repo="$(basename "$(git -C "$dir" rev-parse --show-toplevel)")"
  fi
  while read -r sha ref; do
    # " is the only JSON-significant character a refname can contain (git
    # forbids \ and control characters); names and object ids are safe.
    event="$(printf '{"event":"ref-updated","repo":"%s","ref":"%s","old":"%s","new":"%s"}' \
      "$repo" "${ref//\"/\\\"}" "${sha//?/0}" "$sha")"
    nats pub "valley.git.$repo.ref-updated" "$event" >/dev/null
    count=$((count + 1))
  done < <(git -C "$dir" for-each-ref --format='%(objectname) %(refname)')
  echo "replayed $count refs of $repo onto the bus"
}

# ----------------------------------------------------------------------
# checks — the verification-policy deriver (dcr-f41f718). It composes the
# instance layer with the project layer, matches every side of a diff
# against the composed classes, and prints the check names the policy
# requires of the change, with the class or classes that made each one
# required. It reports: no check is run, nothing is gated, nothing is
# written.
#
# Composition is CUE's, never this script's. The whole of the mandatory-
# versus-overridable distinction is unification, so reimplementing it here
# would be reimplementing the decision. What this script does that CUE
# cannot is glob matching and reading a diff.

need_cue() {
  command -v cue >/dev/null 2>&1 \
    || die "this verb needs the cue CLI; nix run .#valley bundles it"
}

# One glob segment as an ERE fragment: `*` and `?` are wildcards that never
# cross a `/`, and every ERE metacharacter is escaped.
segment_ere() {
  local seg="$1" out="" i c
  for ((i = 0; i < ${#seg}; i++)); do
    c="${seg:i:1}"
    case "$c" in
      '*') out+='[^/]*' ;;
      '?') out+='[^/]' ;;
      '.' | '^' | '$' | '+' | '(' | ')' | '[' | ']' | '{' | '}' | '|' | \\) out+="\\$c" ;;
      *) out+="$c" ;;
    esac
  done
  printf '%s' "$out"
}

# A path glob as an anchored ERE, segment by segment. A `**` segment matches
# any number of segments including none, so it swallows the separator that
# would otherwise follow it and `a/**/b` matches `a/b`; every other segment
# matches exactly one.
glob_ere() {
  local ere='^' i last
  local -a segs=()
  IFS=/ read -r -a segs <<<"$1"
  last=$((${#segs[@]} - 1))
  for ((i = 0; i <= last; i++)); do
    if [ "${segs[i]}" = '**' ]; then
      if [ "$i" -eq "$last" ]; then ere+='.*'; else ere+='(.*/)?'; fi
    else
      ere+="$(segment_ere "${segs[i]}")"
      [ "$i" -eq "$last" ] || ere+='/'
    fi
  done
  printf '%s$' "$ere"
}

# The composed policy as one tab-separated line per covered pattern, per
# required check, per class's carry mode, and per field of the check
# catalogue, so the shell never parses CUE. Every line is three fields — a
# kind, a name, and a value — whatever the kind, so one reader takes them
# all. The field is hidden because the schema's sentinel rejects unknown
# top-level fields, and `unclassified` is rendered as a class of that name:
# it is one more source a check can come from. A class's carry mode is the
# one the schema resolves (`_mode`), so the shell only picks the strictest.
#
# Each line is held to its shape (`line`): three fields, two tabs, and no
# other control character. A newline in a field would end its line and
# start one of the policy's choosing, and a tab would add a field. The
# schema already refuses control characters in every string rendered here,
# so this is a second wall: a line out of shape fails the render, and the
# deriver refuses a render that fails. The whole line is checked because a
# bound on a value inside an interpolation does not fail the string.
#
# The catalogue is rendered because a caller that runs a check needs what
# the policy says a check IS — its runner, and the attribute or command
# line that runner takes — and a tool that groups the required checks
# needs their cost. `checks` reads only the cost, to group the required
# checks by it; approve turns the rest into the arguments attest is given.
render_cue() {
  cat <<'EOF'
package verification

import (
	"list"
	"strings"
)

let line = =~"^[^\\x00-\\x1f\\x7f]+\t[^\\x00-\\x1f\\x7f]+\t[^\\x00-\\x1f\\x7f]+$"

_render: strings.Join(list.Concat([[
	for cn, c in policy.classes
	for p, on in c.paths if on {"path\t\(cn)\t\(p)" & line}
], [
	for cn, c in policy.classes
	for k, on in c.requires if on {"requires\t\(cn)\t\(k)" & line}
], [
	for k, on in policy.unclassified if on {"requires\tunclassified\t\(k)" & line}
], [
	for cn, m in _mode {"carry\t\(cn)\t\(m)" & line}
], [
	for n, c in policy.checks {"runner\t\(n)\t\(c.runner)" & line}
], [
	for n, c in policy.checks if c.runner == "nix" {"attribute\t\(n)\t\(c.attribute)" & line}
], [
	for n, c in policy.checks if c.runner == "command" {"command\t\(n)\t\(c.command)" & line}
], [
	for n, c in policy.checks {"cost\t\(n)\t\(c.cost)" & line}
]]), "\n")
EOF
}

# The composed layer, and a scratch directory for the documents the
# derivation writes into the composition. Globals so the probe below can
# see them.
POLICY_LAYER=()
POLICY_TMP=""

cleanup_policy_tmp() {
  [ -n "$POLICY_TMP" ] || return 0
  rm -rf "$POLICY_TMP"
  POLICY_TMP=""
}

# Where the schema and the two policy layers come from in a project
# following the convention (dcr-f41f718).
#
# The client derives from exactly the sources the integrator uses
# (integrator/policy.go), and the working tree is not among them. The
# project's own layer is read from the TARGET's tip, the pointer naming the
# owning valley is read from the target's tip, and the floor is read from
# that valley's integrated tip. A change never supplies the policy that
# gates it, and neither does whoever happens to be reviewing it: the
# reviewer's checkout may be any branch, however stale, and derivation
# gives the same answer from all of them.
#
# The schema is not a policy layer. It is the shape a policy is written in,
# and it ships with this tool: the package sets VALLEY_VERIFICATION_SCHEMA
# to the copy it was built with, as the integrator's package does. Only
# the-valley's own tree carries schema/, so this script reads the schema
# there only when it runs straight from such a checkout with the variable
# unset.
#
# Neither layer is ever the worked example under examples/policy/ — a gate
# derived from an example is a gate nobody wrote. `checks` takes an option
# for each, so a reader can point it at the example or anywhere else on
# purpose; approve takes no such option, because a request is filed
# against the policy that governs the project and nowhere else.
#
# Neither layer is a path in this tree, so policy_defaults leaves both
# empty and the two resolvers answer for them. That split is also what
# keeps `checks --instance DIR` from fetching a repository whose layer it
# was told to ignore, and `checks --project DIR` from reading a tip whose
# layer it was told to ignore.
POLICY_SCHEMA=""
POLICY_INSTANCE=""
POLICY_INSTANCE_LABEL=""
POLICY_PROJECT=""
POLICY_PROJECT_LABEL=""
policy_defaults() {
  POLICY_SCHEMA="${VALLEY_VERIFICATION_SCHEMA:-$1/schema/verification.cue}"
  POLICY_INSTANCE=""
  POLICY_INSTANCE_LABEL=""
  POLICY_PROJECT=""
  POLICY_PROJECT_LABEL=""
}

# The floor, copied out of a fetch of the owning valley's repository, and
# the project's own layer, copied out of the target's tip. Globals, so the
# traps clean them up whatever happens.
INSTANCE_TMP=""
cleanup_instance_tmp() {
  [ -n "$INSTANCE_TMP" ] || return 0
  rm -rf "$INSTANCE_TMP"
  INSTANCE_TMP=""
}

PROJECT_TMP=""
cleanup_project_tmp() {
  [ -n "$PROJECT_TMP" ] || return 0
  rm -rf "$PROJECT_TMP"
  PROJECT_TMP=""
}

# The directory each layer lives in, the file naming this project's owning
# valley, and the ref of that valley whose tip carries the floor. The floor
# resolves at the integrated tip, because a floor a project could pin is
# not a floor (dcr-f41f718).
INSTANCE_DIR=policy/instance
PROJECT_DIR=policy/project
VALLEY_POINTER=policy/valley
VALLEY_POINTER_REF=refs/heads/main

# The *.cue documents of one directory at one tree-ish, copied out of a
# repository into a directory on disk. Reading a tip with ls-tree and
# cat-file rather than checking it out is what lets the layers come from
# the target while the checkout stays on whatever branch the reviewer is
# on. 0 copied something, 1 the directory holds no *.cue, 2 the read
# failed.
#
# -z because a path may hold anything but NUL, and *.cue because the layer
# is the directory's documents — the same reading the composer takes.
#
# The listing is written out and its status checked before it is read. A
# listing read straight from a process substitution that failed reads as a
# directory holding nothing, and for the project layer that is the floor
# alone: fewer checks required, from a read that never happened. The listing's
# name is not a *.cue name, so the composer never reads it.
copy_layer() {
  local gitdir="$1" treeish="$2" dir="$3" dest="$4" path name copied=0
  local listing="$dest/.listing"
  git -C "$gitdir" ls-tree --name-only -z "$treeish" "$dir/" > "$listing" \
    || return 2
  while IFS= read -r -d '' path; do
    case "$path" in *.cue) ;; *) continue ;; esac
    name="${path##*/}"
    git -C "$gitdir" cat-file blob "$treeish:$path" > "$dest/$name" || return 2
    copied=1
  done < "$listing"
  rm -f "$listing"
  [ "$copied" -eq 1 ]
}

# The ref whose tip supplies the policy, printed the way a person names it,
# with the commit it stood at. Staleness in a remote-tracking ref is a real
# thing to see, so the report says which commit the layers came out of
# rather than only which ref. A ref that cannot be read fails, so that no
# report names a tip nobody read.
target_label() {
  local ref="$1" short
  short="$(git rev-parse --short "$ref")" || return 1
  ref="${ref#refs/remotes/}"
  ref="${ref#refs/heads/}"
  printf '%s %s' "$ref" "$short"
}

# Resolve the project's own layer, out of the target's tip, into
# POLICY_PROJECT, and set POLICY_PROJECT_LABEL to where it came from.
#
# A target carrying no layer of its own is derived under the floor alone.
# The project layer only ever adds (dcr-f41f718), so the identity of "adds"
# is "adds nothing"; refusing instead would make a repository underivable
# until its first policy commit, and that commit could not derive either.
# This is the integrator's own reading (integrator/policy.go), and the two
# have to agree about an absent layer as much as about a present one.
#
# Absence is answered with a document that adds nothing rather than with an
# argument left off, because the composer is handed a directory of *.cue
# and has no spelling for "no layer".
#
# It reports and returns rather than dying, for the reason derive_required
# does: a refusal inside the review loop is not the end of the session.
resolve_project_layer() {
  local root="$1" target="$2" rc at

  at="$(target_label "$target")" || {
    refuse "could not read $target; nothing derived"
    return 1
  }
  cleanup_project_tmp
  PROJECT_TMP="$(mktemp -d)" || {
    refuse "no scratch directory to read the project layer into; nothing derived"
    return 1
  }
  copy_layer "$root" "$target" "$PROJECT_DIR" "$PROJECT_TMP" && rc=0 || rc=$?
  case "$rc" in
    0)
      POLICY_PROJECT="$PROJECT_TMP"
      POLICY_PROJECT_LABEL="$PROJECT_DIR@$at"
      ;;
    1)
      printf 'package verification\n' > "$PROJECT_TMP/adds-nothing.cue" || {
        cleanup_project_tmp
        refuse "could not compose an empty project layer; nothing derived"
        return 1
      }
      POLICY_PROJECT="$PROJECT_TMP"
      POLICY_PROJECT_LABEL="no $PROJECT_DIR@$at — the floor alone"
      ;;
    *)
      cleanup_project_tmp
      refuse "could not read $PROJECT_DIR/ at $at; nothing derived"
      return 1
      ;;
  esac
}

# The first line of the pointer that is neither blank nor a comment. Read
# in the shell so that naming an owning valley needs nothing beyond what
# the rest of this script needs.
pointer_url() {
  local line url=""
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] || continue
    url="$line"
    break
  done < "$1"
  printf '%s' "$url"
}

# Resolve the floor to a directory on disk, into POLICY_INSTANCE, and set
# POLICY_INSTANCE_LABEL to where it came from — a temporary directory is
# not an answer a reader can check.
#
# Every project has exactly one owning valley, and the floor is that
# valley's (dcr-9b5da04). It is read from the valley's own repository and
# never from the project's tree, which is the tree under judgment. Two
# shapes, and the first is a special case of the second:
#
#   - a valley's config repository carries policy/instance itself, and is
#     governed by that floor like every other project. It uses its own,
#     and fetches nothing.
#   - every other project names its owning valley at policy/valley. That
#     repository is fetched into scratch and its policy/instance is read
#     at the integrated tip. Fetching is all this needs, and anyone the
#     valley governs necessarily holds fetch on it.
#
# Both the pointer and a valley's own floor are read from the TARGET's tip
# and never from the working tree. The pointer is a file a branch can edit,
# so reading it from the branch would let a change name the valley that
# gates it; reading it from the checkout would let whoever is reviewing
# decide the same thing by accident, which is the failure this fixes. An
# absent floor is refused — that is the direction absence defaults in for
# this layer, because the floor is the minimum (dcr-f41f718).
#
# It reports and returns rather than dying, for the reason derive_required
# does: a refusal inside the review loop is not the end of the session.
resolve_instance_layer() {
  local root="$1" target="$2" url bare dest rc at
  at="$(target_label "$target")" || {
    refuse "could not read $target; nothing derived"
    return 1
  }
  cleanup_instance_tmp
  INSTANCE_TMP="$(mktemp -d)" || {
    refuse "no scratch directory to read the floor into; nothing derived"
    return 1
  }
  dest="$INSTANCE_TMP/instance"
  mkdir -p "$dest"

  copy_layer "$root" "$target" "$INSTANCE_DIR" "$dest" && rc=0 || rc=$?
  case "$rc" in
    0)
      POLICY_INSTANCE="$dest"
      POLICY_INSTANCE_LABEL="$INSTANCE_DIR@$at (this repository is its own valley)"
      return 0
      ;;
    1) ;; # no floor of its own: the pointer names the valley that has one
    *)
      cleanup_instance_tmp
      refuse "could not read $INSTANCE_DIR/ at $at; nothing derived"
      return 1
      ;;
  esac

  git -C "$root" cat-file blob "$target:$VALLEY_POINTER" > "$INSTANCE_TMP/pointer" 2> /dev/null || {
    cleanup_instance_tmp
    refuse "no owning valley: $VALLEY_POINTER names the repository whose $INSTANCE_DIR is this project's floor, and $at carries no such file. A valley's own config repository carries $INSTANCE_DIR instead. Nothing derived"
    return 1
  }
  url="$(pointer_url "$INSTANCE_TMP/pointer")"
  [ -n "$url" ] || {
    cleanup_instance_tmp
    refuse "$VALLEY_POINTER at $at names no repository — it wants one line, the owning valley as git fetch takes it; nothing derived"
    return 1
  }

  bare="$INSTANCE_TMP/valley.git"
  git init --quiet --bare "$bare" || {
    cleanup_instance_tmp
    refuse "no scratch repository to fetch the floor into; nothing derived"
    return 1
  }
  git -C "$bare" fetch --quiet --depth 1 "$url" "$VALLEY_POINTER_REF" || {
    cleanup_instance_tmp
    refuse "could not fetch the owning valley $url at $VALLEY_POINTER_REF (named by $VALLEY_POINTER at $at); nothing derived"
    return 1
  }

  copy_layer "$bare" FETCH_HEAD "$INSTANCE_DIR" "$dest" && rc=0 || rc=$?
  case "$rc" in
    0) ;;
    1)
      cleanup_instance_tmp
      refuse "the owning valley $url holds no *.cue in $INSTANCE_DIR/ at $VALLEY_POINTER_REF; nothing derived"
      return 1
      ;;
    *)
      cleanup_instance_tmp
      refuse "could not read $INSTANCE_DIR/ from $url; nothing derived"
      return 1
      ;;
  esac

  POLICY_INSTANCE="$dest"
  POLICY_INSTANCE_LABEL="$url $INSTANCE_DIR@$VALLEY_POINTER_REF"
}

# Is this check mandatory in this class, or a default the project left
# alone? The bit is the form of the composed value, so the test is CUE's
# own: a project supplying `false` either conflicts or unifies cleanly.
# Answering by unifying rather than by inspecting syntax means the script
# cannot disagree with `cue vet`.
#
# This is the one producer whose failure does not end the derivation. A
# probe that fails for any other reason, or that cannot be written, reads as
# mandatory, which is the strict answer, and the bit never changes which
# checks are required.
check_is_mandatory() {
  local class="$1" check="$2" field
  if [ "$class" = unclassified ]; then
    field="policy: unclassified: \"$check\": false"
  else
    field="policy: classes: \"$class\": requires: \"$check\": false"
  fi
  # A probe that could not be written may leave the last one in its place,
  # and that one answers for another check. Mandatory is the strict answer.
  printf 'package verification\n%s\n' "$field" > "$POLICY_TMP/probe.cue" \
    || return 0
  ! cue vet "${POLICY_LAYER[@]}" "$POLICY_TMP/probe.cue" > /dev/null 2>&1
}

# Every side of the diff: an added, modified or deleted path, and both the
# old and the new path of a rename or copy. It reads `git diff -z
# --name-status` on stdin, because a path may contain anything but NUL, and
# fails on a record cut short — including one cut inside its status, which
# a plain `while read` would end on quietly, dropping the record. It also
# fails when a write fails: the caller runs without `errexit`, so a lost
# path would otherwise end in a normal EOF and a status of 0.
diff_paths() {
  local status path
  while IFS= read -r -d '' status || { [ -z "$status" ] || return 1; false; }; do
    IFS= read -r -d '' path || return 1
    printf '%s\n' "$path" || return 1
    case "$status" in
      R* | C*)
        IFS= read -r -d '' path || return 1
        printf '%s\n' "$path" || return 1
        ;;
    esac
  done
}

# Lines in, one comma-separated line out.
join_lines() {
  local out="" line
  while IFS= read -r line; do out="${out:+$out, }$line"; done
  printf '%s' "$out"
}

# Arguments in, one comma-separated line out, or `none` when there are none.
join_or_none() {
  if [ $# -eq 0 ]; then echo none; else printf '%s\n' "$@" | join_lines; fi
}

# The remaining arguments, sorted, into the array the first one names. The
# sort is captured and its status returned: a sort read through a process
# substitution that fails reads as a sort of nothing, and for a list of
# required checks that is a change that requires none.
#
# The destination is a nameref, so what is assigned is the caller's array,
# and the linter cannot see that array being read.
# shellcheck disable=SC2034
sort_into() {
  local -n sort_into_dest="$1"
  local sorted
  shift
  sort_into_dest=()
  [ $# -gt 0 ] || return 0
  sorted="$(printf '%s\n' "$@" | sort)" || return 1
  mapfile -t sort_into_dest <<<"$sorted"
}

# The target: the ref a change is derived against, and the tip both policy
# layers are read out of. origin's answer is preferred, because the target
# is the branch as the integrator holds it and not as this checkout last
# built it.
#
# Only a ref that is not there falls through to the next. show-ref says
# "not there" with 1 and fails any other way with another status, so a
# read of origin's ref that failed ends here: falling through would read
# the policy out of the local main, which may be older. 1 no main at all,
# 2 a read failed.
target_ref() {
  local ref rc
  for ref in refs/remotes/origin/main refs/heads/main; do
    git show-ref --verify --quiet "$ref" && rc=0 || rc=$?
    case "$rc" in
      0) echo "$ref"; return 0 ;;
      1) ;;
      *) return 2 ;;
    esac
  done
  return 1
}

# ----------------------------------------------------------------------
# The derivation itself, and the globals it answers with. Everything a
# caller could want from the policy comes out of one pass, because every
# part of it is a function of the same composition: `checks` prints the
# answer, approve runs what it names.
#
# It reports and returns rather than dying, so that a caller inside the
# review loop is refused rather than ended. Its callers are all in a
# condition, which suspends `set -e` for the whole call, so every step is
# checked by hand.
#
# Every producer — git, cue, sort — writes a file or a variable, and its
# status is checked before anything reads what it wrote. A producer read
# through a process substitution loses its status, and a failed one then
# reads as an empty list: no changed paths, no catalogue, no classes. Each
# of those derives a change that requires nothing, which is the one answer a
# failure must never give.
DERIVED_PATHS=()        # every side of the diff, sorted
DERIVED_MATCHED=()      # the class names at least one path matched, sorted
DERIVED_UNCOVERED=()    # the paths no class covered
DERIVED_UNCLASSIFIED=0  # whether `unclassified` requires something
DERIVED_CARRY=""        # the strictest carry mode among the matched classes
declare -A DERIVED_REQUIRED=() # check -> the classes that required it
declare -A DERIVED_PINNED=()   # check -> mandatory | default
declare -A CHECK_RUNNER=()     # check -> nix | command
declare -A CHECK_ATTRIBUTE=()  # check -> the flake check attribute
declare -A CHECK_COMMAND=()    # check -> the command line
declare -A CHECK_COST=()       # check -> quick | slow

derive_required() {
  local schema="$1" instance="$2" project="$3" base="$4" head="$5"

  need_cue
  [ -f "$schema" ] || {
    refuse "no policy schema at $schema; nothing derived"
    return 1
  }
  # An unmatched glob stays literal, so the first entry is a real file
  # exactly when the directory holds a document.
  local -a instance_docs=("$instance"/*.cue) project_docs=("$project"/*.cue)
  [ -f "${instance_docs[0]}" ] || {
    refuse "no instance policy layer at $instance; nothing derived"
    return 1
  }
  [ -f "${project_docs[0]}" ] || {
    refuse "no project policy layer at $project: a project's own layer is the *.cue documents under $PROJECT_DIR/ (dcr-f41f718). Nothing derived"
    return 1
  }

  cleanup_policy_tmp
  POLICY_LAYER=("$schema" "${instance_docs[@]}" "${project_docs[@]}")
  POLICY_TMP="$(mktemp -d)" || {
    refuse "no scratch directory to compose the policy in; nothing derived"
    return 1
  }

  git diff --no-relative --name-status -M -z "$base" "$head" > "$POLICY_TMP/diff" || {
    refuse "could not diff $base..$head; nothing derived"
    return 1
  }
  diff_paths < "$POLICY_TMP/diff" > "$POLICY_TMP/paths" || {
    refuse "truncated diff output; nothing derived"
    return 1
  }
  sort -u "$POLICY_TMP/paths" > "$POLICY_TMP/paths.sorted" || {
    refuse "could not sort the changed paths; nothing derived"
    return 1
  }
  DERIVED_PATHS=()
  mapfile -t DERIVED_PATHS < "$POLICY_TMP/paths.sorted"

  render_cue > "$POLICY_TMP/render.cue" || {
    refuse "could not write the policy render; nothing derived"
    return 1
  }
  cue vet -c "${POLICY_LAYER[@]}" || {
    refuse "the policy layers do not compose; nothing derived"
    return 1
  }

  # The render is checked before it is read. A render that fails prints
  # nothing, and an empty render reads as a policy that requires nothing. A
  # schema older than this script fails it, by lacking a field it reads. So
  # does a policy string holding a control character, which a schema that
  # admits one lets through.
  cue eval --out text -e _render "${POLICY_LAYER[@]}" "$POLICY_TMP/render.cue" \
    > "$POLICY_TMP/rendered" || {
    refuse "the composed policy does not render (a schema older than this script, and a policy string holding a control character, are two causes); nothing derived"
    return 1
  }
  # Sorted once here, so every list below comes out in a stable order.
  sort "$POLICY_TMP/rendered" > "$POLICY_TMP/rendered.sorted" || {
    refuse "could not sort the composed policy; nothing derived"
    return 1
  }
  local -a rendered=()
  mapfile -t rendered < "$POLICY_TMP/rendered.sorted"

  unset CHECK_RUNNER CHECK_ATTRIBUTE CHECK_COMMAND CHECK_COST DERIVED_REQUIRED \
    DERIVED_PINNED
  declare -gA CHECK_RUNNER=() CHECK_ATTRIBUTE=() CHECK_COMMAND=() \
    CHECK_COST=() DERIVED_REQUIRED=() DERIVED_PINNED=()

  # The middle field is a class name for a coverage or requirement line and
  # a check name for a catalogue one; `key` is what both are.
  #
  # The render states each thing once: a class has one carry mode, a check
  # one runner, and a class requires a check once. A second line for the
  # same thing is forged, and a reader that took the last one would let the
  # forgery win, so it is refused. A coverage or requirement line is one
  # member of a set, so it is identified by its value too.
  local -a pat_class=() pat_ere=() req_class=() req_check=()
  local -A class_carry=() seen=()
  local line kind key value id
  for line in "${rendered[@]}"; do
    kind="${line%%$'\t'*}"
    key="${line#*$'\t'}"
    value="${key#*$'\t'}"
    key="${key%%$'\t'*}"
    case "$kind" in
      path | requires) id="$kind $key $value" ;;
      *) id="$kind $key" ;;
    esac
    [ -z "${seen[$id]:-}" ] || {
      refuse "the composed policy rendered '$id' twice, and states each thing once; nothing derived"
      return 1
    }
    seen["$id"]=1
    case "$kind" in
      path)
        pat_class+=("$key")
        pat_ere+=("$(glob_ere "$value")")
        ;;
      requires)
        req_class+=("$key")
        req_check+=("$value")
        ;;
      carry) class_carry["$key"]="$value" ;;
      runner) CHECK_RUNNER["$key"]="$value" ;;
      attribute) CHECK_ATTRIBUTE["$key"]="$value" ;;
      command) CHECK_COMMAND["$key"]="$value" ;;
      cost) CHECK_COST["$key"]="$value" ;;
    esac
  done

  # A pattern bash cannot compile answers 2, not 1. Read as "no match", it
  # would drop the pattern's class from every change it covers.
  local -A matched=()
  local path i hit rc
  DERIVED_UNCOVERED=()
  for path in "${DERIVED_PATHS[@]}"; do
    hit=0
    for ((i = 0; i < ${#pat_ere[@]}; i++)); do
      [[ "$path" =~ ${pat_ere[i]} ]] && rc=0 || rc=$?
      case "$rc" in
        0)
          matched["${pat_class[i]}"]=1
          hit=1
          ;;
        1) ;;
        *)
          refuse "class ${pat_class[i]} has a path pattern that does not compile (${pat_ere[i]}); nothing derived"
          return 1
          ;;
      esac
    done
    [ "$hit" -eq 1 ] || DERIVED_UNCOVERED+=("$path")
  done

  # The change's carry mode: the strictest among the classes its paths
  # matched, each as the schema resolved it. It is taken before
  # `unclassified` joins the matched classes, because an unclassified path
  # is same-paths and can make no change stricter. A matched class with no
  # mode this script knows is refused rather than read as the loosest.
  local class
  DERIVED_CARRY=same-paths
  for class in "${!matched[@]}"; do
    case "${class_carry[$class]:-}" in
      exact) DERIVED_CARRY=exact ;;
      same-class) [ "$DERIVED_CARRY" = exact ] || DERIVED_CARRY=same-class ;;
      same-paths) ;;
      *)
        refuse "class $class has no carry mode this script knows ('${class_carry[$class]:-}'); nothing derived"
        return 1
        ;;
    esac
  done

  # A path no class covers is answered by the policy's `unclassified` set,
  # which is why it is treated as one more matched class rather than as an
  # absence.
  [ "${#DERIVED_UNCOVERED[@]}" -eq 0 ] || matched[unclassified]=1

  local check
  DERIVED_UNCLASSIFIED=0
  for ((i = 0; i < ${#req_check[@]}; i++)); do
    key="${req_class[i]}"
    check="${req_check[i]}"
    [ -n "${matched[$key]:-}" ] || continue
    [ "$key" != unclassified ] || DERIVED_UNCLASSIFIED=1
    DERIVED_REQUIRED["$check"]="${DERIVED_REQUIRED[$check]:+${DERIVED_REQUIRED[$check]}, }$key"
    if check_is_mandatory "$key" "$check"; then
      DERIVED_PINNED["$check"]=mandatory
    else
      DERIVED_PINNED["$check"]="${DERIVED_PINNED[$check]:-default}"
    fi
  done

  sort_into DERIVED_MATCHED "${!matched[@]}" || {
    refuse "could not sort the matched classes; nothing derived"
    return 1
  }
}

cmd_checks() {
  local root schema instance="" label project="" plabel base head target=""
  local names=0 cost="" costed=0 short_base short_head
  root="$(git rev-parse --show-toplevel 2> /dev/null)" \
    || die "not a git repository"
  policy_defaults "$root"
  schema="$POLICY_SCHEMA"
  while [ $# -gt 0 ]; do
    case "$1" in
      --schema) [ $# -ge 2 ] || die "--schema needs a file"; schema="$2"; shift 2 ;;
      --instance) [ $# -ge 2 ] || die "--instance needs a directory"; instance="$2"; shift 2 ;;
      --project) [ $# -ge 2 ] || die "--project needs a directory"; project="$2"; shift 2 ;;
      --names) names=1; shift ;;
      --cost) [ $# -ge 2 ] || die "--cost needs quick or slow"; cost="$2"; costed=1; shift 2 ;;
      --) shift; break ;;
      -*) die "unknown option: $1" ;;
      *) break ;;
    esac
  done
  [ $# -le 2 ] || die "usage: valley checks [options] [<base> [<head>]]"
  if [ "$costed" -eq 1 ]; then
    case "$cost" in
      quick | slow) ;;
      *) die "--cost takes quick or slow, not '$cost'" ;;
    esac
    [ "$names" -eq 1 ] || die "--cost filters the --names list; pass --names too"
  fi

  head="$(git rev-parse --verify --quiet "${2:-HEAD}^{commit}")" \
    || die "no such commit: ${2:-HEAD}"
  # The target is what the layers are read out of, so it is needed whenever
  # either layer is left to its default — and it is what an unnamed base
  # is the merge base with.
  if [ -z "$instance" ] || [ -z "$project" ] || [ $# -lt 1 ]; then
    target="$(target_ref)" || {
      [ $? -eq 1 ] || die "could not read the main branch; nothing derived"
      die "no main branch: the target's tip is where the policy layers are read from, and there is none here"
    }
  fi
  if [ $# -ge 1 ]; then
    base="$(git rev-parse --verify --quiet "$1^{commit}")" \
      || die "no such commit: $1"
  else
    base="$(git merge-base "$target" "$head")" \
      || die "$head and ${target#refs/} do not share history — name a base"
  fi

  trap 'cleanup_policy_tmp; cleanup_instance_tmp; cleanup_project_tmp' EXIT
  # Each layer is resolved only when nobody named one. --instance and
  # --project are a reader pointing this at a layer on purpose, and
  # honouring that means not fetching the repository, and not reading the
  # tip, that the named layer replaced.
  if [ -n "$instance" ]; then
    label="${instance#"$root"/}"
  else
    resolve_instance_layer "$root" "$target" || exit 1
    instance="$POLICY_INSTANCE"
    label="$POLICY_INSTANCE_LABEL"
  fi
  if [ -n "$project" ]; then
    plabel="${project#"$root"/}"
  else
    resolve_project_layer "$root" "$target" || exit 1
    project="$POLICY_PROJECT"
    plabel="$POLICY_PROJECT_LABEL"
  fi
  derive_required "$schema" "$instance" "$project" "$base" "$head" || exit 1

  # The required checks, sorted, and grouped by the cost the policy
  # declares. The grouping changes nothing required: approve runs every
  # required check, and the integrator requires evidence for every one,
  # whatever it costs.
  local check width=0
  local -a required=() quick=() slow=() listed=()
  sort_into required "${!DERIVED_REQUIRED[@]}" \
    || die "could not sort the required checks; nothing derived"
  for check in "${required[@]}"; do
    [ "${#check}" -le "$width" ] || width="${#check}"
    if [ "${CHECK_COST[$check]}" = slow ]; then
      slow+=("$check")
    else
      quick+=("$check")
    fi
  done

  # The form for agents and scripts: the names alone, one per line.
  if [ "$names" -eq 1 ]; then
    case "$cost" in
      quick) listed=("${quick[@]}") ;;
      slow) listed=("${slow[@]}") ;;
      *) listed=("${required[@]}") ;;
    esac
    [ "${#listed[@]}" -eq 0 ] || printf '%s\n' "${listed[@]}"
    return
  fi

  # Read before the first line is printed, so a read that fails leaves no
  # partial report behind.
  short_base="$(git rev-parse --short "$base")" \
    || die "could not read $base; nothing derived"
  short_head="$(git rev-parse --short "$head")" \
    || die "could not read $head; nothing derived"

  printf '%s..%s: %d changed path(s)\n' "$short_base" "$short_head" \
    "${#DERIVED_PATHS[@]}"
  printf 'policy: %s + %s\n' "$label" "$plabel"
  if [ "${#DERIVED_MATCHED[@]}" -eq 0 ]; then
    printf 'classes matched: none\n'
  else
    printf 'classes matched: %s\n' \
      "$(printf '%s\n' "${DERIVED_MATCHED[@]}" | join_lines)"
  fi
  # How far an approval of this change carries across a rebase. Nothing
  # here acts on it.
  printf 'carry mode: %s\n\n' "$DERIVED_CARRY"

  if [ "${#DERIVED_REQUIRED[@]}" -eq 0 ]; then
    echo "required checks: none"
  else
    echo "required checks:"
    for check in "${required[@]}"; do
      printf '  %-*s  %-9s  %s\n' \
        "$width" "$check" "${DERIVED_PINNED[$check]}" "${DERIVED_REQUIRED[$check]}"
    done
  fi

  if [ "${#DERIVED_UNCOVERED[@]}" -gt 0 ]; then
    printf '\nunclassified: %d path(s) matched no class\n' "${#DERIVED_UNCOVERED[@]}"
    printf '  %s\n' "${DERIVED_UNCOVERED[@]}"
    # The failure the `unclassified` field exists to prevent: paths outside
    # every class that the policy then asks nothing of.
    [ "$DERIVED_UNCLASSIFIED" -eq 1 ] \
      || echo "  the policy requires nothing of them — it is behind the tree"
  fi

  # Below every line the integrator reads (integrator/policy.go), and
  # unindented, so neither line can read as a required check.
  if [ "${#required[@]}" -gt 0 ]; then
    printf '\nquick: %s\n' "$(join_or_none "${quick[@]}")"
    printf 'slow: %s\n' "$(join_or_none "${slow[@]}")"
  fi
}

# self-update installs the tip of a branch of the-valley into the user's
# nix profile (status/selfupdate.go). It is told this valley's stamp, which
# says what is installed until it has installed something itself.
cmd_self_update() {
  export VALLEY_VERSION="$VALLEY_STAMP"
  cmd_go self-update "$@"
}

cmd_version() {
  printf 'valley %s\n' "${VALLEY_STAMP:-unstamped (run from a checkout, not built by nix)}"
}

cmd_help() {
  case "${1:-}" in
    self-update) cmd_go self-update --help ;;
    *) usage ;;
  esac
}

main() {
  local verb="${1:-help}"
  if [ $# -gt 0 ]; then shift; fi
  # The verb set is mirrored in completions/ (valley.bash, _valley) —
  # update both when it changes.
  case "$verb" in
    pending) cmd_pending "$@" ;;
    review) cmd_review "$@" ;;
    approve) cmd_approve "$@" ;;
    rebase) cmd_rebase "$@" ;;
    status | ready | unready | withdraw | changes | knot | plan) cmd_go "$verb" "$@" ;;
    checks) cmd_checks "$@" ;;
    tail) cmd_tail "$@" ;;
    replay) cmd_replay "$@" ;;
    self-update) cmd_self_update "$@" ;;
    --version) cmd_version ;;
    help | -h | --help) cmd_help "$@" ;;
    *)
      printf 'valley: unknown verb: %s\n\n' "$verb" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
