help_telemetry() {
  cat <<'EOF'
usage: valley telemetry [--remote <remote>] [--json] <operation> [flags]

  sources                 every source the host declares, and its state:
                          disabled, unavailable, failed, stale, active or
                          idle, with its units, its records and how far its
                          journal reaches
  snapshot                sources, with each producer's exported state and
                          its open and latest runs
  read [--source <name>] [--since <cursor>] [--limit <n>] [--logs]
                          records after the cursor (default: the newest
                          --limit, 200, at most 1000); a source's systemd
                          lifecycle from the journal; with --logs, its own
                          output and the tail of its build logs, marked
                          untrusted
  follow [--source <name>] [--since <cursor>] [--seconds <n>] [--logs]
                          records as they are stored, and with --logs build
                          output as it is written, for --seconds (default
                          60, at most 300); ends with a cursor to resume from
  flush                   send this workstation's spooled records now

Reading needs a key whose principal holds the host's observe grant. The
remote is the checkout's valley.telemetry.remote, else origin, or the one
--remote names (a remote, an ssh URL, or user@host:path); its URL is read
and never run. --json prints the valley-telemetry/v1 answer lines as they
come. A gap, a cut-short answer or an error is said; an answer that does
not end exits 1.

With `git config valley.telemetry true`, every valley command records a
command record: its verb (and knot's or telemetry's subverb), the names of
the flags it was given, its project, its exit status and its wall time,
and for pending and status the milliseconds and processes each phase took.
It never records an argument's value, a path, a title or a body. Every
approval attempt, from approve or from review, also records its steps and
its checks' progress. Records go to an owner-only spool for the
destination the checkout's telemetry remote names, under
$XDG_STATE_HOME/valley/telemetry/spools. A background flusher sends each
spool to its own destination, with the report grant; flush does the same
now, and --remote limits it to that remote's spool. Telemetry never fails
or holds up a command, and changes nothing it prints.
EOF
}

help_self_update() {
  if command -v valley-go > /dev/null 2>&1; then
    valley-go self-update --help
    printf '\n'
  else
    cat <<'EOF'
usage: valley self-update [-v] [--retry | --rollback | --pin | --unpin]
                          [--repo <url>] [--branch <name>]

EOF
  fi
  cat <<'EOF'
  self-update [-v] [--retry | --rollback | --pin | --unpin]
              [--repo <url>] [--branch <name>]
                   install the tip of a branch of the-valley into your
                   default nix profile, in place of its valley element,
                   once that exact commit builds and passes a smoke test.
                   a commit that fails is skipped until the branch moves,
                   or until --retry. it is off until --repo or
                   git config valley.selfUpdate.repo names the
                   repository; the branch is valley.selfUpdate.branch,
                   or main. --rollback reinstalls the previous build, and
                   --pin and --unpin freeze and release the install.
                   `valley-go self-update --help` gives every step. needs
                   the valley-go helper and nix.

  --version        print this valley's version: the package's version and
                   the commit it was built from, e.g. 0.1.0-97db597, with
                   -dirty after it for a tree with uncommitted changes and
                   -unknown in its place when nix knew no commit. run
                   straight from a checkout, it says it is unstamped.
EOF
  help_runtime
}

fetch_origin() {
  git fetch --prune --quiet origin
}

# pending is valley-go's (status/pending.go). The fetch first keeps this
# checkout's remote-tracking branches current, as pending always has.
cmd_pending() {
  command -v valley-go > /dev/null 2>&1 \
    || die "pending needs the valley-go helper; nix run .#valley bundles it"
  fetch_origin
  VALLEY_TELEMETRY_SINCE="$TEL_T0" VALLEY_TELEMETRY_VERSION="$VALLEY_STAMP" \
    exec valley-go pending "$@"
}

# tel_command <status>: the command record of a verb this script runs
# itself, handed to valley-go as the script exits, once. valley-go decides
# whether telemetry is on; the verbs this script execs it for it records
# itself.
TEL_ARGS=()
tel_command() {
  [ ${#TEL_ARGS[@]} -gt 0 ] || return 0
  local -a args=("${TEL_ARGS[@]}")
  TEL_ARGS=()
  valley-go telemetry command --since "$TEL_T0" --version "$VALLEY_STAMP" --status "$1" \
    -- "${args[@]}" < /dev/null > /dev/null 2>&1 || true
}

# status, ready, unready and withdraw are a Go program, valley-go
# (status/). status reads a change's request and outcome from origin,
# because what front ends read from it is a JSON contract, and because the
# read is subtle enough to want a real parser: an outcome record it does
# not recognise must read as unknown, never as success. It writes nothing
# and moves no local branch. ready, unready and withdraw write a change's
# record, in the one format the push hook reads it in (change/). knot
# reads and writes the plan graph at refs/the-valley/knots, in the one
# form the push hook validates (knot/), and plan shows that graph as a
# view.
cmd_go() {
  command -v valley-go > /dev/null 2>&1 \
    || die "$1 needs the valley-go helper; nix run .#valley bundles it"
  VALLEY_TELEMETRY_SINCE="$TEL_T0" VALLEY_TELEMETRY_VERSION="$VALLEY_STAMP" exec valley-go "$@"
}

# review is valley-go's (status/review.go). With no change it walks what
# needs the operator, reviewing each change in the same process
# (status/walk.go).
cmd_review() {
  command -v valley-go > /dev/null 2>&1 \
    || die "review needs the valley-go helper; nix run .#valley bundles it"
  VALLEY_TELEMETRY_SINCE="$TEL_T0" VALLEY_TELEMETRY_VERSION="$VALLEY_STAMP" \
    exec valley-go review "$@"
}

# approve is review's [a]pprove without the pager, for a front end that
# has shown the change its own way: valley-go approve (status/approve.go),
# the code the key runs, so the verb and the key cannot drift apart. It
# resolves the change before the fetch, as review does.
cmd_approve() {
  command -v valley-go > /dev/null 2>&1 \
    || die "approve needs the valley-go helper; nix run .#valley bundles it"
  VALLEY_TELEMETRY_SINCE="$TEL_T0" VALLEY_TELEMETRY_VERSION="$VALLEY_STAMP" \
    exec valley-go approve "$@"
}

# rebase is review's [b]ase onto main without the pager. It runs the code
# its key runs, valley-go rebase, and reads a change's name as review
# reads it. The two flags that say what a transfer
# statement is verified with are valley-go's, and pass through to it
# untouched.
cmd_rebase() {
  local usage="usage: valley rebase [--known-signers <file>] [--integrator-name <name>] <change>"
  local name="" verify=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --known-signers | --integrator-name)
        [ $# -ge 2 ] || die "$usage"
        verify+=("$1" "$2")
        shift 2
        ;;
      --known-signers=* | --integrator-name=*)
        verify+=("$1")
        shift
        ;;
      -*) die "$usage" ;;
      *)
        [ -z "$name" ] || die "$usage"
        name="$1"
        shift
        ;;
    esac
  done
  [ -n "$name" ] || die "$usage"
  command -v valley-go > /dev/null 2>&1 \
    || die "review, approve and rebase read the change's record with the valley-go helper; nix run .#valley bundles it"
  fetch_origin
  VALLEY_TELEMETRY_SINCE="$TEL_T0" VALLEY_TELEMETRY_VERSION="$VALLEY_STAMP" \
    exec valley-go rebase "${verify[@]}" "$name"
}

# tail and replay are thin wrappers over the nats CLI — anything they do,
# plain nats and git can do. They are the only verbs needing more than git
# and coreutils.
need_nats() {
  command -v nats >/dev/null 2>&1 \
    || die "this verb needs the nats CLI (natscli); nix run .#valley bundles it"
}

cmd_tail() {
  [ $# -le 1 ] || die "usage: valley tail [subject]"
  need_nats
  exec nats sub "${1:-valley.>}"
}

# One ref-updated event per existing ref, from git for-each-ref alone. A
# ref's prior value is not derivable from the repository, so `old` is the
# all-zero id — the same payload a push creating the ref would produce.
# The payload construction mirrors the host module's publisher hook
# (nix/valley-host.nix); change one only with the other.
cmd_replay() {
  [ $# -le 1 ] || die "usage: valley replay [repo-dir]"
  need_nats
  local dir="${1:-.}" repo sha ref event count=0
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 \
    || die "not a git repository: $dir"
  if [ "$(git -C "$dir" rev-parse --is-bare-repository)" = true ]; then
    repo="$(basename "$(git -C "$dir" rev-parse --absolute-git-dir)" .git)"
  else
    repo="$(basename "$(git -C "$dir" rev-parse --show-toplevel)")"
  fi
  while read -r sha ref; do
    # " is the only JSON-significant character a refname can contain (git
    # forbids \ and control characters); names and object ids are safe.
    event="$(printf '{"event":"ref-updated","repo":"%s","ref":"%s","old":"%s","new":"%s"}' \
      "$repo" "${ref//\"/\\\"}" "${sha//?/0}" "$sha")"
    nats pub "valley.git.$repo.ref-updated" "$event" >/dev/null
    count=$((count + 1))
  done < <(git -C "$dir" for-each-ref --format='%(objectname) %(refname)')
  echo "replayed $count refs of $repo onto the bus"
}

# ----------------------------------------------------------------------
# checks — the checks the verification policy requires of a change, and
# the classes requiring each. The verb is valley-go's (status/checks.go):
# it reads the policy's layers and derives with the Go deriver (derive/).
cmd_checks() {
  command -v valley-go > /dev/null 2>&1 \
    || die "checks needs the valley-go helper; nix run .#valley bundles it"
  VALLEY_TELEMETRY_SINCE="$TEL_T0" VALLEY_TELEMETRY_VERSION="$VALLEY_STAMP" \
    exec valley-go checks "$@"
}

# self-update installs the tip of a branch of the-valley into the user's
# nix profile (status/selfupdate.go). It is told this valley's stamp, which
# says what is installed until it has installed something itself.
cmd_self_update() {
  export VALLEY_VERSION="$VALLEY_STAMP"
  cmd_go self-update "$@"
}

cmd_version() {
  printf 'valley %s\n' "${VALLEY_STAMP:-unstamped (run from a checkout, not built by nix)}"
}

cmd_help() {
  [ $# -le 1 ] || die "usage: valley help [<verb>]"
  local out
  case "${1:-}" in
    '' | help | -h | --help) out="$(usage)" ;;
    pending) out="$(help_pending)" ;;
    changes) out="$(help_changes)" ;;
    review) out="$(help_review)" ;;
    approve) out="$(help_approve)" ;;
    rebase) out="$(help_rebase)" ;;
    status) out="$(help_status)" ;;
    ready) out="$(help_ready)" ;;
    unready) out="$(help_unready)" ;;
    withdraw) out="$(help_withdraw)" ;;
    knot) out="$(help_knot)" ;;
    plan) out="$(help_plan)" ;;
    checks) out="$(help_checks)" ;;
    tail) out="$(help_tail)" ;;
    replay) out="$(help_replay)" ;;
    self-update) out="$(help_self_update)" ;;
    telemetry) out="$(help_telemetry)" ;;
    *) die "unknown help topic: $1 (try 'valley help')" ;;
  esac
  printf '%s\n' "$out" 2> /dev/null || true
}

main() {
  local verb="${1:-help}"
  if [ $# -gt 0 ]; then shift; fi
  # The verb set is mirrored in completions/ (valley.bash, _valley) —
  # update both when it changes.
  case "$verb" in
    pending | changes | review | approve | rebase | status | ready | unready | withdraw | knot | plan | checks | tail | replay | self-update | telemetry)
      if [ $# -eq 1 ] && { [ "$1" = -h ] || [ "$1" = --help ]; }; then
        cmd_help "$verb"
        return
      fi
      ;;
  esac
  case "$verb" in
    checks | tail | replay)
      TEL_ARGS=("$verb" "$@")
      trap 'tel_command $?' EXIT
      ;;
  esac
  case "$verb" in
    pending) cmd_pending "$@" ;;
    review) cmd_review "$@" ;;
    approve) cmd_approve "$@" ;;
    rebase) cmd_rebase "$@" ;;
    status | ready | unready | withdraw | changes | knot | plan) cmd_go "$verb" "$@" ;;
    checks) cmd_checks "$@" ;;
    tail) cmd_tail "$@" ;;
    replay) cmd_replay "$@" ;;
    self-update) cmd_self_update "$@" ;;
    telemetry) cmd_go telemetry "$@" ;;
    --version) cmd_version ;;
    help | -h | --help) cmd_help "$@" ;;
    *)
      printf 'valley: unknown verb: %s\n\n' "$verb" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
