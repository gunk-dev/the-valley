help_telemetry() {
  cat <<'EOF'
usage: valley telemetry [--remote <remote>] [--json] <operation> [flags]

  sources                 every source the host declares, and its state:
                          disabled, unavailable, failed, stale, active or
                          idle, with its units, its records and how far its
                          journal reaches
  snapshot                sources, with each producer's exported state and
                          its open and latest runs
  read [--source <name>] [--since <cursor>] [--limit <n>] [--logs]
                          records after the cursor (default: the newest
                          --limit, 200, at most 1000); a source's systemd
                          lifecycle from the journal; with --logs, its own
                          output and the tail of its build logs, marked
                          untrusted
  follow [--source <name>] [--since <cursor>] [--seconds <n>] [--logs]
                          records as they are stored, and with --logs build
                          output as it is written, for --seconds (default
                          60, at most 300); ends with a cursor to resume from
  flush                   send this workstation's spooled records now

Reading needs a key whose principal holds the host's observe grant. The
remote is the checkout's valley.telemetry.remote, else origin, or the one
--remote names (a remote, an ssh URL, or user@host:path); its URL is read
and never run. --json prints the valley-telemetry/v1 answer lines as they
come. A gap, a cut-short answer or an error is said; an answer that does
not end exits 1.

With `git config valley.telemetry true`, every valley command records a
command record: its verb (and knot's or telemetry's subverb), the names of
the flags it was given, its project, its exit status and its wall time,
and for pending and status the milliseconds and processes each phase took.
It never records an argument's value, a path, a title or a body. Every
approval attempt, from approve or from review, also records its steps and
its checks' progress. Records go to an owner-only spool for the
destination the checkout's telemetry remote names, under
$XDG_STATE_HOME/valley/telemetry/spools. A background flusher sends each
spool to its own destination, with the report grant; flush does the same
now, and --remote limits it to that remote's spool. Telemetry never fails
or holds up a command, and changes nothing it prints.
EOF
}

help_self_update() {
  if command -v valley-go > /dev/null 2>&1; then
    valley-go self-update --help
    printf '\n'
  else
    cat <<'EOF'
usage: valley self-update [-v] [--retry | --rollback | --pin | --unpin]
                          [--repo <url>] [--branch <name>]

EOF
  fi
  cat <<'EOF'
  self-update [-v] [--retry | --rollback | --pin | --unpin]
              [--repo <url>] [--branch <name>]
                   install the tip of a branch of the-valley into your
                   default nix profile, in place of its valley element,
                   once that exact commit builds and passes a smoke test.
                   a commit that fails is skipped until the branch moves,
                   or until --retry. it is off until --repo or
                   git config valley.selfUpdate.repo names the
                   repository; the branch is valley.selfUpdate.branch,
                   or main. --rollback reinstalls the previous build, and
                   --pin and --unpin freeze and release the install.
                   `valley-go self-update --help` gives every step. needs
                   the valley-go helper and nix.

  --version        print this valley's version: the package's version and
                   the commit it was built from, e.g. 0.1.0-97db597, with
                   -dirty after it for a tree with uncommitted changes and
                   -unknown in its place when nix knew no commit. run
                   straight from a checkout, it says it is unstamped.
EOF
  help_runtime
}

fetch_origin() {
  git fetch --prune --quiet origin
}

# ref_oid <ref>: the object ID that ref, a full ref name, holds here, read
# by that exact name with show-ref. 1 no such ref, 2 a read that failed.
#
# git rev-parse, and every git command given a ref name, does not stop at
# the name it is given. For a missing refs/remotes/origin/main it goes on
# to try other names, refs/tags/refs/remotes/origin/main and
# refs/heads/refs/remotes/origin/main among them, and a fetch can bring the
# first from origin. So a ref is read here once, and what it held is read
# through the object ID from then on.
ref_oid() {
  local rc
  git show-ref --exists --end-of-options "$1" 2> /dev/null && rc=0 || rc=$?
  case "$rc" in
    0) git show-ref --verify --hash --end-of-options "$1" || return 2 ;;
    2) return 1 ;;
    *) return 2 ;;
  esac
}

# Resolve the pager as git would for a diff: pager.diff first (per-command
# pager configs — e.g. home-manager's delta module — set pager.diff and leave
# core.pager alone), then git var GIT_PAGER (core.pager, GIT_PAGER, PAGER,
# less). pager.<cmd> may legally be a boolean; treat true/false — and an
# empty or missing value — as unset and fall back. The value is
# shell-interpreted, hence sh -c.
diff_pager() {
  local pager
  pager="$(git config --get pager.diff || true)"
  case "$pager" in '' | true | false) pager="$(git var GIT_PAGER)" ;; esac
  printf '%s' "$pager"
}

# Page a file rather than a pipe, so less's v key has something to hand
# $EDITOR. That file is the review buffer, and editing it is how notes get
# written (see collect_notes). A pipe has no name, so less refuses to edit
# one.
#
# The configured diff pager stays the renderer, run once as a filter into a
# sibling file that less pages. v runs LESSEDIT, which opens the editor on
# the raw buffer, not the rendering, and renders it again when the editor
# exits, so the view less reopens shows the notes in place. The editor is
# the one less's %E names: VISUAL, then EDITOR, then vi, each a shell
# command line. Paths reach LESSEDIT through the environment, since it is a
# prompt string in which % ? . : and \ are special.
#
# What this costs is the line number. v opens the editor at +%lm, a line
# of the rendered view, so a filter that restructures the diff — delta's
# default rendering does — opens it near the cursor rather than on it. A
# structure-preserving filter (pager.diff = `delta --color-only`) makes it
# exact. No anchor depends on it: a note is anchored by where it was
# inserted, not by where the editor opened.
#
# valley-go style (status/style.go) is the rendering's last step, after
# the pager, so the pager never reads its escapes and the raw buffer has
# none. It keeps every line in its place.
page_file() {
  local file="$1" shown="${1%.diff}.shown" pager view=less
  [ -t 1 ] || { cat -- "$file"; return; } # a non-tty just cats
  pager="$(diff_pager)"
  case "${pager%%[[:space:]]*}" in
    less | */less)
      # Already less, with its options: the rendering is style's alone, and
      # without it there is no filter to run, so less is given the file.
      command -v valley-go > /dev/null 2>&1 || { sh -c "$pager \"\$1\"" sh "$file"; return; }
      view="$pager" pager='cat'
      ;;
  esac
  # Without less there is no editor key; fall back to filtering into a pipe.
  command -v less > /dev/null 2>&1 || {
    sh -c "$pager" < "$file"
    return
  }
  ! command -v valley-go > /dev/null 2>&1 || pager="$pager | valley-go style --paged"
  sh -c "$pager" < "$file" > "$shown"
  # -R because the filter's color is the whole point of running it. No
  # LESSOPEN, since the filter has run and less answers v on a file read
  # through one with a warning, then runs the editor on whatever key comes
  # next, q included; and so no LESSCLOSE.
  # shellcheck disable=SC2016 # expanded by the shells LESSEDIT starts
  VALLEY_PAGE_RAW="$file" VALLEY_PAGE_SHOWN="$shown" VALLEY_PAGE_RENDER="$pager" \
    VALLEY_PAGE_EDIT='eval "${VISUAL:-${EDITOR:-vi}} \"\$@\" \"\$VALLEY_PAGE_RAW\""
      sh -c "$VALLEY_PAGE_RENDER" < "$VALLEY_PAGE_RAW" > "$VALLEY_PAGE_SHOWN"' \
    LESSEDIT='sh -c "$VALLEY_PAGE_EDIT" sh ?lm+%lm.' \
    env -u LESSOPEN -u LESSCLOSE sh -c "$view -R -- \"\$1\"" sh "$shown"
}

# pending is valley-go's (status/pending.go). The fetch first keeps this
# checkout's remote-tracking branches current, as pending always has.
cmd_pending() {
  command -v valley-go > /dev/null 2>&1 \
    || die "pending needs the valley-go helper; nix run .#valley bundles it"
  fetch_origin
  VALLEY_TELEMETRY_SINCE="$TEL_T0" VALLEY_TELEMETRY_VERSION="$VALLEY_STAMP" \
    exec valley-go pending "$@"
}

# For a change with a record, what is rejected is the head its record
# names. So the branch is deleted only while its tip is that head, and the
# delete is leased on it. When the tip is another commit, reject refuses
# and names both, and deletes nothing. A branch no record names is deleted
# as before.
#
# reject runs inside a condition, where bash suspends `set -e`, so the push
# is checked by hand.
reject() {
  local branch="$1" answer
  local -a lease=()
  if [ -n "$CHANGE_HEAD" ]; then
    check_recorded_tip "$branch" "nothing deleted" || {
      WALK_REFUSED=yes
      return 1
    }
    lease=("--force-with-lease=refs/heads/$branch:$CHANGE_HEAD")
  fi
  printf 'really delete origin/%s? [y/N] ' "$branch"
  read -r answer || answer=""
  case "$answer" in
    y | Y | yes)
      # The change may have moved while the confirmation waited: say so,
      # and delete nothing.
      ! moved || return 0
      if ! git push --quiet "${lease[@]}" origin --delete "$branch"; then
        refuse "origin did not delete $branch, which may have moved since the fetch; nothing deleted"
        WALK_REFUSED=yes
        return 1
      fi
      echo "rejected $branch: deleted from origin"
      walk_outcome rejected "$branch"
      ;;
    *)
      echo "kept $branch"
      walk_outcome kept "$branch"
      ;;
  esac
}

# ----------------------------------------------------------------------
# review notes — the lines the reviewer inserts into the paged diff.
#
# The buffer the reviewer pages is a file, so the pager's editor key can open
# it (page_file). Whatever comes back with lines inserted is read as notes:
# no marker, no syntax, no mode — an inserted line is a note because it was
# not there before. What a note is *about* is where it sits, so each one is
# anchored to the file and the new-side line number of the diff line above
# it, which is the pair a reviewer would otherwise have to copy out by hand.

# The scratch directory holding the buffer and its pristine copy, and the
# notes taken so far in this review — a global because [b]ase onto main
# pages a second time and the notes from the first pass are not thereby
# withdrawn.
REVIEW_TMP=""
NOTES=()

cleanup_review_tmp() {
  [ -n "$REVIEW_TMP" ] || return 0
  rm -rf "$REVIEW_TMP"
  REVIEW_TMP=""
}

# Where a branch's notes live. XDG_STATE_HOME is the right home for them:
# they are neither config nor cache, and losing them loses judgment.
notes_file() {
  printf '%s/valley/notes/%s.md\n' "${XDG_STATE_HOME:-$HOME/.local/state}" "$1"
}

# The anchor of every line of the buffer, by line: the file that line belongs
# to, and the new-side line number it sits on. Built in one pass so that
# anchoring a note is a lookup. An empty path means the line is above every
# file (the log); line 0 means the line is a file header, above every hunk.
ANCHOR_PATH=()
ANCHOR_LINE=()

anchor_buffer() {
  local file="$1" line path="" at=0 next=0 inhunk=0 rest
  ANCHOR_PATH=()
  ANCHOR_LINE=()
  while IFS= read -r line; do
    # Header lines are only headers outside a hunk: inside one, every line
    # carries a +/-/space prefix, so a diff of a diff cannot be misread.
    if [ "$inhunk" -eq 1 ]; then
      case "$line" in
        ' '* | '+'* | '')
          at="$next" # this line's own new-side number
          next=$((next + 1))
          ;;
        '-'* | \\*) ;; # a removal or the no-newline marker: no new-side line
        *) inhunk=0 ;;
      esac
    fi
    if [ "$inhunk" -eq 0 ]; then
      case "$line" in
        'diff --git '*)
          path=""
          # The b/ side, so a rename anchors to the name it will have.
          if [[ "$line" =~ ^diff\ --git\ a/(.*)\ b/(.*)$ ]]; then
            path="${BASH_REMATCH[2]}"
          fi
          at=0
          ;;
        '@@ '*)
          rest="${line#*+}" # -12,7 +34,9 @@ -> 34,9 @@
          at="${rest%%[!0-9]*}"
          [ -n "$at" ] || at=0
          next="$at"
          inhunk=1
          ;;
      esac
    fi
    ANCHOR_PATH+=("$path")
    ANCHOR_LINE+=("$at")
  done < "$file"
}

# The anchor for a note inserted after buffer line n, as it is written down.
anchor_of() {
  local n="$1" path line
  [ "$n" -ge 1 ] || { printf '(unanchored)'; return; }
  path="${ANCHOR_PATH[n - 1]:-}"
  line="${ANCHOR_LINE[n - 1]:-0}"
  if [ -z "$path" ]; then
    printf '(unanchored)'
  elif [ "$line" -eq 0 ]; then
    printf '%s' "$path"
  else
    printf '%s:%s' "$path" "$line"
  fi
}

# The notes in an edited buffer, one `anchor: text` line each. git says where
# the reviewer's lines landed; a hunk that removes nothing is an insertion,
# and the line it was inserted after is the anchor. A hunk that removes
# something is an edit of the diff itself — it anchors to nothing, since the
# line it would name is the line it changed — so it is dropped with a count.
notes_in() {
  local orig="$1" edited="$2" line rest at old insert=0 touched=0 text
  anchor_buffer "$orig"
  while IFS= read -r line; do
    case "$line" in
      '@@ '*)
        rest="${line#@@ -}" # 12,0 +13,2 @@ -> 12,0 +13,2 @@
        at="${rest%%[!0-9]*}"
        rest="${rest#"$at"}"
        old=1
        case "$rest" in
          ,*)
            rest="${rest#,}"
            old="${rest%%[!0-9]*}"
            ;;
        esac
        if [ "$old" -eq 0 ]; then
          insert=1
        else
          insert=0
          touched=$((touched + old))
        fi
        ;;
      '+'*)
        # Only inside an insertion hunk: the +++ of git's own header is not
        # a note, and neither is the new side of an edit.
        [ "$insert" -eq 1 ] || continue
        text="${line#+}"
        text="${text#"${text%%[![:space:]]*}"}"
        [ -n "$text" ] || continue # a blank line says nothing
        printf '%s: %s\n' "$(anchor_of "$at")" "$text"
        ;;
    esac
  done < <(git --no-pager diff --no-ext-diff --no-index -U0 -- "$orig" "$edited")
  [ "$touched" -eq 0 ] || printf \
    'valley: warning: %d changed or deleted diff line(s) ignored — a note is a line you insert\n' \
    "$touched" >&2
}

# Read the notes out of the paged buffer and keep them: appended to the
# branch's notes file under the commit they were taken against, and held for
# the print that follows the verdict. A notes file that cannot be written is
# a warning, never a failure — the notes are still printed, and a review is
# not undone by a missing directory.
collect_notes() {
  local branch="$1" sha="$2" file dir
  local -a found=()
  mapfile -t found < <(notes_in "$REVIEW_TMP/review.orig" "$REVIEW_TMP/review.diff")
  [ "${#found[@]}" -gt 0 ] || return 0
  NOTES+=("${found[@]}")
  file="$(notes_file "$branch")"
  dir="${file%/*}"
  mkdir -p "$dir" 2> /dev/null && {
    printf '## %s at %s\n\n' "$branch" "$sha"
    printf '%s\n' "${found[@]}"
    printf '\n'
  } >> "$file" 2> /dev/null && return 0
  printf 'valley: warning: could not write %s — the notes are printed only\n' \
    "$file" >&2
}

print_notes() {
  local branch="$1"
  [ "${#NOTES[@]}" -gt 0 ] || return 0
  printf '\n%d note(s) on %s, appended to %s:\n' \
    "${#NOTES[@]}" "$branch" "$(notes_file "$branch")"
  printf '  %s\n' "${NOTES[@]}"
}

# ----------------------------------------------------------------------
# review sets the version it shows of a change against the change's
# approved version: the greatest version below it whose head a request or
# an outcome on origin names (valley-go compare, status/compare.go). The
# logic is valley-go's, and this script prints what it says:
#
#   - none: there is no approved version to compare with, so review pages
#     the whole diff, as for any change. Any note valley-go gives, such as
#     an approved version it could not compare, heads the page.
#   - clean: the file delta is the approved version's. review prints that
#     in a few lines, with the landings between the two bases, and pages
#     nothing.
#   - changed: review pages the files whose change differs, with the
#     landings that edited them, the range-diff when a commit was edited,
#     and the shown version's diff of those files. range-diff's hunks
#     carry no line numbers, so a note taken beside them is unanchored.
#     That last diff is in git's ordinary form, so a note taken there
#     keeps its file and line (anchor_buffer).
#
# A changed commit message or author is in valley-go's text either way.
# [v]iew full diff pages the whole diff at every prompt. The comparison
# files no request and skips no check: [a]pprove is the same act whatever
# it says.
#
# compare_shown <change ID> <version> <head>: compare the version shown,
# against main's tip as the fetch left it. Leaves none, clean or changed
# in COMPARE_KIND, and the text to show in $REVIEW_TMP/compare. A plain
# branch is none, and so is a comparison valley-go could not make, with a
# warning.
COMPARE_KIND=none
compare_shown() {
  local out="$REVIEW_TMP/compare.out" tip
  COMPARE_KIND=none
  : > "$REVIEW_TMP/compare"
  [ -n "$1" ] || return 0
  if ! tip="$(ref_oid refs/remotes/origin/main)" \
    || ! valley-go compare ${VERBOSE:+-v} --tip "$tip" "$1" "$2" "$3" > "$out"; then
    printf 'valley: warning: could not compare v%s of change %s with its approved version; reviewing it in full\n' \
      "$2" "$1" >&2
    return 0
  fi
  IFS= read -r COMPARE_KIND < "$out" || COMPARE_KIND=""
  case "$COMPARE_KIND" in
    none | clean | changed) tail -n +2 "$out" > "$REVIEW_TMP/compare" ;;
    *)
      printf 'valley: warning: valley-go compare answered %s, which this script does not read; reviewing it in full\n' \
        "$COMPARE_KIND" >&2
      COMPARE_KIND=none
      ;;
  esac
}

# show_compared <notes key> <head> <heading> <knots> <writer> [<arg>…]:
# show what compare_shown found, under the heading when there is one. A
# clean restack is printed, and nothing is paged. A changed version pages
# the comparison. Otherwise the writer writes the whole diff, and it is
# paged. Notes taken in a page are kept under the notes key, against the
# head.
#
# Knots follow the heading when there is one. Otherwise they follow the
# first line of the comparison or full diff, which names the change.
show_compared() {
  local key="$1" sha heading="$3" knots="$4"
  sha="$(git rev-parse --short "$2")"
  shift 4
  {
    if [ -n "$heading" ]; then
      printf '%s\n' "$heading"
      [ -z "$knots" ] || printf '%s\n' "$knots"
      cat "$REVIEW_TMP/compare"
      [ "$COMPARE_KIND" != none ] || "$@"
    else
      {
        cat "$REVIEW_TMP/compare"
        [ "$COMPARE_KIND" != none ] || "$@"
      } | under_first "$knots"
    fi
  } > "$REVIEW_TMP/review.diff"
  if [ "$COMPARE_KIND" = clean ]; then
    valley-go style < "$REVIEW_TMP/review.diff"
    cleanup_review_tmp
  else
    page_buffer "$key" "$sha"
  fi
}

# under_first <lines>: copy stdin, inserting <lines> after the first line.
under_first() {
  local first
  IFS= read -r first || [ -n "$first" ] || return 0
  printf '%s\n' "$first"
  [ -z "$1" ] || printf '%s\n' "$1"
  cat
}

# DOES caches the output of `valley-go does` for the review (status/does.go):
# one `<change ID>\tdoes <knot ID> (<status>): <title>` line per knot.
# The checks line takes seconds to read: it reads the policy and the host's
# telemetry. So read_does starts `valley-go checkline`
# (status/versionchecks.go) in the background, and it writes one
# `<change ID>\tchecks: …` line for each ready change into REVIEW_CHECKS_TMP: the
# state of its checks and what they cost the host's check worker to build,
# as pending --checks shows it. The diff is shown without waiting for it.
# checks_line prints a change's line when the read has finished, just
# before the prompt, and prints nothing when it has not (it waits at most
# VALLEY_REVIEW_CHECKS_WAIT seconds, 0 unless set). REVIEW_CHECKS_PID is the
# background read, REVIEW_CHECKS_SHOWN the change IDs whose line is not shown
# again, REVIEW_CHECKS_IDS the changes it reads, and
# REVIEW_CHECKS_VERBOSE whether to pass on what the read said on stderr.
DOES=""
REVIEW_CHECKS_TMP=""
REVIEW_CHECKS_PID=""
REVIEW_CHECKS_SHOWN=" "
REVIEW_CHECKS_VERBOSE=""
REVIEW_CHECKS_IDS=()

# read_does [-v]: read the plan graph once for every change in the review,
# and start reading their checks. A missing or unreadable graph leaves DOES
# empty; -v warns on stderr.
read_does() {
  local ids=() k
  DOES=""
  if [ "${#L_NAME[@]}" -gt 1 ]; then
    for ((k = 0; k < ${#L_ID[@]}; k++)); do
      [ -z "${L_ID[k]}" ] || ids+=("${L_ID[k]}")
    done
  elif [ -n "$CHANGE_ID" ]; then
    ids=("$CHANGE_ID")
  fi
  [ "${#ids[@]}" -gt 0 ] || return 0
  DOES="$(valley-go does "$@" "${ids[@]}")" || DOES=""
  REVIEW_CHECKS_IDS=("${ids[@]}")
  REVIEW_CHECKS_VERBOSE="${1:-}"
  start_checks_read
}

# start_checks_read: read the checks of REVIEW_CHECKS_IDS in the background,
# in place of any read already started.
start_checks_read() {
  cleanup_checks_tmp
  REVIEW_CHECKS_TMP="$(mktemp -d)"
  REVIEW_CHECKS_SHOWN=" "
  valley-go checkline "${REVIEW_CHECKS_IDS[@]}" > "$REVIEW_CHECKS_TMP/out" 2> "$REVIEW_CHECKS_TMP/err" &
  REVIEW_CHECKS_PID=$!
}

# checks_line <change ID>: print the `checks: …` line of one change, once,
# if the background read has finished and gave it one. It never waits.
checks_line() {
  local line
  [ -n "$REVIEW_CHECKS_PID" ] && [ -n "$1" ] || return 0
  case "$REVIEW_CHECKS_SHOWN" in *" $1 "*) return 0 ;; esac
  # Normally the read has had the whole time the diff was read in. A host
  # that wants the line at the prompt can have review wait for it.
  local waited=0 limit="${VALLEY_REVIEW_CHECKS_WAIT:-0}"
  case "$limit" in '' | *[!0-9]*) limit=0 ;; esac
  while kill -0 "$REVIEW_CHECKS_PID" 2> /dev/null; do
    [ "$waited" -lt "$((limit * 10))" ] || return 0
    sleep 0.1
    waited=$((waited + 1))
  done
  if [ -n "$REVIEW_CHECKS_VERBOSE" ] && [ -s "$REVIEW_CHECKS_TMP/err" ]; then
    cat "$REVIEW_CHECKS_TMP/err" >&2
    : > "$REVIEW_CHECKS_TMP/err"
  fi
  while IFS= read -r line; do
    if [ "${line%%$'\t'*}" = "$1" ]; then
      printf '%s\n' "${line#*$'\t'}"
      REVIEW_CHECKS_SHOWN+="$1 "
    fi
  done < "$REVIEW_CHECKS_TMP/out"
}

# cleanup_checks_tmp: stop the background read of the checks, if it still
# runs, and remove what it wrote.
cleanup_checks_tmp() {
  if [ -n "$REVIEW_CHECKS_PID" ]; then
    kill "$REVIEW_CHECKS_PID" 2> /dev/null || true
    REVIEW_CHECKS_PID=""
  fi
  [ -z "$REVIEW_CHECKS_TMP" ] || rm -rf "$REVIEW_CHECKS_TMP"
  REVIEW_CHECKS_TMP=""
}

# does_of <change ID>: print the `does ...` lines for one change from DOES.
does_of() {
  local line
  [ -n "$1" ] || return 0
  while IFS= read -r line; do
    [ "${line%%$'\t'*}" != "$1" ] || printf '%s\n' "${line#*$'\t'}"
  done <<< "$DOES"
}

# full_diff <branch> <head>: the whole diff of a change alone: its log
# and its diff against origin/main. main is read by its exact name, since
# git would take a tag named origin/main for it.
full_diff() {
  local sha tip
  sha="$(git rev-parse --short "$2")"
  tip="$(ref_oid refs/remotes/origin/main)" || return 1
  if [ -n "$CHANGE_HEAD" ]; then
    printf 'change %s v%s at %s, on branch %s, log against origin/main:\n\n' \
      "$CHANGE_HANDLE" "$CHANGE_VERSION" "$sha" "$1"
  else
    printf 'branch %s, log against origin/main:\n\n' "$1"
  fi
  commit_log "$tip..$2"
  git --no-pager diff "$tip...$2"
}

# commit_log <range>: each commit in <range>, newest first: its short hash
# and subject, its body indented four spaces, and a blank line. The whole
# message is shown because a change lands with its head commit's. The
# indent keeps a body line from reading as a diff header, to the notes'
# anchors and to the diff pager alike.
commit_log() {
  git --no-pager log --format='%h %s%n%w(0,4,4)%b' "$1"
}

# show_review <branch>: show a change alone. A change that is not ready
# says so first, before anything else shown of it (shown_not_ready). That
# notice becomes the heading, so the change's knots follow it.
show_review() {
  local branch="$1" head held
  head="$(change_head "$branch")"
  # [a]pprove approves exactly the head shown here (bind_review).
  [ -n "$CHANGE_ID" ] || APPROVE_HEAD="$head"
  held="$(shown_not_ready)" || held=""
  REVIEW_TMP="$(mktemp -d)"
  compare_shown "$CHANGE_ID" "$CHANGE_VERSION" "$head"
  show_compared "$branch" "$head" "$held" "$(does_of "$CHANGE_ID")" full_diff "$branch" "$head"
  REVIEW_CHECKS="$(checks_line "$CHANGE_ID")"
}

# view_full <branch>: [v]iew full diff for a change alone. It pages the
# change's whole diff, and keeps the notes taken in it.
view_full() {
  local head
  head="$(change_head "$1")"
  REVIEW_TMP="$(mktemp -d)"
  full_diff "$1" "$head" > "$REVIEW_TMP/review.diff"
  page_buffer "$1" "$(git rev-parse --short "$head")"
}

# page_buffer <branch> <sha>: page the buffer written to REVIEW_TMP, and
# keep the notes taken in it under the branch, against the commit shown.
page_buffer() {
  cp "$REVIEW_TMP/review.diff" "$REVIEW_TMP/review.orig"
  page_file "$REVIEW_TMP/review.diff" || true # quitting the pager early is not an error
  collect_notes "$1" "$2"
  cleanup_review_tmp
}

# Everything review leaves outside the repository: the paged buffer and
# the checks' scratch. One handler, installed once, so that no path
# through review, and no ctrl-C in the pager, leaves any of them behind.
# The worktrees of a rebase and of an approval's checks are valley-go's,
# which removes them itself.
cleanup_scratch() {
  local status=$?
  # A walk's step with no outcome yet was cut short: by a signal, or by a
  # step that ended the session.
  if [ -z "$WALK_WRITTEN" ]; then
    if [ "$status" -eq 130 ]; then walk_outcome interrupted; else walk_outcome error; fi
  fi
  cleanup_review_tmp
  cleanup_checks_tmp
  tel_command "$status"
}

# A stack's [b]ase onto main and the rebase verb are one piece of code,
# valley-go rebase (status/rebase.go). It rebases the change's whole
# stack in a throwaway worktree of its own — the user's checkout is never
# touched — pushes
# every layer's branch in one atomic push, leased on the tips it read, and
# adds each change's rebased head to its record as a new version. A
# change alone prints what rebase always has; a stack prints a manifest
# of what became of each layer. The judgment on the rebased diff stays
# with the human, back at the review prompt or in whatever front end ran
# the rebase verb.
#
# rebase_shown <head>: [b]ase onto main for the stack under review, while
# its top is still at <head>, the head review showed of it.
rebase_shown() {
  valley-go rebase --head "$1" "${CHANGE_ID:-$CHANGE_NAME}" || return
  # What the checks read was for the heads before the rebase.
  [ -z "$REVIEW_CHECKS_PID" ] || start_checks_read
}

# ----------------------------------------------------------------------
# approve — file an integration request for the change under review,
# which valley-go approve does (status/approve.go). Nothing in this script
# writes the protected ref.

# Report and fail, without leaving the review. A refusal here is not a
# reason to end the session: the branch is still under review and the
# operator can still answer. die() is for the verbs that have nothing left
# to offer.
refuse() {
  printf 'valley: %s\n' "$*" >&2
  return 1
}

# The head approve last ran the checks over and saw them fail, for the
# review prompt: see approve_failed_at.
CHECKS_FAILED_AT=""
# The checks line review read for the change it shows (checks_line), for
# the header of its prompt.
REVIEW_CHECKS=""

# Set by --build-here and -v on review, and passed to its [a]pprove
# (approve): --build-here builds the required nix checks origin holds no
# evidence for on this machine, and -v prints what approve read and
# published.
BUILD_HERE=""
VERBOSE=""

# approve <branch>: review's [a]pprove, one approval attempt of its own
# for each answer, a stack's layers included. valley-go approve
# (status/approve.go) runs it on review's own terminal, told the change
# and head review bound, and the name as typed, which it reads again
# before filing. It writes how the attempt ended to a file: approved, with
# what it filed; checks-failed, with the head the checks failed at, which
# the prompt stops offering [a]pprove for (approve_failed_at); refused or
# unknown; or interrupted, which ends the review as a ctrl-C does. Fails
# unless it filed.
approve() {
  local outcome line="" kind id handle version head
  local -a bound=(--branch "$1")
  [ -z "$APPROVE_HEAD" ] || bound+=(--shown "$APPROVE_HEAD")
  if [ -n "$CHANGE_ID" ]; then
    bound=(--change "$CHANGE_ID" --handle "$CHANGE_HANDLE" --version "$APPROVE_VERSION" --head "$APPROVE_HEAD")
  fi
  if outcome="$(mktemp)"; then
    VALLEY_TELEMETRY_VERSION="$VALLEY_STAMP" valley-go approve --reviewing --name "$CHANGE_NAME" \
      --outcome "$outcome" "${bound[@]}" ${BUILD_HERE:+--build-here} ${VERBOSE:+-v} \
      ${CARRIED:+--carried} || true
    line="$(cat -- "$outcome" 2> /dev/null)" || line=""
    rm -f -- "$outcome"
  fi
  read_resolved "$line" kind id handle version head
  case "$kind" in
    approved)
      walk_outcome approved "$id" "$handle" "$version" "$head"
      return 0
      ;;
    checks-failed) CHECKS_FAILED_AT="$id" ;;
    interrupted) exit 130 ;;
    refused | unknown) ;;
    *) printf 'valley: warning: the approval left no outcome; taking it as refused\n' >&2 ;;
  esac
  WALK_REFUSED=yes
  return 1
}

# tel_command <status>: the command record of a verb this script runs
# itself, handed to valley-go as the script exits, once. valley-go decides
# whether telemetry is on; the verbs this script execs it for it records
# itself.
TEL_ARGS=()
tel_command() {
  [ ${#TEL_ARGS[@]} -gt 0 ] || return 0
  local -a args=("${TEL_ARGS[@]}")
  TEL_ARGS=()
  valley-go telemetry command --since "$TEL_T0" --version "$VALLEY_STAMP" --status "$1" \
    -- "${args[@]}" < /dev/null > /dev/null 2>&1 || true
}

# status, ready, unready and withdraw are a Go program, valley-go
# (status/). status reads a change's request and outcome from origin,
# because what front ends read from it is a JSON contract, and because the
# read is subtle enough to want a real parser: an outcome record it does
# not recognise must read as unknown, never as success. It writes nothing
# and moves no local branch. ready, unready and withdraw write a change's
# record, in the one format the push hook reads it in (change/). knot
# reads and writes the plan graph at refs/the-valley/knots, in the one
# form the push hook validates (knot/), and plan shows that graph as a
# view.
cmd_go() {
  command -v valley-go > /dev/null 2>&1 \
    || die "$1 needs the valley-go helper; nix run .#valley bundles it"
  VALLEY_TELEMETRY_SINCE="$TEL_T0" VALLEY_TELEMETRY_VERSION="$VALLEY_STAMP" exec valley-go "$@"
}

# A change is named by its full change ID, its handle, or its branch.
# resolve_change reads the name with the helper and sets CHANGE_BRANCH, the
# branch to act on. When the name is a change's, it also sets the change's
# ID, handle, active version, state and owner, and CHANGE_HEAD, the head
# that version records. A branch name is a change's when exactly one record's
# active version is on that branch, and is refused when more than one's is.
# So whether a change's record is read never depends on how it is named,
# and review, approve and rebase cannot run without the helper.
#
# A change with a record is acted on at a head its record names, and never
# at the branch's tip: review at CHANGE_HEAD, and approve at the head bound
# to it (status/approve.go). rebase reads the record itself
# (status/rebase.go).
# The branch a record names is only where its head is expected to be, and
# anyone who can push the branch can move it, in the same push as the
# record if they like.
CHANGE_NAME="" CHANGE_ID="" CHANGE_HANDLE="" CHANGE_VERSION="" CHANGE_HEAD="" CHANGE_BRANCH="" CHANGE_STATE=""
CHANGE_OWNER=""

# read_resolved <line> <name…>: read a line of valley-go resolve into the
# variables named, one field each. A version's branch may be empty, and
# read runs consecutive tabs together, since a tab is whitespace to it: an
# empty branch would shift the state into the branch. So each tab is made
# a unit separator first, which read keeps apart.
read_resolved() {
  local resolved="$1"
  shift
  IFS=$'\x1f' read -r "$@" <<< "${resolved//$'\t'/$'\x1f'}"
}

resolve_change() {
  local line kind
  CHANGE_NAME="$1"
  command -v valley-go > /dev/null 2>&1 \
    || die "review, approve and rebase read the change's record with the valley-go helper; nix run .#valley bundles it"
  line="$(valley-go resolve "$1")" || return 1
  read_resolved "$line" kind CHANGE_ID CHANGE_HANDLE CHANGE_VERSION CHANGE_HEAD CHANGE_BRANCH CHANGE_STATE CHANGE_OWNER
  case "$kind" in
    branch)
      CHANGE_BRANCH="$CHANGE_ID"
      CHANGE_ID=""
      ;;
    change)
      [[ "$CHANGE_HEAD" =~ ^[0-9a-f]{40}$ ]] \
        || die "valley-go resolve named the head $CHANGE_HEAD, which is no object ID"
      case "$CHANGE_STATE" in
        ready | draft | withdrawn) ;;
        *) die "valley-go resolve named the state $CHANGE_STATE, which this script does not read" ;;
      esac
      ;;
    *) die "valley-go resolve answered $line, which this script does not read" ;;
  esac
}

# need_branch <verb>: refuse a change whose active version records no
# branch. review acts on the change's branch: it files its notes under it
# and its [r]eject deletes it. rebase, which pushes it, refuses such a
# change in valley-go. approve files the head alone, so it approves such a
# change.
need_branch() {
  if [ -n "$CHANGE_ID" ] && [ -z "$CHANGE_BRANCH" ]; then
    die "change $CHANGE_HANDLE v$CHANGE_VERSION records no branch, and $1 acts on a change's branch. Approve its head alone: valley approve --head $CHANGE_HEAD $CHANGE_HANDLE"
  fi
}

# The commit review and approve act on: the recorded head for a change
# with a record, and otherwise the branch's head on origin.
change_head() {
  if [ -n "$CHANGE_HEAD" ]; then
    printf '%s\n' "$CHANGE_HEAD"
  else
    ref_oid "refs/remotes/origin/$1"
  fi
}

# fast_forwards <commit>: whether the commit fast-forwards from main's tip
# as the fetch left it. A main that cannot be read is not one it
# fast-forwards from.
fast_forwards() {
  local tip
  tip="$(ref_oid refs/remotes/origin/main)" && git merge-base --is-ancestor "$tip" "$1"
}

# For a change with a record, refuse unless the branch's tip on origin is
# the recorded head, and name both. review's [r]eject acts on the branch
# itself: deleting it while it is elsewhere would delete a commit no
# version records. rebase asks the same in valley-go. approve does not ask
# this, since the request it files names the head it approves and not the
# branch. The second argument is what the refusal leaves undone.
check_recorded_tip() {
  local branch="$1" undone="$2" tip
  [ -n "$CHANGE_HEAD" ] || return 0
  tip="$(ref_oid "refs/remotes/origin/$branch")" || {
    refuse "no such branch on origin: $branch; $undone"
    return 1
  }
  [ "$tip" = "$CHANGE_HEAD" ] && return 0
  refuse "change $CHANGE_HANDLE v$CHANGE_VERSION records the head $CHANGE_HEAD, and origin/$branch is at $tip; $undone. Ready the branch's head as a new version of $CHANGE_HANDLE to act on it"
}

# The head review's [a]pprove files, and its version: the active version's
# head for a change with a record, or the head review shows of a plain
# branch (bind_review).
APPROVE_HEAD="" APPROVE_VERSION=""

# review shows a change with a record at its active version's head, and
# its [a]pprove approves exactly that head. A plain branch is bound to the
# head review pages, when it pages it (show_review, use_layer), and approve
# files that head.
bind_review() {
  APPROVE_HEAD="" APPROVE_VERSION=""
  if [ -n "$CHANGE_ID" ]; then
    APPROVE_HEAD="$CHANGE_HEAD"
    APPROVE_VERSION="$CHANGE_VERSION"
  fi
}

# The head the checks failed at in this review, short, while the change is
# still at it. Approving that head again would run the same checks over
# the same tree and fail the same way, so the prompt stops offering
# [a]pprove until the change has a new head. Fails when the checks have
# not failed at the head the change is at.
approve_failed_at() {
  if [ -z "$CHECKS_FAILED_AT" ] || [ "$CHECKS_FAILED_AT" != "$(change_head "$1")" ]; then
    return 1
  fi
  git rev-parse --short "$CHECKS_FAILED_AT"
}

# not_ready <handle> <version> <state> <owner>: the line review shows for a
# change whose record is not ready, above its diff and in its prompt.
# Prints nothing, and fails, for a ready change, and for a plain branch,
# which has no record. A draft is often a change an agent is still working
# on, so the prompt then offers only [v]iew full diff and [s]kip.
# [a]pprove would be refused. Nor is [r]eject offered, which records
# nothing on the change: it deletes the branch its owner may still be
# working on, and the record says what it said before. review still reads
# the record again before it acts, since the state can change while the
# review is open (moved).
not_ready() {
  case "$3" in
    draft) printf "%s v%s is a draft: its owner (%s) hasn't marked it ready, so it can't be approved yet." "$1" "$2" "$4" ;;
    withdrawn) printf '%s is withdrawn: there is nothing to approve.' "$1" ;;
    *) return 1 ;;
  esac
}

# shown_not_ready: not_ready for the change review is showing.
shown_not_ready() {
  not_ready "$CHANGE_HANDLE" "$CHANGE_VERSION" "$CHANGE_STATE" "$CHANGE_OWNER"
}

# Where the change under review stands now, as valley-go standing reads
# it from origin (status/standing.go), set by read_standing. The state,
# the active version and its head; when the record last changed; the
# version the change landed as, v<n>, once any has; and STANDING_CONFLICT, which is "conflict"
# while the host's restacker reports that rebasing the change onto main
# conflicted.
STANDING_STATE="" STANDING_VERSION="" STANDING_HEAD="" STANDING_SINCE=""
STANDING_LANDED="" STANDING_CONFLICT=""

# read_standing: read where the change under review stands now. A plain
# branch has no record, and reads as nothing. Fails when origin cannot be
# read.
read_standing() {
  local line
  STANDING_STATE="" STANDING_VERSION="" STANDING_HEAD="" STANDING_SINCE=""
  STANDING_LANDED="" STANDING_CONFLICT=""
  [ -n "$CHANGE_ID" ] || return 0
  line="$(valley-go standing "$CHANGE_ID")" || return 1
  read_resolved "$line" STANDING_STATE STANDING_VERSION STANDING_HEAD STANDING_SINCE \
    STANDING_LANDED STANDING_CONFLICT
}

# moved: before review acts on an answer about a change with a record, it
# reads the change again. Another principal may return it to draft, ready
# a new version, or withdraw it while the operator reads, and it may land.
# When it is no longer what review showed, moved says in one line what
# changed and what happens next, and the review of that change ends: the
# prompt's answers were about what was shown, so it is not asked again.
# A new version the answer carries to, such as a restack with the same
# changes, does not end it (carried). Fails when the change is still as
# shown or the answer carries, and for a plain branch, which approve and
# reject check themselves.
moved() {
  local h="$CHANGE_HANDLE"
  CARRIED=""
  [ -n "$CHANGE_ID" ] || return 1
  if ! read_standing; then
    echo "could not read $h again from origin; nothing done"
    walk_outcome error
    return 0
  fi
  case "$STANDING_STATE" in
    withdrawn)
      echo "$h changed while you were reviewing: it was withdrawn (since $STANDING_SINCE), so there is nothing to approve."
      walk_outcome moved
      return 0
      ;;
    draft)
      echo "$h changed while you were reviewing: it was returned to draft (since $STANDING_SINCE), so there is nothing to approve now. It comes back when it is ready again."
      walk_outcome moved
      return 0
      ;;
  esac
  if [ -n "$STANDING_LANDED" ]; then
    echo "$h landed as $STANDING_LANDED while you were reviewing; there is nothing left to approve."
    walk_outcome moved
    return 0
  fi
  if [ "$STANDING_VERSION" != "$CHANGE_VERSION" ] || [ "$STANDING_HEAD" != "$CHANGE_HEAD" ]; then
    carried || {
      walk_outcome moved
      return 0
    }
  fi
  return 1
}

# Set by carried when the answer carries, and cleared by moved: off a
# terminal, carried's line ended the line review's prompt left open, so
# approve's verdict needs no newline of its own.
CARRIED=""

# carried: whether the answer about the version review showed carries to
# the version the change moved to, as valley-go carry decides
# (status/carry.go). When it does, carried says so in one line, and the
# answer stays bound to the head shown: an approval names what the
# reviewer read, and the integrator applies its delta onto main as main
# stands. When it does not, carried says why in one line, offers to page
# only what changed since the version shown, and fails.
carried() {
  local h="$CHANGE_HANDLE" verdict="" reason="" choice
  REVIEW_TMP="$(mktemp -d)"
  valley-go carry "$CHANGE_ID" "$CHANGE_VERSION" "$STANDING_VERSION" > "$REVIEW_TMP/carry" \
    && IFS=$'\t' read -r verdict reason < "$REVIEW_TMP/carry"
  case "$verdict" in
    carries)
      echo "$h moved to v$STANDING_VERSION while you were reviewing ($reason) · your answer about v$CHANGE_VERSION stands"
      CARRIED=yes
      cleanup_review_tmp
      return 0
      ;;
    review)
      printf '%s moved to v%s while you were reviewing (%s) · review it again to approve it · [v]iew what changed since v%s, [s]kip? ' \
        "$h" "$STANDING_VERSION" "$reason" "$CHANGE_VERSION"
      read -r choice || choice=""
      if [ "$choice" = v ]; then
        tail -n +2 "$REVIEW_TMP/carry" > "$REVIEW_TMP/changed"
        page_file "$REVIEW_TMP/changed" || true # quitting the pager early is not an error
      fi
      ;;
    *) echo "$h moved to v$STANDING_VERSION while you were reviewing; review it again to approve what would land." ;;
  esac
  cleanup_review_tmp
  return 1
}

# behind_main <branch>: the clause review's prompt shows for a change that
# does not fast-forward from main. Being behind main is normal and asks
# nothing of the operator: the integrator applies the change's delta onto
# main as main stands, with the evidence for the head approved, and the
# host's restacker rebases ready changes itself. When the restacker
# reports that rebasing the change conflicted, the clause says so instead,
# and [a]pprove stays offered: the integrator decides whether the change
# applies. Prints nothing, and fails, for a change that fast-forwards from
# main.
behind_main() {
  fast_forwards "$(change_head "$1")" && return 1
  read_standing || STANDING_CONFLICT=""
  if [ "$STANDING_CONFLICT" = conflict ]; then
    printf 'conflicts with main (owner resolving)'
  else
    printf 'behind main (integrator merges)'
  fi
}

# Show the branch and take the verdict. Split out of cmd_review so that
# every way out of it — approve, reject, skip — is followed by the notes.
read_and_decide() {
  show_review "$1"
  decide "$1"
}

# decide <branch> [<name> <n>]: the verdict on a change alone, and on the
# top of a stack. Its prompt is one header line, the change and what
# stands in its way as clauses, and the keys it takes (valley-go verdict
# prompt, status/verdict.go). A change is named by its handle and version,
# a plain branch by its name, and a change alone carries the checks line
# review read for it. The top of a stack of <n> is named by its <name>, as
# the stack lists it, and its [a]pprove says that approving it lands all
# <n> layers. [v]iew diff pages the change's whole diff, or the top
# layer's.
#
# A change that is not ready says so in its header, and is offered only
# [v]iew diff and [s]kip, or [s]top. The top of a stack with a layer under
# it that is not ready says why it can't be approved (layer_held), as
# does a change whose checks failed at the head shown, and neither is
# offered [a]pprove. A change that can be approved and does not
# fast-forward from main says so (behind_main). Before [a]pprove and
# [r]eject act, moved reads the change again, and ends its review when it
# moved.
decide() {
  local branch="$1" name="${2:-}" n="${3:-}" choice failed answers own="" held="" behind="" clause
  local approve="[a]pprove" reject="[r]eject" stop="[s]kip"
  local stopped="skipped $1; nothing done"
  local -a header=("$1") keys=()
  if [ -n "$CHANGE_ID" ]; then
    header=("$CHANGE_HANDLE v$CHANGE_VERSION")
    case "$CHANGE_STATE" in
      draft) own="draft (its owner, $CHANGE_OWNER, has not readied it)" ;;
      withdrawn) own="withdrawn" ;;
    esac
  fi
  if [ -n "$n" ]; then
    header+=("stack of $n")
    approve="[a]pprove all $n" reject="[r]eject $name" stop="[s]top"
    stopped="stopped reviewing $name at change $n of $n; nothing done"
    held="$(layer_held $((n - 1)))" || held=""
  elif [ -n "${REVIEW_CHECKS:-}" ]; then
    header+=("$REVIEW_CHECKS")
  fi
  if [ -z "$own" ] && [ -z "$held" ]; then
    behind="$(behind_main "$branch")" || behind=""
  fi
  while true; do
    failed=""
    if [ -n "$own" ]; then
      clause="$own" keys=("[v]iew diff" "$stop") answers="v or s"
    elif [ -n "$held" ]; then
      clause="$held" keys=("[v]iew diff" "$reject" "$stop") answers="v, r, or s"
    elif failed="$(approve_failed_at "$branch")"; then
      clause="checks failed at $failed" keys=("[v]iew diff" "$reject" "$stop") answers="v, r, or s"
    else
      clause="$behind" keys=("$approve" "[v]iew diff" "$reject" "$stop") answers="a, v, r, or s"
    fi
    valley-go verdict prompt "${header[@]}" ${clause:+"$clause"} -- "${keys[@]}"
    read -r choice || die "stdin closed before an answer; nothing done"
    case "$choice" in
      # A refusal from approve is not a verdict: it says what it did not do
      # and the prompt comes back, so the branch can still be rejected or
      # skipped. When the checks failed, approving the same head again is
      # no longer offered, nor is approving a change that is not ready. A
      # change that moved since it was shown is not acted on, and its
      # review ends.
      a)
        if [ -n "$failed" ] || [ -n "$own" ] || [ -n "$held" ]; then
          echo "answer $answers"
        elif moved || approve "$branch"; then
          return
        fi
        ;;
      v)
        if [ -n "$n" ]; then
          view_layer $((n - 1))
        else
          view_full "$branch"
        fi
        ;;
      r)
        if [ -n "$own" ]; then
          echo "answer $answers"
        elif moved; then
          return
        else
          reject "$branch" && return
        fi
        ;;
      s)
        echo "$stopped"
        walk_skipped
        return
        ;;
      *) echo "answer $answers" ;;
    esac
  done
}

# ----------------------------------------------------------------------
# A stack — a change with layers under it that have not landed — is
# reviewed one layer at a time, bottom first, each against the layer below
# it, the way it was built. Approving the top lands every layer under it,
# so reading the top against main alone would ask the operator to judge
# the whole stack as one diff.
#
# The layers are valley-go stack's (status/stack.go): one line each, bottom
# first, the change itself last, read here into one array per field.
# L_BRANCH is the branch a layer's notes are kept under: a branch's own
# name, or the branch a change's active version names. L_OWNER is a
# change's owner, as its record names it. L_NOTES holds the notes taken on
# each layer, for the print after the verdict.
L_KIND=() L_NAME=() L_BASE=() L_HEAD=() L_STATE=() L_APPROVED=() L_TITLE=()
L_ID=() L_VERSION=() L_BRANCH=() L_OWNER=() L_NOTES=()
# The name review was given, which the top is read again by.
TOP_NAME=""

# read_stack: read the stack under the change review resolved. Each change
# under the top is read again with resolve, for its ID, version, branch
# and owner, and must still be at the head the stack names. The top must be
# what review resolved. Fails, having said why, when either does not hold
# or the helper cannot read the stack. Called in a condition, so each step
# is checked by hand.
read_stack() {
  local out line kind name base head state approved title k last
  local rkind id handle version rhead branch rstate owner
  L_KIND=() L_NAME=() L_BASE=() L_HEAD=() L_STATE=() L_APPROVED=() L_TITLE=()
  L_ID=() L_VERSION=() L_BRANCH=() L_OWNER=() L_NOTES=()
  out="$(valley-go stack "${CHANGE_ID:-origin/$CHANGE_BRANCH}")" || return 1
  while IFS= read -r line; do
    read_resolved "$line" kind name base head state approved title
    if ! [[ "$kind" =~ ^(change|branch)$ && "$base" =~ ^[0-9a-f]{40}$ && "$head" =~ ^[0-9a-f]{40}$ ]]; then
      refuse "valley-go stack answered $line, which this script does not read"
      return 1
    fi
    L_KIND+=("$kind") L_NAME+=("$name") L_BASE+=("$base") L_HEAD+=("$head")
    L_STATE+=("$state") L_APPROVED+=("$approved") L_TITLE+=("$title") L_NOTES+=("")
    L_ID+=("") L_VERSION+=("") L_BRANCH+=("$name") L_OWNER+=("")
  done <<< "$out"
  last=$((${#L_NAME[@]} - 1))
  if [ "${L_HEAD[last]}" != "$(change_head "$CHANGE_BRANCH")" ] \
    || [ "${L_KIND[last]}" != "$([ -n "$CHANGE_ID" ] && echo change || echo branch)" ]; then
    refuse "$TOP_NAME moved while its stack was read"
    return 1
  fi
  L_ID[last]="$CHANGE_ID" L_VERSION[last]="$CHANGE_VERSION" L_BRANCH[last]="$CHANGE_BRANCH"
  L_OWNER[last]="$CHANGE_OWNER"
  for ((k = 0; k < last; k++)); do
    [ "${L_KIND[k]}" = change ] || continue
    line="$(valley-go resolve "${L_NAME[k]}")" || return 1
    read_resolved "$line" rkind id handle version rhead branch rstate owner
    if [ "$rkind" != change ] || [ "$rhead" != "${L_HEAD[k]}" ]; then
      refuse "change ${L_NAME[k]}, under $TOP_NAME, moved while the stack was read"
      return 1
    fi
    L_ID[k]="$id" L_VERSION[k]="$version" L_BRANCH[k]="$branch" L_STATE[k]="$rstate"
    L_OWNER[k]="$owner"
  done
}

# use_layer <k>: act on layer k as review acts on a change it was given,
# binding [a]pprove to the head the stack shows. A branch under the top is
# read again as origin/<branch>, which no handle can shadow.
use_layer() {
  local k="$1"
  CHANGE_ID="${L_ID[k]}" CHANGE_VERSION="${L_VERSION[k]}" CHANGE_BRANCH="${L_BRANCH[k]}"
  CHANGE_STATE="${L_STATE[k]}" CHANGE_OWNER="${L_OWNER[k]}" CHANGE_HANDLE="" CHANGE_HEAD=""
  CHANGE_NAME="origin/${L_NAME[k]}"
  [ "$k" -lt $((${#L_NAME[@]} - 1)) ] || CHANGE_NAME="$TOP_NAME"
  if [ -n "$CHANGE_ID" ]; then
    CHANGE_NAME="${L_NAME[k]}" CHANGE_HANDLE="${L_NAME[k]}" CHANGE_HEAD="${L_HEAD[k]}"
  fi
  bind_review
  [ -n "$CHANGE_ID" ] || APPROVE_HEAD="${L_HEAD[k]}"
}

# notes_key <k>: the branch layer k's notes are kept under. A change whose
# active version names no branch keeps them under its handle.
notes_key() {
  printf '%s' "${L_BRANCH[$1]:-${L_NAME[$1]}}"
}

# layer_skipped <k>: succeeds for a layer below the top that is approved,
# which asks nothing of the reviewer: the valley carries it to landing once
# its checks pass. The walk does not page it. The top is the change review
# was named, so it is always paged.
layer_skipped() {
  [ "$1" -lt $((${#L_NAME[@]} - 1)) ] && [ "${L_APPROVED[$1]}" = approved ]
}

# layer_label <k>: how a layer is named in the list: its name, then
# branch, or the change's state.
layer_label() {
  local k="$1"
  if [ "${L_KIND[k]}" = branch ]; then
    printf '%s (branch)' "${L_NAME[k]}"
  elif layer_skipped "$k"; then
    printf '%s (approved, not paged)' "${L_NAME[k]}"
  else
    printf '%s (%s)' "${L_NAME[k]}" "${L_STATE[k]}"
  fi
}

# What is coming: the layers bottom first, the lower layers the integrator
# would refuse, and what each answer lands.
summarize_stack() {
  local n="${#L_NAME[@]}" k
  printf '%s is a stack of %d changes; reviewing from the bottom, each against the one below it:\n' \
    "${L_NAME[n - 1]}" "$n"
  for ((k = 0; k < n; k++)); do
    printf '  %d. %s: %s\n' "$((k + 1))" "$(layer_label "$k")" "${L_TITLE[k]}"
  done
  for ((k = 0; k < n - 1; k++)); do
    case "${L_STATE[k]}" in
      draft | withdrawn)
        printf 'warning: %s, change %d of %d, is %s. The integrator refuses to land it or anything above it (refused-not-ready).\n' \
          "${L_NAME[k]}" "$((k + 1))" "$n" "$([ "${L_STATE[k]}" = draft ] && echo 'a draft' || echo withdrawn)"
        ;;
    esac
  done
  printf 'read each layer and go on with [n]; approving %s at the top lands all %d. [a] on a lower layer lands it and the layers under it, and ends the review.\n' \
    "${L_NAME[n - 1]}" "$n"
}

# base_stack: before any layer is paged, a stack whose bottom does not
# fast-forward from main is offered [b]ase, which rebases every layer as
# the rebase verb does (status/rebase.go), [v]iew diff, which pages the
# top's whole diff, or [s]kip. After a rebase the stack is read again and
# listed again, so the heads paged are the heads approved. A rebase
# refused or left unfinished has said what happened, and only [v]iew diff
# and [s]kip are offered then. Fails when the review stops here.
base_stack() {
  local n choice answers clause="behind main" stopped="; nothing done"
  local -a keys=()
  while ! fast_forwards "${L_HEAD[0]}"; do
    n="${#L_NAME[@]}"
    if [ "$clause" = "behind main" ]; then
      keys=("[b]ase onto main" "[v]iew diff" "[s]kip") answers="b, v, or s"
    else
      keys=("[v]iew diff" "[s]kip") answers="v or s"
    fi
    valley-go verdict prompt "${L_NAME[n - 1]}" "stack of $n" "$clause" -- "${keys[@]}"
    read -r choice || die "stdin closed before an answer; nothing done"
    case "$choice" in
      b)
        if [ "$clause" != "behind main" ]; then
          echo "answer $answers"
        elif rebase_shown "${L_HEAD[n - 1]}"; then
          fetch_origin
          if [ -n "$CHANGE_ID" ]; then
            resolve_change "$CHANGE_ID" || die "could not read change $CHANGE_HANDLE again after the rebase"
          fi
          bind_review
          read_stack || die "could not read the stack under $TOP_NAME again after the rebase"
          summarize_stack
        else
          clause="not rebased" stopped="" WALK_REFUSED=yes
        fi
        ;;
      v) view_full "$CHANGE_BRANCH" ;;
      s)
        echo "stopped reviewing ${L_NAME[n - 1]} before its first layer$stopped"
        walk_skipped
        return 1
        ;;
      *) echo "answer $answers" ;;
    esac
  done
}

# layer_heading <k>: the line that heads layer k wherever it is shown.
layer_heading() {
  local k="$1" below=main
  [ "$k" -eq 0 ] || below="${L_NAME[k - 1]}"
  printf 'change %d of %d: %s on %s' "$((k + 1))" "${#L_NAME[@]}" "${L_NAME[k]}" "$below"
}

# layer_held <k>: why layer k can't be approved, when it or a layer under
# it is not ready. A layer that is not ready says so as a change alone
# does (not_ready). A layer above one says which: approving it would land
# that layer too, and the integrator lands nothing that would bring a
# version of a change that is not ready. Prints nothing, and fails, when
# every layer up to k is ready or a plain branch.
layer_held() {
  local k="$1" j
  not_ready "${L_NAME[k]}" "${L_VERSION[k]}" "${L_STATE[k]}" "${L_OWNER[k]}" && return
  for ((j = k - 1; j >= 0; j--)); do
    case "${L_STATE[j]}" in
      draft | withdrawn)
        printf "it would bring %s, change %d of %d, which is %s, so it can't be approved yet." \
          "${L_NAME[j]}" "$((j + 1))" "${#L_NAME[@]}" "$([ "${L_STATE[j]}" = draft ] && echo 'a draft' || echo withdrawn)"
        return
        ;;
    esac
  done
  return 1
}

# page_layer <k>: show layer k, as show_review shows a change alone. The
# layer shown is compared with its own change's approved version, so a
# lower layer is set against its own approval, not the top's. Its whole
# diff is against the layer below it. The notes taken in it are kept
# under its own branch. When it can't be approved, layer_held's line
# follows its heading, before the layer's knots.
page_layer() {
  local k="$1" heading held
  NOTES=()
  heading="$(layer_heading "$k")"
  if held="$(layer_held "$k")"; then heading+=$'\n'"$held"; fi
  REVIEW_TMP="$(mktemp -d)"
  compare_shown "${L_ID[k]}" "${L_VERSION[k]}" "${L_HEAD[k]}"
  show_compared "$(notes_key "$k")" "${L_HEAD[k]}" "$heading" "$(does_of "${L_ID[k]}")" layer_diff "$k"
  checks_line "${L_ID[k]}"
  keep_layer_notes "$k"
}

# view_layer <k>: [v]iew full diff for layer k: its whole diff against
# the layer below it.
view_layer() {
  local k="$1"
  NOTES=()
  REVIEW_TMP="$(mktemp -d)"
  {
    layer_heading "$k"
    printf '\n'
    layer_diff "$k"
  } > "$REVIEW_TMP/review.diff"
  page_buffer "$(notes_key "$k")" "$(git rev-parse --short "${L_HEAD[k]}")"
  keep_layer_notes "$k"
}

# keep_layer_notes <k>: add the notes just taken to layer k's.
keep_layer_notes() {
  [ "${#NOTES[@]}" -gt 0 ] || return 0
  L_NOTES[$1]="${L_NOTES[$1]:+${L_NOTES[$1]}$'\n'}$(printf '%s\n' "${NOTES[@]}")"
}

# layer_diff <k>: layer k's whole diff: its log and its diff against the
# layer below it.
layer_diff() {
  local k="$1" below=main head base sha on
  [ "$k" -eq 0 ] || below="${L_NAME[k - 1]}"
  head="${L_HEAD[k]}" base="${L_BASE[k]}"
  sha="$(git rev-parse --short "$head")"
  on="$below at $(git rev-parse --short "$base")"
  if [ "${L_KIND[k]}" = branch ]; then
    printf 'branch %s, log against %s:\n\n' "${L_NAME[k]}" "$on"
  elif [ -n "${L_BRANCH[k]}" ]; then
    printf 'change %s v%s at %s, on branch %s, log against %s:\n\n' \
      "${L_NAME[k]}" "${L_VERSION[k]}" "$sha" "${L_BRANCH[k]}" "$on"
  else
    printf 'change %s v%s at %s, log against %s:\n\n' "${L_NAME[k]}" "${L_VERSION[k]}" "$sha" "$on"
  fi
  commit_log "$base..$head"
  git --no-pager diff "$base...$head"
}

# Show each layer under the top and ask after each, naming the layer and
# its place: [n]ext layer goes on to the layer above, [a]pprove approves
# that layer at the head shown, which lands it and every layer under it,
# as the prompt names them, [v]iew full diff pages the layer's whole diff,
# and [s]top ends the review. [r]eject is not offered under the top:
# deleting a lower layer's branch would leave the layers above still
# holding it. [a]pprove is not offered at or above a layer that is not
# ready, and the prompt says why in its place (layer_held). After the
# top, its verdict is taken as for any change, with a prompt that names
# the top and says approving it lands all n.
review_stack() {
  local n top k choice answers failed lands held
  summarize_stack
  base_stack || return 0
  printf '\n'
  n="${#L_NAME[@]}" top=$((${#L_NAME[@]} - 1))
  for ((k = 0; k < top; k++)); do
    layer_skipped "$k" && continue
    page_layer "$k"
    case "$k" in
      0) lands="${L_NAME[0]} alone" ;;
      1) lands="${L_NAME[0]} and ${L_NAME[1]}" ;;
      *) lands="the $((k + 1)) up to ${L_NAME[k]}" ;;
    esac
    held="$(layer_held "$k")" || held=""
    while true; do
      failed=""
      [ "$CHECKS_FAILED_AT" != "${L_HEAD[k]}" ] || failed="$(git rev-parse --short "${L_HEAD[k]}")"
      if [ -n "$held" ]; then
        printf '%s, %d of %d: %s [n]ext layer, [v]iew full diff, [s]top? ' \
          "${L_NAME[k]}" "$((k + 1))" "$n" "$held"
        answers="n, v, or s"
      elif [ -n "$failed" ]; then
        printf '%s, %d of %d: its checks failed at %s, so approving needs a new head: [n]ext layer, [v]iew full diff, [s]top? ' \
          "${L_NAME[k]}" "$((k + 1))" "$n" "$failed"
        answers="n, v, or s"
      else
        printf '%s, %d of %d: [n]ext layer, [a]pprove %s, [v]iew full diff, [s]top? ' \
          "${L_NAME[k]}" "$((k + 1))" "$n" "$lands"
        answers="n, a, v, or s"
      fi
      read -r choice || die "stdin closed before an answer; nothing done"
      case "$choice" in
        n) break ;;
        a)
          if [ -n "$failed" ] || [ -n "$held" ]; then
            echo "answer $answers"
            continue
          fi
          use_layer "$k"
          if moved || approve "$CHANGE_BRANCH"; then
            return
          fi
          use_layer "$top"
          ;;
        v) view_layer "$k" ;;
        s)
          echo "stopped reviewing ${L_NAME[top]} at change $((k + 1)) of $n, ${L_NAME[k]}; nothing done"
          walk_skipped
          return
          ;;
        *) echo "answer $answers" ;;
      esac
    done
  done
  page_layer "$top"
  use_layer "$top"
  decide "${L_BRANCH[top]}" "${L_NAME[top]}" "$n"
}

# The notes taken on every layer, each under its own branch.
print_stack_notes() {
  local k
  for ((k = 0; k < ${#L_NAME[@]}; k++)); do
    [ -n "${L_NOTES[k]}" ] || continue
    mapfile -t NOTES <<< "${L_NOTES[k]}"
    print_notes "$(notes_key "$k")"
  done
}

# A review run as a step of a walk (valley-go walk, status/walk.go) is
# told what the walker's queue held of the change, as "<change ID>
# <version> <head>", and the file its outcome goes to. Both are empty for
# any other review. WALK_REFUSED is set when an answer is refused, so a
# skip after it is said as one.
WALK_QUEUED="" WALK_FILE="" WALK_WRITTEN="" WALK_REFUSED=""

# walk_outcome <outcome> [<field>...]: how the step ended, as one line of
# tab-separated fields for the walker. The last one written stands.
walk_outcome() {
  [ -n "$WALK_FILE" ] || return 0
  (IFS=$'\t' && printf '%s\n' "$*") > "$WALK_FILE" && WALK_WRITTEN=yes
}

# walk_skipped: the outcome of a step whose review was skipped or stopped.
walk_skipped() {
  if [ -n "$WALK_REFUSED" ]; then walk_outcome refused; else walk_outcome skipped; fi
}

# walk_queued: in a walk, compare the change with what the queue held. A
# change that landed, is no longer ready or has no branch on origin is not
# reviewed, and the step ends; one ready at another version is reviewed at
# it, saying so first. Fails when the step ends here.
walk_queued() {
  local id version head why=""
  [ -n "$WALK_QUEUED" ] || return 0
  read -r id version head <<< "$WALK_QUEUED"
  read_standing || STANDING_LANDED=""
  if [ -n "$STANDING_LANDED" ]; then
    why="it landed as $STANDING_LANDED"
  elif [ "$CHANGE_STATE" != ready ]; then
    why="it is ${CHANGE_STATE/draft/a draft}"
  elif [ -z "$CHANGE_BRANCH" ] || ! ref_oid "refs/remotes/origin/$CHANGE_BRANCH" > /dev/null; then
    why="its branch is gone from origin"
  fi
  if [ -n "$why" ]; then
    echo "$CHANGE_HANDLE is not reviewed: $why"
    walk_outcome not-reviewed "$why"
    return 1
  fi
  [ "$CHANGE_ID $CHANGE_VERSION $CHANGE_HEAD" = "$id $version $head" ] \
    || echo "$CHANGE_HANDLE moved to v$CHANGE_VERSION since the queue was read"
}

cmd_review() {
  local name="" verbose=() repo=()
  local usage="usage: valley review [-v] [--build-here] [<change> | --repo <name>]"
  while [ $# -gt 0 ]; do
    case "$1" in
      -v) verbose=(-v) VERBOSE=yes ;;
      --build-here) BUILD_HERE=yes ;;
      --repo)
        [ $# -gt 1 ] || die "$usage"
        repo=(--repo "$2")
        shift
        ;;
      -*) die "$usage" ;;
      *)
        [ -z "$name" ] || die "$usage"
        name="$1"
        ;;
    esac
    shift
  done
  # With no change, review walks what needs the operator (status/walk.go),
  # running this verb once for each change.
  if [ -z "$name" ]; then
    command -v valley-go > /dev/null 2>&1 \
      || die "review with no change needs the valley-go helper; nix run .#valley bundles it"
    fetch_origin
    VALLEY_COMMAND="$0" VALLEY_TELEMETRY_SINCE="$TEL_T0" VALLEY_TELEMETRY_VERSION="$VALLEY_STAMP" \
      exec valley-go walk "${verbose[@]}" ${BUILD_HERE:+--build-here} "${repo[@]}"
  fi
  [ "${#repo[@]}" -eq 0 ] || die "$usage"
  set -- "$name"
  WALK_QUEUED="${VALLEY_WALK_QUEUED:-}" WALK_FILE="${VALLEY_WALK_OUTCOME:-}"
  unset VALLEY_WALK_QUEUED VALLEY_WALK_OUTCOME
  resolve_change "$1" || exit 1
  fetch_origin
  walk_queued || exit 0
  need_branch review
  local branch="$CHANGE_BRANCH"
  TOP_NAME="$1"
  ref_oid "refs/remotes/origin/$branch" >/dev/null \
    || die "no such branch on origin: $branch"
  bind_review
  trap cleanup_scratch EXIT
  trap 'exit 130' INT TERM
  # The verdict disposes of the change; the notes are what the human made
  # of it, so they are printed whatever the verdict was. A stack that
  # cannot be read is reviewed whole against main, as a change with
  # nothing under it is.
  if ! read_stack; then
    printf 'valley: warning: the stack under %s could not be read; reviewing it whole, against main\n' "$1" >&2
    L_NAME=()
  fi
  read_does "${verbose[@]}"
  if [ "${#L_NAME[@]}" -gt 1 ]; then
    review_stack
    print_stack_notes
  else
    read_and_decide "$branch"
    print_notes "$branch"
  fi
}

# approve is review's [a]pprove without the pager, for a front end that
# has shown the change its own way: valley-go approve (status/approve.go),
# the code the key runs, so the verb and the key cannot drift apart. It
# resolves the change before the fetch, as review does.
cmd_approve() {
  command -v valley-go > /dev/null 2>&1 \
    || die "approve needs the valley-go helper; nix run .#valley bundles it"
  VALLEY_TELEMETRY_SINCE="$TEL_T0" VALLEY_TELEMETRY_VERSION="$VALLEY_STAMP" \
    exec valley-go approve "$@"
}

# rebase is review's [b]ase onto main without the pager. It runs the code
# its key runs, valley-go rebase, and reads a change's name as
# resolve_change reads it. The two flags that say what a transfer
# statement is verified with are valley-go's, and pass through to it
# untouched.
cmd_rebase() {
  local usage="usage: valley rebase [--known-signers <file>] [--integrator-name <name>] <change>"
  local name="" verify=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --known-signers | --integrator-name)
        [ $# -ge 2 ] || die "$usage"
        verify+=("$1" "$2")
        shift 2
        ;;
      --known-signers=* | --integrator-name=*)
        verify+=("$1")
        shift
        ;;
      -*) die "$usage" ;;
      *)
        [ -z "$name" ] || die "$usage"
        name="$1"
        shift
        ;;
    esac
  done
  [ -n "$name" ] || die "$usage"
  command -v valley-go > /dev/null 2>&1 \
    || die "review, approve and rebase read the change's record with the valley-go helper; nix run .#valley bundles it"
  fetch_origin
  VALLEY_TELEMETRY_SINCE="$TEL_T0" VALLEY_TELEMETRY_VERSION="$VALLEY_STAMP" \
    exec valley-go rebase "${verify[@]}" "$name"
}

# tail and replay are thin wrappers over the nats CLI — anything they do,
# plain nats and git can do. They are the only verbs needing more than git
# and coreutils.
need_nats() {
  command -v nats >/dev/null 2>&1 \
    || die "this verb needs the nats CLI (natscli); nix run .#valley bundles it"
}

cmd_tail() {
  [ $# -le 1 ] || die "usage: valley tail [subject]"
  need_nats
  exec nats sub "${1:-valley.>}"
}

# One ref-updated event per existing ref, from git for-each-ref alone. A
# ref's prior value is not derivable from the repository, so `old` is the
# all-zero id — the same payload a push creating the ref would produce.
# The payload construction mirrors the host module's publisher hook
# (nix/valley-host.nix); change one only with the other.
cmd_replay() {
  [ $# -le 1 ] || die "usage: valley replay [repo-dir]"
  need_nats
  local dir="${1:-.}" repo sha ref event count=0
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 \
    || die "not a git repository: $dir"
  if [ "$(git -C "$dir" rev-parse --is-bare-repository)" = true ]; then
    repo="$(basename "$(git -C "$dir" rev-parse --absolute-git-dir)" .git)"
  else
    repo="$(basename "$(git -C "$dir" rev-parse --show-toplevel)")"
  fi
  while read -r sha ref; do
    # " is the only JSON-significant character a refname can contain (git
    # forbids \ and control characters); names and object ids are safe.
    event="$(printf '{"event":"ref-updated","repo":"%s","ref":"%s","old":"%s","new":"%s"}' \
      "$repo" "${ref//\"/\\\"}" "${sha//?/0}" "$sha")"
    nats pub "valley.git.$repo.ref-updated" "$event" >/dev/null
    count=$((count + 1))
  done < <(git -C "$dir" for-each-ref --format='%(objectname) %(refname)')
  echo "replayed $count refs of $repo onto the bus"
}

# ----------------------------------------------------------------------
# checks — the checks the verification policy requires of a change, and
# the classes requiring each. The verb is valley-go's (status/checks.go):
# it reads the policy's layers and derives with the Go deriver (derive/).
cmd_checks() {
  command -v valley-go > /dev/null 2>&1 \
    || die "checks needs the valley-go helper; nix run .#valley bundles it"
  VALLEY_TELEMETRY_SINCE="$TEL_T0" VALLEY_TELEMETRY_VERSION="$VALLEY_STAMP" \
    exec valley-go checks "$@"
}

# self-update installs the tip of a branch of the-valley into the user's
# nix profile (status/selfupdate.go). It is told this valley's stamp, which
# says what is installed until it has installed something itself.
cmd_self_update() {
  export VALLEY_VERSION="$VALLEY_STAMP"
  cmd_go self-update "$@"
}

cmd_version() {
  printf 'valley %s\n' "${VALLEY_STAMP:-unstamped (run from a checkout, not built by nix)}"
}

cmd_help() {
  [ $# -le 1 ] || die "usage: valley help [<verb>]"
  local out
  case "${1:-}" in
    '' | help | -h | --help) out="$(usage)" ;;
    pending) out="$(help_pending)" ;;
    changes) out="$(help_changes)" ;;
    review) out="$(help_review)" ;;
    approve) out="$(help_approve)" ;;
    rebase) out="$(help_rebase)" ;;
    status) out="$(help_status)" ;;
    ready) out="$(help_ready)" ;;
    unready) out="$(help_unready)" ;;
    withdraw) out="$(help_withdraw)" ;;
    knot) out="$(help_knot)" ;;
    plan) out="$(help_plan)" ;;
    checks) out="$(help_checks)" ;;
    tail) out="$(help_tail)" ;;
    replay) out="$(help_replay)" ;;
    self-update) out="$(help_self_update)" ;;
    telemetry) out="$(help_telemetry)" ;;
    *) die "unknown help topic: $1 (try 'valley help')" ;;
  esac
  printf '%s\n' "$out" 2> /dev/null || true
}

main() {
  local verb="${1:-help}"
  if [ $# -gt 0 ]; then shift; fi
  # The verb set is mirrored in completions/ (valley.bash, _valley) —
  # update both when it changes.
  case "$verb" in
    pending | changes | review | approve | rebase | status | ready | unready | withdraw | knot | plan | checks | tail | replay | self-update | telemetry)
      if [ $# -eq 1 ] && { [ "$1" = -h ] || [ "$1" = --help ]; }; then
        cmd_help "$verb"
        return
      fi
      ;;
  esac
  case "$verb" in
    review | checks | tail | replay)
      TEL_ARGS=("$verb" "$@")
      trap 'tel_command $?' EXIT
      ;;
  esac
  case "$verb" in
    pending) cmd_pending "$@" ;;
    review) cmd_review "$@" ;;
    approve) cmd_approve "$@" ;;
    rebase) cmd_rebase "$@" ;;
    status | ready | unready | withdraw | changes | knot | plan) cmd_go "$verb" "$@" ;;
    checks) cmd_checks "$@" ;;
    tail) cmd_tail "$@" ;;
    replay) cmd_replay "$@" ;;
    self-update) cmd_self_update "$@" ;;
    telemetry) cmd_go telemetry "$@" ;;
    --version) cmd_version ;;
    help | -h | --help) cmd_help "$@" ;;
    *)
      printf 'valley: unknown verb: %s\n\n' "$verb" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
