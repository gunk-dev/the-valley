#!/usr/bin/env bash
# valley — the S1 integrator's verbs, as a plain shell script.
#
# EVICTION CLAUSE (owner-ratified; the decision node is
# .the-valley/decisions/dcr-74c3158-valley-cli-lifecycle.md).
# This tool is deliberately a shell script: it runs from any checkout with
# nothing but git and coreutils — no machinery, the portability stance of
# ida-b9f646c. It GRADUATES to its own repo and a real language the moment
# ANY tripwire is crossed:
#   - it grows past ~300 lines;
#   - it needs persistent state, config, or a daemon
#     (CROSSED by review's notes, which outlive the session in
#     $XDG_STATE_HOME/valley/notes.);
#   - it needs dependencies beyond git + coreutils
#     (CROSSED by Phase 1's tail/replay, which need the nats CLI, and again
#     by checks, which needs the cue CLI, and again by review's [a]sk, which
#     needs the attest helper —
#     graduation is now owed; recording the decision node is part of taking it.);
#   - its behavior gets subtle enough to need real tests
#     (CROSSED by checks: glob matching is pinned by the policy-deriver
#     flake check, not by reading the code.);
#   - it needs nontrivial parsing or concurrency
#     (CROSSED by checks: glob-to-regex translation and -z diff parsing.).
# The size tripwire (~300 lines) is crossed too. Which way to take the
# graduation is dcr-2aa1a12, still `proposed`.
# Graduation is a deliberate act, recorded as a decision node.
# Precedent: klaus — born in cosmo, graduated deliberately.

set -euo pipefail

die() {
  printf 'valley: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
valley — S1 integrator verbs for a valley project

usage: valley <verb> [args]

  pending          list branches on origin not merged into origin/main
  review <branch>  page through the branch's log and diff vs origin/main,
                   then choose:
                     [a]sk        file an integration request. runs the
                                  checks the composed policy requires of
                                  this change over a throwaway worktree of
                                  the branch, signs each result as an
                                  attestation, and publishes the evidence
                                  and the request ref to origin in ONE
                                  atomic push. this submits the request;
                                  it does not wait for integration or
                                  update your local checkout. use status
                                  to read the result. the policy comes
                                  from the target's tip and the owning
                                  valley's, as checks describes below,
                                  so your checkout
                                  can be on any branch. a change the policy
                                  requires no check of is filed too, as a
                                  request with no evidence, and says so.
                                  asking again about a change already
                                  requested is how it is resubmitted. at a
                                  head rebased onto a moved main it
                                  replaces the request ref under a lease
                                  and names the head it replaced; at the
                                  same head it leaves the ref alone and
                                  publishes only the new evidence, which
                                  the create-only attestation namespace
                                  refuses when this signer has already
                                  attested that tree (bd-7b7d58f). every
                                  write of the request ref is leased,
                                  filing included, so a resubmission that
                                  lost a race is refused rather than
                                  clobbering the one that won.
                                  needs the attest helper and
                                  VALLEY_ATTEST_KEY, the ed25519 key this
                                  host signs with, whenever a check is
                                  owed; VALLEY_ATTEST_NAME is the name it
                                  signs under, defaulting to this host's.
                     [r]eject     delete the remote branch (confirmed first)
                     [s]kip       do nothing
                   [a]sk is the only way a change reaches main from here.
                   Nothing in this script writes the protected ref: the
                   integrator does, having judged the request.
                   a stale branch (won't fast-forward from main) is first
                   offered:
                     [b]ase       rebase it onto origin/main in a throwaway
                                  worktree, push --force-with-lease, then
                                  re-review the diff that would actually land
                   [a]sk is offered there too: a stale branch is nothing
                   the integrator cannot apply, so it need not be rebased
                   first.
                   while paging, press v: less opens the diff in $EDITOR.
                   every line you insert there is a note. it is anchored to
                   the file and new-side line it sits on — to the file alone
                   when it sits above the first hunk — then appended to
                   $XDG_STATE_HOME/valley/notes/<branch>.md (default
                   ~/.local/state) and printed after the verdict. notes
                   survive [b]ase. lines you change or delete instead of
                   inserting are ignored, with a warning.
  status <branch>  read the request and the integrator's last decision from
                   origin. distinguish waiting, a decision that needs
                   attention, and a change integrated into origin/main.
                   after integration, show how to update the local checkout.
                   fetches objects without moving local branches or files;
                   no checks run and no request is submitted.
  checks [<base> [<head>]]
                   print the check names the change between two commits owes
                   under the composed verification policy (dcr-f41f718), and
                   which class made each one required. It prints: no check is
                   run, nothing is gated, nothing is written.
                   base defaults to the merge base with main, head to HEAD.
                   by default both layers come from the target's tip
                   (origin/main), never from your checkout: the project's
                   own layer is policy/project there, and the owning valley
                   is named one line at policy/valley there, fetched and
                   read at policy/instance in that repository's integrated
                   tip. a valley's own config repository carries
                   policy/instance and uses it. a target carrying no
                   policy/project is derived under the floor alone; a floor
                   that is not there is refused. this is what the
                   integrator reads, so the answer is the same from any
                   branch, however stale. an option overrides each layer,
                   which is the only way to derive against a layer that
                   does not govern — the worked example under
                   examples/policy/, say:
                     --schema FILE    default schema/verification.cue
                     --instance DIR   default the owning valley's floor
                     --project DIR    default policy/project at the target
                   naming a layer stops this reading the source it
                   replaced. the schema is the shape a policy is written
                   in rather than a layer, so it comes from this checkout.
  tail [subject]   watch bus events scroll by (default subject: valley.>);
                   the server comes from the nats CLI's own config
                   (NATS_URL or a nats context; default localhost)
  replay [dir]     publish one ref-updated event per current ref of the
                   repo at dir (default: .) — rebuilds the stream's
                   projection, e.g. after nats stream purge valley
  help             show this help

Runs from any checkout of the project; needs only git and coreutils,
except tail and replay, which also need the nats CLI (natscli), checks,
which also needs the cue CLI, review's notes, which need less, and
review's [a]sk, which needs both the cue CLI and the attest helper.
Deriving a policy fetches the owning valley's repository, so checks and
[a]sk also need whatever reaching it takes.
No config, no batch mode, and no state but the notes file — the judgment
stays with the human.
EOF
}

fetch_origin() {
  git fetch --prune --quiet origin
}

# Resolve the pager as git would for a diff: pager.diff first (per-command
# pager configs — e.g. home-manager's delta module — set pager.diff and leave
# core.pager alone), then git var GIT_PAGER (core.pager, GIT_PAGER, PAGER,
# less). pager.<cmd> may legally be a boolean; treat true/false — and an
# empty or missing value — as unset and fall back. The value is
# shell-interpreted, hence sh -c.
diff_pager() {
  local pager
  pager="$(git config --get pager.diff || true)"
  case "$pager" in '' | true | false) pager="$(git var GIT_PAGER)" ;; esac
  printf '%s' "$pager"
}

# Page a file rather than a pipe, so less's v key has something to hand
# $EDITOR: with a real file open, v runs LESSEDIT, whose default
# `%E ?lm+%lm. %g` is the editor, +<line>, and the file name. That file is
# the review buffer, and editing it is how notes get written (see
# collect_notes). A pipe has no name, so less refuses to edit one — which is
# why review no longer pipes.
#
# The configured diff pager stays the renderer, but as less's input
# preprocessor rather than as the pager. It still reads the buffer on stdin
# exactly as it did when it was the pager, less displays what it emits, and
# less still calls the raw buffer "the current file" — so v edits the diff
# and not the rendering. The alternative was to page the buffer with no
# filter at all: exact, and it throws delta's rendering away, which is the
# worse trade for a verb whose whole job is reading a diff.
#
# What this costs is the line number. A filter that restructures the diff —
# delta's default rendering does — makes %lm a line of the rendered view, so
# the editor opens near the cursor rather than on it. A structure-preserving
# filter (pager.diff = `delta --color-only`) makes it exact. No anchor
# depends on it: a note is anchored by where it was inserted, not by where
# the editor opened.
page_file() {
  local file="$1" pager
  [ -t 1 ] || { cat -- "$file"; return; } # a non-tty just cats
  pager="$(diff_pager)"
  case "${pager%%[[:space:]]*}" in
    less | */less)
      # Already less: give it the file and there is no filter to run.
      sh -c "$pager \"\$1\"" sh "$file"
      return
      ;;
  esac
  # Without less there is no editor key; fall back to filtering into a pipe.
  command -v less > /dev/null 2>&1 || {
    sh -c "$pager" < "$file"
    return
  }
  # -R because the filter's color is the whole point of running it, and no
  # LESSCLOSE because a stray one would run against a buffer we still read.
  LESSOPEN="|$pager < %s" env -u LESSCLOSE less -R -- "$file"
}

pending_line() {
  local ref="$1" age author ahead stat
  age="$(git log -1 --format='%cr' "$ref")"
  author="$(git log -1 --format='%an' "$ref")"
  ahead="$(git rev-list --count "origin/main..$ref")"
  stat="$(git diff --shortstat "origin/main...$ref")"
  stat="${stat# }"
  printf '%s | %s | %s | ahead %s | %s\n' \
    "${ref#origin/}" "$age" "$author" "$ahead" "${stat:-no file changes}"
}

cmd_pending() {
  [ $# -eq 0 ] || die "pending takes no arguments"
  fetch_origin
  local ref found=0
  while IFS= read -r ref; do
    case "$ref" in
      origin/HEAD | origin/main) continue ;;
    esac
    found=1
    pending_line "$ref"
  done < <(git for-each-ref --format='%(refname:short)' \
    --no-merged=origin/main refs/remotes/origin)
  [ "$found" -eq 1 ] || echo "nothing pending"
}

reject() {
  local branch="$1" answer
  printf 'really delete origin/%s? [y/N] ' "$branch"
  read -r answer || answer=""
  case "$answer" in
    y | Y | yes)
      git push --quiet origin --delete "$branch"
      echo "rejected $branch: deleted from origin"
      ;;
    *) echo "kept $branch" ;;
  esac
}

# ----------------------------------------------------------------------
# review notes — the lines the reviewer inserts into the paged diff.
#
# The buffer the reviewer pages is a file, so the pager's editor key can open
# it (page_file). Whatever comes back with lines inserted is read as notes:
# no marker, no syntax, no mode — an inserted line is a note because it was
# not there before. What a note is *about* is where it sits, so each one is
# anchored to the file and the new-side line number of the diff line above
# it, which is the pair a reviewer would otherwise have to copy out by hand.

# The scratch directory holding the buffer and its pristine copy, and the
# notes taken so far in this review — a global because [b]ase pages a second
# time and the notes from the first pass are not thereby withdrawn.
REVIEW_TMP=""
NOTES=()

cleanup_review_tmp() {
  [ -n "$REVIEW_TMP" ] || return 0
  rm -rf "$REVIEW_TMP"
  REVIEW_TMP=""
}

# Where a branch's notes live. XDG_STATE_HOME is the right home for them:
# they are neither config nor cache, and losing them loses judgment.
notes_file() {
  printf '%s/valley/notes/%s.md\n' "${XDG_STATE_HOME:-$HOME/.local/state}" "$1"
}

# The anchor of every line of the buffer, by line: the file that line belongs
# to, and the new-side line number it sits on. Built in one pass so that
# anchoring a note is a lookup. An empty path means the line is above every
# file (the log); line 0 means the line is a file header, above every hunk.
ANCHOR_PATH=()
ANCHOR_LINE=()

anchor_buffer() {
  local file="$1" line path="" at=0 next=0 inhunk=0 rest
  ANCHOR_PATH=()
  ANCHOR_LINE=()
  while IFS= read -r line; do
    # Header lines are only headers outside a hunk: inside one, every line
    # carries a +/-/space prefix, so a diff of a diff cannot be misread.
    if [ "$inhunk" -eq 1 ]; then
      case "$line" in
        ' '* | '+'* | '')
          at="$next" # this line's own new-side number
          next=$((next + 1))
          ;;
        '-'* | \\*) ;; # a removal or the no-newline marker: no new-side line
        *) inhunk=0 ;;
      esac
    fi
    if [ "$inhunk" -eq 0 ]; then
      case "$line" in
        'diff --git '*)
          path=""
          # The b/ side, so a rename anchors to the name it will have.
          if [[ "$line" =~ ^diff\ --git\ a/(.*)\ b/(.*)$ ]]; then
            path="${BASH_REMATCH[2]}"
          fi
          at=0
          ;;
        '@@ '*)
          rest="${line#*+}" # -12,7 +34,9 @@ -> 34,9 @@
          at="${rest%%[!0-9]*}"
          [ -n "$at" ] || at=0
          next="$at"
          inhunk=1
          ;;
      esac
    fi
    ANCHOR_PATH+=("$path")
    ANCHOR_LINE+=("$at")
  done < "$file"
}

# The anchor for a note inserted after buffer line n, as it is written down.
anchor_of() {
  local n="$1" path line
  [ "$n" -ge 1 ] || { printf '(unanchored)'; return; }
  path="${ANCHOR_PATH[n - 1]:-}"
  line="${ANCHOR_LINE[n - 1]:-0}"
  if [ -z "$path" ]; then
    printf '(unanchored)'
  elif [ "$line" -eq 0 ]; then
    printf '%s' "$path"
  else
    printf '%s:%s' "$path" "$line"
  fi
}

# The notes in an edited buffer, one `anchor: text` line each. git says where
# the reviewer's lines landed; a hunk that removes nothing is an insertion,
# and the line it was inserted after is the anchor. A hunk that removes
# something is an edit of the diff itself — it anchors to nothing, since the
# line it would name is the line it changed — so it is dropped with a count.
notes_in() {
  local orig="$1" edited="$2" line rest at old insert=0 touched=0 text
  anchor_buffer "$orig"
  while IFS= read -r line; do
    case "$line" in
      '@@ '*)
        rest="${line#@@ -}" # 12,0 +13,2 @@ -> 12,0 +13,2 @@
        at="${rest%%[!0-9]*}"
        rest="${rest#"$at"}"
        old=1
        case "$rest" in
          ,*)
            rest="${rest#,}"
            old="${rest%%[!0-9]*}"
            ;;
        esac
        if [ "$old" -eq 0 ]; then
          insert=1
        else
          insert=0
          touched=$((touched + old))
        fi
        ;;
      '+'*)
        # Only inside an insertion hunk: the +++ of git's own header is not
        # a note, and neither is the new side of an edit.
        [ "$insert" -eq 1 ] || continue
        text="${line#+}"
        text="${text#"${text%%[![:space:]]*}"}"
        [ -n "$text" ] || continue # a blank line says nothing
        printf '%s: %s\n' "$(anchor_of "$at")" "$text"
        ;;
    esac
  done < <(git --no-pager diff --no-ext-diff --no-index -U0 -- "$orig" "$edited")
  [ "$touched" -eq 0 ] || printf \
    'valley: warning: %d changed or deleted diff line(s) ignored — a note is a line you insert\n' \
    "$touched" >&2
}

# Read the notes out of the paged buffer and keep them: appended to the
# branch's notes file under the commit they were taken against, and held for
# the print that follows the verdict. A notes file that cannot be written is
# a warning, never a failure — the notes are still printed, and a review is
# not undone by a missing directory.
collect_notes() {
  local branch="$1" sha="$2" file dir
  local -a found=()
  mapfile -t found < <(notes_in "$REVIEW_TMP/review.orig" "$REVIEW_TMP/review.diff")
  [ "${#found[@]}" -gt 0 ] || return 0
  NOTES+=("${found[@]}")
  file="$(notes_file "$branch")"
  dir="${file%/*}"
  mkdir -p "$dir" 2> /dev/null && {
    printf '## %s at %s\n\n' "$branch" "$sha"
    printf '%s\n' "${found[@]}"
    printf '\n'
  } >> "$file" 2> /dev/null && return 0
  printf 'valley: warning: could not write %s — the notes are printed only\n' \
    "$file" >&2
}

print_notes() {
  local branch="$1"
  [ "${#NOTES[@]}" -gt 0 ] || return 0
  printf '\n%d note(s) on %s, appended to %s:\n' \
    "${#NOTES[@]}" "$branch" "$(notes_file "$branch")"
  printf '  %s\n' "${NOTES[@]}"
}

show_review() {
  local branch="$1" sha
  sha="$(git rev-parse --short "refs/remotes/origin/$branch")"
  REVIEW_TMP="$(mktemp -d)"
  {
    printf 'branch %s, log against origin/main:\n\n' "$branch"
    git --no-pager log --oneline "origin/main..origin/$branch"
    printf '\n'
    git --no-pager diff "origin/main...origin/$branch"
  } > "$REVIEW_TMP/review.diff"
  cp "$REVIEW_TMP/review.diff" "$REVIEW_TMP/review.orig"
  page_file "$REVIEW_TMP/review.diff" || true # quitting the pager early is not an error
  collect_notes "$branch" "$sha"
  cleanup_review_tmp
}

# Throwaway worktree for review's [b]ase choice; a global so the traps can
# always clean it up — success, conflict, or ctrl-C. Never a mid-rebase state.
REBASE_WT=""
cleanup_rebase_wt() {
  [ -n "$REBASE_WT" ] || return 0
  git -C "$REBASE_WT" rebase --abort >/dev/null 2>&1 || true
  git worktree remove --force "$REBASE_WT" >/dev/null 2>&1 || true
  rm -rf "$REBASE_WT"
  REBASE_WT=""
}

# Everything review leaves outside the repository: the two throwaway
# worktrees, the paged buffer, the two policy layers read out of their
# tips, and the scratch the policy deriver writes into. One handler,
# installed once by cmd_review, so that no path through the verb — and no
# ctrl-C in the pager — leaves any of them behind.
cleanup_review() {
  cleanup_rebase_wt
  cleanup_ask_wt
  cleanup_policy_tmp
  cleanup_instance_tmp
  cleanup_project_tmp
  cleanup_review_tmp
}

# Rebase origin/<branch> onto origin/main in an isolated worktree — the
# user's checkout is never touched — and push with a lease so a concurrently
# updated branch is never clobbered. Mechanics only; the judgment on the
# rebased diff stays with the human, back at the review prompt.
rebase_onto_main() {
  local branch="$1"
  REBASE_WT="$(mktemp -d)"
  git worktree add --quiet --detach "$REBASE_WT" "refs/remotes/origin/$branch"
  if ! git -C "$REBASE_WT" rebase --quiet refs/remotes/origin/main; then
    cleanup_rebase_wt
    die "$branch conflicts with main — resolve by hand; nothing changed"
  fi
  if ! git -C "$REBASE_WT" push --quiet --force-with-lease \
    origin "HEAD:refs/heads/$branch"; then
    cleanup_rebase_wt
    die "lease on origin/$branch failed (it moved since the fetch); nothing pushed"
  fi
  cleanup_rebase_wt
  echo "rebased $branch onto origin/main, pushed with --force-with-lease"
}

# ----------------------------------------------------------------------
# ask — file an integration request for the branch under review.
#
# This is the one way a change reaches main from here: the checks the
# policy requires are run over the branch's tree and signed, the evidence
# and one request ref are published, and the integrator judges the request
# and lands it (design/integration.md). main is never touched from here.
#
# Nothing in this script writes the protected ref. Whether a given pusher
# may write it is a fact about origin's pre-receive hook, so origin is
# where it is answered, and a verb that merged onto main locally would only
# be asking the same question in a worse place.
#
# What this verb removes is a second push. `attest run --push` publishes
# the branch and the attestation refs in one atomic push and knows nothing
# about a request ref, so filing a request by hand is two beats: the
# evidence, then the request after it. In between, evidence stands
# published for a change nobody has asked to land. So this verb does not
# use --push at all. `attest run` without it stores each note at its ref in
# the repository and stops, and one `git push --atomic` then carries the
# evidence and the request together — all of it or none of it. Nothing in
# attest had to change for that; the sequencing was the whole of it.
#
# The branch itself is not in that push. What is under review is
# origin/<branch>, so the commit the request names is already on origin and
# the objects with it.

# The tree the checks run over: a throwaway worktree of the branch, as
# [b]ase uses, so that what is checked is the branch's tree and not the
# operator's working copy. A global, so the traps clean it up whatever
# happens.
ASK_WT=""
cleanup_ask_wt() {
  [ -n "$ASK_WT" ] || return 0
  git worktree remove --force "$ASK_WT" > /dev/null 2>&1 || true
  rm -rf "$ASK_WT"
  ASK_WT=""
}

# Report and fail, without leaving the review. A refusal here is not a
# reason to end the session: the branch is still under review and the
# operator can still answer. die() is for the verbs that have nothing left
# to offer.
refuse() {
  printf 'valley: %s\n' "$*" >&2
  return 1
}

# The change segment of a request ref. The integrator reads a request as
# <prefix>/<target>/<change> and refuses a change segment holding a slash
# (integrator/refs.go), so a branch name with one is written with dashes
# instead. The ref that results is printed, never left to be assumed.
#
# The mapping is lossy: `topic/x` and `topic-x` are one change name and so
# one request ref, and this verb cannot tell a sibling's request from its
# own. That is bd-57f7f9f, and what is done about it here is to print the
# subject of any request being replaced, so a collision is visible at the
# moment it happens rather than after it.
change_name() {
  printf '%s' "${1//\//-}"
}

# One line of a commit, for saying which commit is meant. A request being
# replaced is usually this operator's own pre-rebase head and so is in
# this repository; one another operator filed may not be, and saying so is
# better than printing an id alone.
subject_of() {
  local s
  if s="$(git log -1 --format=%s "$1" 2>/dev/null)" && [ -n "$s" ]; then
    printf '%s' "$s"
  else
    printf 'subject not in this repository'
  fi
}

# The value of a ref on origin, as one id or the empty string. Failing to
# read it is not the same as reading that it is absent, so the two are
# separate answers: this returns 1 for a read that did not happen.
remote_ref() {
  local out
  out="$(git ls-remote origin "$1" 2>/dev/null)" || return 1
  printf '%s' "$out" | cut -f1
  return 0
}

# Where the checks this run signed are stored, for every failure that
# happens after they have run. One stanza, so no failure path invents its
# own wording. Called with no refs it says nothing.
report_local_evidence() {
  [ "$#" -gt 0 ] || return 0
  printf 'valley: the evidence is stored locally at:\n' >&2
  printf '  %s\n' "$@" >&2
}

# Whether origin already holds one of these attestation refs at a value
# other than the one being pushed. The namespace admits creations only, so
# that is the one refusal asking again will never clear: it is what a
# re-observation of a tree this signer has already attested runs into
# (bd-7b7d58f).
attestation_stands_elsewhere() {
  local digest="$1" remote spec have want
  shift
  remote="$(git ls-remote origin "refs/the-valley/attestations/$digest/*" 2>/dev/null)" || return 1
  for spec in "$@"; do
    have="$(printf '%s\n' "$remote" | awk -v r="$spec" '$2 == r { print $1 }')"
    [ -n "$have" ] || continue
    want="$(git rev-parse "$spec" 2>/dev/null)" || continue
    [ "$have" = "$want" ] || return 0
  done
  return 1
}

# Why a push carrying the request ref failed, said as precisely as the
# state allows. Every such push is leased, and a lease refuses when the
# ref it named is not where the read before it saw it — which covers three
# different events. Reading the ref again is what tells them apart, and a
# read that does not happen is its own answer rather than a guess.
#
# Anything the lease is not responsible for is origin's own refusal, and
# git has already printed it.
diagnose_request_push() {
  local ref="$1" pending="$2" now
  if ! now="$(remote_ref "$ref")"; then
    refuse "origin refused the push, and $ref could not be read again to say why. Nothing was published there and main is untouched"
    return 0
  fi
  if [ "$now" = "$pending" ]; then
    refuse "origin refused the push; nothing was published there and main is untouched"
  elif [ -z "$now" ]; then
    refuse "the pending request was consumed while this one was being prepared, which is what the integrator does when a change lands. The lease on $ref refused and nothing was published; fetch and review the branch again before asking a second time"
  elif [ -z "$pending" ]; then
    refuse "a request for this change appeared while this one was being prepared, at $(git rev-parse --short "$now") ($(subject_of "$now")); the lease on $ref refused and nothing was published"
  else
    refuse "the pending request moved from $(git rev-parse --short "$pending") to $(git rev-parse --short "$now") while this one was being prepared; the lease on $ref refused, nothing was published, and the request stands where the other resubmission put it"
  fi
}

# File the request. Called from the review prompt in a condition, which
# suspends `set -e` for the whole call — so every step below is checked by
# hand, and the failures say what was published before they happened.
ask() {
  local branch="$1" target=main tip change head base digest root ref check spec
  local key
  local -a signer=() owed=() run=() evidence=()

  root="$(git rev-parse --show-toplevel)" || {
    refuse "not a git repository; nothing published"
    return 1
  }
  tip=refs/remotes/origin/main
  head="$(git rev-parse "refs/remotes/origin/$branch")" || {
    refuse "no such branch on origin: $branch; nothing published"
    return 1
  }
  base="$(git merge-base "$tip" "$head")" || {
    refuse "$branch and main share no history; nothing published"
    return 1
  }
  change="$(change_name "$branch")"
  ref="refs/the-valley/integration-requests/$target/$change"

  # What the change owes, read out of exactly the sources the integrator
  # reads: both layers from the target's tip, which review has just
  # fetched, and the floor from the owning valley's own tip. A change never
  # supplies the policy that gates it, and neither does the checkout this
  # runs from — so the answer here is the same answer the integrator will
  # derive, from whatever branch the operator happens to be on. It is
  # printed for exactly that reason.
  policy_defaults "$root"
  resolve_instance_layer "$root" "$tip" || return 1
  resolve_project_layer "$root" "$tip" || return 1
  derive_owed "$POLICY_SCHEMA" "$POLICY_INSTANCE" "$POLICY_PROJECT" \
    "$base" "$head" || return 1
  [ "${#DERIVED_OWED[@]}" -eq 0 ] \
    || mapfile -t owed < <(printf '%s\n' "${!DERIVED_OWED[@]}" | sort)

  # A change the policy asks nothing of is still a change, and asking is
  # how one reaches main. The integrator already lands a request owing no
  # check and records the landing as one that required nothing
  # (design/integration.md), so refusing to file it here would strand
  # exactly the changes the policy requires nothing of. Nothing is owed, so
  # nothing is signed and no key is needed: what gets published is one
  # request ref and no evidence at all.
  if [ "${#owed[@]}" -gt 0 ]; then
    key="${VALLEY_ATTEST_KEY:-}"
    [ -n "$key" ] || {
      refuse "no signing key: set VALLEY_ATTEST_KEY to the ed25519 key this host attests with. The host signs; nothing published"
      return 1
    }
    [ -f "$key" ] || {
      refuse "no signing key at $key; nothing published"
      return 1
    }
    command -v attest > /dev/null 2>&1 || {
      refuse "this choice needs the attest helper; nix run .#valley bundles it. Nothing published"
      return 1
    }
    signer=(--key "$key")
    [ -z "${VALLEY_ATTEST_NAME:-}" ] || signer+=(--name "$VALLEY_ATTEST_NAME")

    for check in "${owed[@]}"; do
      case "${CHECK_RUNNER[$check]:-}" in
        nix) run+=(--check "$check=${CHECK_ATTRIBUTE[$check]}") ;;
        command) run+=(--command "$check=${CHECK_COMMAND[$check]}") ;;
        *)
          refuse "the policy requires $check but does not say how to run it; nothing published"
          return 1
          ;;
      esac
    done

    cleanup_ask_wt
    ASK_WT="$(mktemp -d)" || {
      refuse "no scratch directory to check $branch in; nothing published"
      return 1
    }
    git worktree add --quiet --detach "$ASK_WT" "$head" || {
      cleanup_ask_wt
      refuse "could not check $branch out to run its checks; nothing published"
      return 1
    }

    printf '\nchecking %s at %s: %s\n' "$branch" "$(git rev-parse --short "$head")" \
      "$(printf '%s\n' "${owed[@]}" | join_lines)"
    if ! attest run --repo "$ASK_WT" "${signer[@]}" "${run[@]}"; then
      cleanup_ask_wt
      refuse "the checks did not pass; nothing published, main untouched"
      return 1
    fi
    digest="$(attest digest --repo "$ASK_WT")" || {
      cleanup_ask_wt
      refuse "could not digest the tree that was checked; nothing published"
      return 1
    }
    cleanup_ask_wt
    digest="${digest#*:}"

    # Every attestation stored for this tree, whoever signed it: the
    # evidence for this change is what the subject digest is keyed by, not
    # what this run happened to add to it.
    mapfile -t evidence < <(git for-each-ref --format='%(refname)' \
      "refs/the-valley/attestations/$digest")
    [ "${#evidence[@]}" -gt 0 ] || {
      refuse "no attestation is stored for $digest; nothing published"
      return 1
    }
  else
    printf '\n%s owes no check under %s + %s; filing the request with no evidence\n' \
      "$branch" "$POLICY_INSTANCE_LABEL" "$POLICY_PROJECT_LABEL"
  fi

  # What origin already holds for this request, read once and remembered.
  # Asking twice for the same change is ordinary: evidence expires, and a
  # change whose input closure moved under it is told to re-attest. So the
  # request ref may already exist, and what to do about it depends on
  # where it points. A read that does not happen is not a read that found
  # nothing, so it ends the verb here.
  local pending
  if ! pending="$(remote_ref "$ref")"; then
    refuse "could not read $ref from origin; nothing published"
    report_local_evidence ${evidence[@]+"${evidence[@]}"}
    return 1
  fi

  # The one push: every evidence ref as it stands, and the request ref
  # wherever it has to go. --atomic, so a hook that refuses any of them
  # leaves origin exactly as it was.
  #
  # Every write of the request ref is leased against exactly what the read
  # above saw, including when it saw nothing: git spells that expectation
  # `--force-with-lease=<ref>:` with an empty value, and it refuses if the
  # ref exists at all. So filing a change for the first time is a
  # compare-and-swap too. Without it, two operators filing one change at
  # once would have the second silently fast-forward the first away.
  #
  # A pending request at this same head is a re-attestation of the tree
  # already asked about. The evidence is new and the ref does not move, so
  # the ref is left out of the refspec entirely — a push cannot carry a
  # compare-and-swap on a ref it is not changing, because git leaves an
  # up-to-date ref out of what it sends. Nothing this run does establishes
  # where that ref stands afterwards, so it is read again below.
  #
  # A pending request at a different head is a replacement. This is the
  # shape a change takes when main moved through its checks' input
  # closures: no attestation over the old tree can transfer again, so the
  # cure is a new head rebased onto the moved main — and that head is not
  # a descendant of the old one, which makes replacing the ref a
  # non-fast-forward update that git refuses unless told.
  #
  # The lease is the whole of the force, and the refspec carries no `+`.
  # A leading `+` sets git's per-ref force flag, and that flag defeats
  # every rejection the push rules produce — the lease's stale-info among
  # them. The two together are a plain force wearing a lease's name.
  local -a push=() lease=()
  for spec in ${evidence[@]+"${evidence[@]}"}; do push+=("$spec:$spec"); done
  if [ "$pending" != "$head" ]; then
    lease+=("--force-with-lease=$ref:$pending")
    push+=("$head:$ref")
  fi

  # Nothing owed and the request already standing at this head leaves
  # nothing to push at all, and a push assembled with an empty refspec
  # would fall back to origin's default one. So none is made.
  local made_push=no
  if [ "${#push[@]}" -gt 0 ]; then
    made_push=yes
    if ! git push --atomic --quiet ${lease[@]+"${lease[@]}"} origin "${push[@]}"; then
      if [ "${#lease[@]}" -eq 0 ] \
        && attestation_stands_elsewhere "$digest" ${evidence[@]+"${evidence[@]}"}; then
        refuse "origin already holds an attestation for this tree from this signer, and that namespace admits creations only, so a second observation of the same tree has nowhere to go. That is bd-7b7d58f rather than anything asking again will clear. Nothing was published and main is untouched"
      else
        diagnose_request_push "$ref" "$pending"
      fi
      report_local_evidence ${evidence[@]+"${evidence[@]}"}
      return 1
    fi
  fi

  # The lines under the request line, which differ by what was found and
  # what was done about it.
  local -a standing=()

  if [ "$pending" = "$head" ]; then
    # The request ref was not in that push, so where it stands now is not
    # something this run established. Read it again rather than repeat
    # what was read before it: in between, the integrator may have landed
    # the change and consumed the ref, or another resubmission may have
    # replaced it.
    #
    # Nothing here writes it back. Re-creating a consumed request would
    # file a change already in the stream, which the commit rule calls out
    # as the state it consumes the ref to avoid; replacing a request
    # another resubmission has just filed would clobber the winner; and
    # either would be a second push behind the one this verb promises. So
    # what this does is say what is true and stop. Asking again is the
    # repair, and by then it takes the create or the replace path against
    # what is actually there.
    local after
    if ! after="$(remote_ref "$ref")"; then
      refuse "$ref could not be read again, so whether the request still stands at this head is not known here"
      report_local_evidence ${evidence[@]+"${evidence[@]}"}
      return 1
    fi
    if [ -z "$after" ]; then
      refuse "the request was consumed while this run was working, which is what the integrator does when a change lands. Nothing here re-filed it: a request for a change already in the stream is judged against an empty delta on every pass. Fetch and review $branch again, and ask once more if it has not landed"
      report_local_evidence ${evidence[@]+"${evidence[@]}"}
      return 1
    fi
    if [ "$after" != "$head" ]; then
      refuse "the request moved to $(git rev-parse --short "$after") ($(subject_of "$after")) while this run was working, so another resubmission filed it. Nothing here replaced it; ask again to replace it deliberately"
      report_local_evidence ${evidence[@]+"${evidence[@]}"}
      return 1
    fi
    if [ "$made_push" = yes ]; then
      standing+=("the request already stood at this head; the evidence is what was published")
    else
      standing+=("the request already stood at this head and nothing was owed, so nothing needed publishing")
    fi
  elif [ -n "$pending" ]; then
    standing+=("replaced the pending request, which stood at $(git rev-parse --short "$pending") ($(subject_of "$pending"))")
  fi

  printf '\nSubmitted %s (%s) for integration into origin/%s.\n' \
    "$branch" "$(git rev-parse --short "$head")" "$target"
  printf 'The integrator will decide whether this change can land.\n'
  printf 'Your local checkout has not changed.\n\n'
  printf 'Check the result: valley status %q\n\n' "$branch"
  printf '  request  %s -> %s\n' "$ref" "$(git rev-parse --short "$head")"
  [ "${#standing[@]}" -eq 0 ] || printf '  %s\n' "${standing[@]}"
  if [ "${#evidence[@]}" -eq 0 ]; then
    printf '  evidence none — nothing was owed, so nothing was signed\n'
    printf '  checks   none — the policy requires no check of this change\n'
  else
    printf '  evidence %s\n' "${evidence[@]}"
    printf '  checks   %s\n' "$(printf '%s\n' "${owed[@]}" | join_lines)"
  fi
}

# A status read is a snapshot of origin, not a replay of this checkout's
# cached refs. Fetch the advertised objects without writing FETCH_HEAD or
# moving branches. In particular, never prune locally produced evidence.
# The memo's first three fields are the same inputs the integrator uses
# to decide whether to judge a request again (integrator/refs.go).
cmd_status() {
  [ $# -eq 1 ] || die "usage: valley status <branch>"
  local branch="${1#origin/}" change request_ref outcome_ref snapshot oid ref
  local head="" target="" request="" outcome="" memo="" evidence
  local memo_head="" memo_tip="" memo_evidence="" decision="" failed_at="" extra=""
  local -a objects=() attestations=()
  git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
  git check-ref-format "refs/heads/$branch" >/dev/null 2>&1 \
    || die "not a branch name: $branch"
  change="$(change_name "$branch")"
  request_ref="refs/the-valley/integration-requests/main/$change"
  outcome_ref="refs/the-valley/integration-outcomes/main/$change"
  snapshot="$(git ls-remote --refs origin "refs/heads/$branch" refs/heads/main \
    "$request_ref" "$outcome_ref" 'refs/the-valley/attestations/*')" \
    || die "could not read origin; integration status is unknown. Try valley status $(printf '%q' "$branch") again"
  while read -r oid ref; do
    [ -n "$ref" ] || continue
    if [ "$ref" = refs/heads/main ]; then target="$oid"; fi
    if [ "$ref" = "refs/heads/$branch" ]; then head="$oid"; fi
    case "$ref" in
      "$request_ref") request="$oid" ;;
      "$outcome_ref") outcome="$oid" ;;
      refs/the-valley/attestations/*) attestations+=("$ref $oid") ;;
    esac
  done <<< "$snapshot"
  [ -n "$target" ] || die "origin has no main branch; integration status is unknown"
  if [ -z "$head$request$outcome" ]; then
    die "$branch: no remote branch or recorded integration request on origin"
  fi
  objects+=("$target")
  [ -z "$head" ] || objects+=("$head")
  [ -z "$request" ] || objects+=("$request")
  [ -z "$outcome" ] || objects+=("$outcome")
  git fetch --quiet --no-tags --no-write-fetch-head origin "${objects[@]}" \
    || die "could not fetch the status objects; origin may have changed. Try valley status $(printf '%q' "$branch") again"

  if [ -n "$outcome" ]; then
    memo="$(git cat-file blob "$outcome" 2>/dev/null)" || memo=""
    read -r memo_head memo_tip memo_evidence decision failed_at extra <<< "$memo" || true
    # Treat unsupported or damaged records as unknown, never as success.
    if [[ "$memo" == *$'\n'* || ! "$memo_head" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ \
      || ! "$memo_tip" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ \
      || ! "$memo_evidence" =~ ^[0-9a-f]{16}$ || -n "$extra" ]]; then
      decision="unknown"
    fi
    case "$decision" in
      land | stale | reject) [ -z "$failed_at" ] || decision="unknown" ;;
      failed) [ -n "$failed_at" ] || decision="unknown" ;;
      *) decision="unknown" ;;
    esac
  fi
  # A deleted topic can still have a pending request or a recorded result.
  [ -n "$head" ] || head="${request:-$memo_head}"

  # Main can advance before the integrator records its outcome. A failure
  # storing evidence afterwards must not hide an integration already there.
  if [ -n "$head" ] && git cat-file -e "$head^{commit}" 2>/dev/null \
    && git merge-base --is-ancestor "$head" "$target"; then
    printf '%s (%s): integrated into origin/main.\n' "$branch" "${head:0:7}"
    if [ -n "$request" ]; then
      printf 'The request for %s is still present at %s.\n' "${request:0:7}" "$request_ref"
    fi
    status_checkout "$target"
    return
  fi
  # An applied delta may land as a different commit. In that case the
  # matching land memo, rather than source-commit ancestry, is the report.
  if [ "$decision" = land ] && [ "$memo_head" = "$head" ] \
    && { [ -z "$request" ] || [ "$request" = "$head" ]; }; then
    printf '%s (%s): the integrator recorded it integrated into origin/main.\n' \
      "$branch" "${head:0:7}"
    status_checkout "$target"
    return
  fi

  if [ -n "$request" ] && [ "$request" != "$head" ]; then
    printf '%s (%s): latest commit not submitted.\n' "$branch" "${head:0:7}"
    printf 'An older request for %s is still pending at %s.\n' "${request:0:7}" "$request_ref"
    printf 'Review the latest commit: valley review %q\n' "$branch"
    return
  fi
  if [ "$decision" = unknown ]; then
    printf '%s: the stored outcome is unreadable; status is unknown.\n' "$branch"
    printf 'Ask the instance operator to inspect %s.\n' "$outcome_ref"
    return
  fi
  if [ -z "$request" ]; then
    printf '%s: not submitted; no pending request for this commit.\n' "$branch"
    if [ -n "$decision" ]; then
      printf 'Last recorded decision: %s for %s.\n' "$decision" "${memo_head:0:7}"
    fi
    printf 'Submit it through review: valley review %q\n' "$branch"
    return
  fi

  printf '%s (%s): ' "$branch" "${head:0:7}"
  if [ -z "$decision" ] || [ "$memo_head" != "$head" ]; then
    printf 'awaiting an integrator decision.\n'
  else
    evidence="$(
      if [ "${#attestations[@]}" -gt 0 ]; then printf '%s\n' "${attestations[@]}"; fi \
        | LC_ALL=C sort | sha256sum
    )"
    evidence="${evidence:0:16}"
    if [ "$memo_tip" != "$target" ] || [ "$memo_evidence" != "$evidence" ]; then
      printf 'awaiting a new decision; the target or evidence has changed.\n'
      printf 'Last recorded decision: %s.\n' "$decision"
    else
      case "$decision" in
        stale)
          printf 'needs attention; the integrator reported stale.\n'
          printf 'The change conflicts with main, or required evidence does not transfer.\n'
          ;;
        reject)
          printf 'the integrator rejected the evidence.\n'
          ;;
        failed)
          printf 'the integrator failed while processing the request (%s).\n' "$failed_at"
          printf 'This does not prove that nothing landed; recording can fail after main advances.\n'
          ;;
      esac
      printf 'The stored outcome has no detailed reason. Ask the instance operator for the integrator report.\n'
    fi
  fi
  printf 'Request: %s\n' "$request_ref"
  printf 'Check again: valley status %q\n' "$branch"
}

status_checkout() {
  local target="$1" current local_head
  if [ "$(git rev-parse --is-bare-repository)" = true ]; then
    printf 'This is a bare repository; there is no local checkout to update.\n'
    return
  fi
  current="$(git symbolic-ref --quiet --short HEAD)" || current="detached HEAD"
  local_head="$(git rev-parse --short HEAD)"
  printf 'Local checkout: %s at %s.\n' "$current" "$local_head"
  if git merge-base --is-ancestor "$target" HEAD; then
    printf 'Your local checkout already contains origin/main.\n'
  elif ! git show-ref --verify --quiet refs/heads/main; then
    printf 'To create a local main checkout:\n'
    printf '  git fetch origin\n  git switch --track -c main origin/main\n'
  elif git merge-base --is-ancestor "$target" refs/heads/main; then
    printf 'Local main already contains origin/main. To view it:\n  git switch main\n'
  elif ! git merge-base --is-ancestor refs/heads/main "$target"; then
    printf 'Local main has diverged from origin/main. Inspect the commits before updating:\n'
    printf '  git fetch origin\n  git log --oneline --left-right main...origin/main\n'
  else
    printf 'To update your local main checkout:\n'
    [ "$current" = main ] || printf '  git switch main\n'
    printf '  git pull --ff-only origin main\n'
  fi
}

# Page the branch and take the verdict. Split out of cmd_review so that
# every way out of it — ask, reject, skip — is followed by the notes.
read_and_decide() {
  local branch="$1" choice
  show_review "$branch"
  # A stale branch's pre-rebase diff is not what would land; offer to rebase it
  # mechanically, then re-review what actually would. [a]sk is offered here as
  # well, because the integrator applies a delta to the tip rather than
  # fast-forwarding: a stale branch is a request it can judge, and rebasing
  # first is a convenience rather than a precondition.
  while ! git merge-base --is-ancestor refs/remotes/origin/main \
    "refs/remotes/origin/$branch"; do
    printf '%s does not fast-forward from main: [a]sk, [b]ase onto main, [r]eject, [s]kip? ' \
      "$branch"
    read -r choice || die "stdin closed before an answer; nothing done"
    case "$choice" in
      a) ask "$branch" && return ;;
      b)
        rebase_onto_main "$branch"
        fetch_origin
        show_review "$branch"
        ;;
      r) reject "$branch" && return ;;
      s)
        echo "skipped $branch; nothing done"
        return
        ;;
      *) echo "answer a, b, r, or s" ;;
    esac
  done
  while true; do
    printf '%s: [a]sk, [r]eject, [s]kip? ' "$branch"
    read -r choice || die "stdin closed before an answer; nothing done"
    case "$choice" in
      # A refusal from ask is not a verdict: it says what it did not do and
      # the prompt comes back, so the branch can still be asked about again,
      # rejected or skipped.
      a) ask "$branch" && return ;;
      r) reject "$branch" && return ;;
      s)
        echo "skipped $branch; nothing done"
        return
        ;;
      *) echo "answer a, r, or s" ;;
    esac
  done
}

cmd_review() {
  [ $# -eq 1 ] || die "usage: valley review <branch>"
  local branch="${1#origin/}"
  fetch_origin
  git rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null \
    || die "no such branch on origin: $branch"
  trap cleanup_review EXIT
  trap 'exit 130' INT TERM
  read_and_decide "$branch"
  # The verdict disposes of the branch; the notes are what the human made of
  # it, so they are printed whatever the verdict was.
  print_notes "$branch"
}

# tail and replay are thin wrappers over the nats CLI — anything they do,
# plain nats and git can do. They are the only verbs needing more than git
# and coreutils.
need_nats() {
  command -v nats >/dev/null 2>&1 \
    || die "this verb needs the nats CLI (natscli); nix run .#valley bundles it"
}

cmd_tail() {
  [ $# -le 1 ] || die "usage: valley tail [subject]"
  need_nats
  exec nats sub "${1:-valley.>}"
}

# One ref-updated event per existing ref, from git for-each-ref alone. A
# ref's prior value is not derivable from the repository, so `old` is the
# all-zero id — the same payload a push creating the ref would produce.
# The payload construction mirrors the host module's publisher hook
# (nix/valley-host.nix); change one only with the other.
cmd_replay() {
  [ $# -le 1 ] || die "usage: valley replay [repo-dir]"
  need_nats
  local dir="${1:-.}" repo sha ref event count=0
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 \
    || die "not a git repository: $dir"
  if [ "$(git -C "$dir" rev-parse --is-bare-repository)" = true ]; then
    repo="$(basename "$(git -C "$dir" rev-parse --absolute-git-dir)" .git)"
  else
    repo="$(basename "$(git -C "$dir" rev-parse --show-toplevel)")"
  fi
  while read -r sha ref; do
    # " is the only JSON-significant character a refname can contain (git
    # forbids \ and control characters); names and object ids are safe.
    event="$(printf '{"event":"ref-updated","repo":"%s","ref":"%s","old":"%s","new":"%s"}' \
      "$repo" "${ref//\"/\\\"}" "${sha//?/0}" "$sha")"
    nats pub "valley.git.$repo.ref-updated" "$event" >/dev/null
    count=$((count + 1))
  done < <(git -C "$dir" for-each-ref --format='%(objectname) %(refname)')
  echo "replayed $count refs of $repo onto the bus"
}

# ----------------------------------------------------------------------
# checks — the verification-policy deriver (dcr-f41f718). It composes the
# instance layer with the project layer, matches every side of a diff
# against the composed classes, and prints the check names the change owes
# with the class or classes that made each one required. It reports: no
# check is run, nothing is gated, nothing is written.
#
# Composition is CUE's, never this script's. The whole of the mandatory-
# versus-overridable distinction is unification, so reimplementing it here
# would be reimplementing the decision. What this script does that CUE
# cannot is glob matching and reading a diff.

need_cue() {
  command -v cue >/dev/null 2>&1 \
    || die "this verb needs the cue CLI; nix run .#valley bundles it"
}

# One glob segment as an ERE fragment: `*` and `?` are wildcards that never
# cross a `/`, and every ERE metacharacter is escaped.
segment_ere() {
  local seg="$1" out="" i c
  for ((i = 0; i < ${#seg}; i++)); do
    c="${seg:i:1}"
    case "$c" in
      '*') out+='[^/]*' ;;
      '?') out+='[^/]' ;;
      '.' | '^' | '$' | '+' | '(' | ')' | '[' | ']' | '{' | '}' | '|' | \\) out+="\\$c" ;;
      *) out+="$c" ;;
    esac
  done
  printf '%s' "$out"
}

# A path glob as an anchored ERE, segment by segment. A `**` segment matches
# any number of segments including none, so it swallows the separator that
# would otherwise follow it and `a/**/b` matches `a/b`; every other segment
# matches exactly one.
glob_ere() {
  local ere='^' i last
  local -a segs=()
  IFS=/ read -r -a segs <<<"$1"
  last=$((${#segs[@]} - 1))
  for ((i = 0; i <= last; i++)); do
    if [ "${segs[i]}" = '**' ]; then
      if [ "$i" -eq "$last" ]; then ere+='.*'; else ere+='(.*/)?'; fi
    else
      ere+="$(segment_ere "${segs[i]}")"
      [ "$i" -eq "$last" ] || ere+='/'
    fi
  done
  printf '%s$' "$ere"
}

# The composed policy as one tab-separated line per covered pattern, per
# required check, and per field of the check catalogue, so the shell never
# parses CUE. Every line is three fields — a kind, a name, and a value —
# whatever the kind, so one reader takes them all. The field is hidden
# because the schema's sentinel rejects unknown top-level fields, and
# `unclassified` is rendered as a class of that name: it is one more source
# a check can come from.
#
# The catalogue is rendered because a caller that runs a check needs what
# the policy says a check IS — its runner, and the attribute or command
# line that runner takes. `checks` only reports and does not read it;
# review's [a]sk turns it into the arguments attest is given.
render_cue() {
  cat <<'EOF'
package verification

import (
	"list"
	"strings"
)

_render: strings.Join(list.Concat([[
	for cn, c in policy.classes
	for p, on in c.paths if on {"path\t\(cn)\t\(p)"}
], [
	for cn, c in policy.classes
	for k, on in c.requires if on {"requires\t\(cn)\t\(k)"}
], [
	for k, on in policy.unclassified if on {"requires\tunclassified\t\(k)"}
], [
	for n, c in policy.checks {"runner\t\(n)\t\(c.runner)"}
], [
	for n, c in policy.checks if c.runner == "nix" {"attribute\t\(n)\t\(c.attribute)"}
], [
	for n, c in policy.checks if c.runner == "command" {"command\t\(n)\t\(c.command)"}
]]), "\n")
EOF
}

# The composed layer, and a scratch directory for the documents the
# derivation writes into the composition. Globals so the probe below can
# see them.
POLICY_LAYER=()
POLICY_TMP=""

cleanup_policy_tmp() {
  [ -n "$POLICY_TMP" ] || return 0
  rm -rf "$POLICY_TMP"
  POLICY_TMP=""
}

# Where the schema and the two policy layers come from in a project
# following the convention (dcr-f41f718).
#
# The client derives from exactly the sources the integrator uses
# (integrator/policy.go), and the working tree is not among them. The
# project's own layer is read from the TARGET's tip, the pointer naming the
# owning valley is read from the target's tip, and the floor is read from
# that valley's integrated tip. A change never supplies the policy that
# gates it, and neither does whoever happens to be reviewing it: the
# reviewer's checkout may be any branch, however stale, and derivation
# gives the same answer from all of them.
#
# The schema is not a policy layer. It is the shape a policy is written in,
# it ships with this tool, and the integrator takes its own from its
# deployment rather than from the tip for the same reason.
#
# Neither layer is ever the worked example under examples/policy/ — a gate
# derived from an example is a gate nobody wrote. `checks` takes an option
# for each, so a reader can point it at the example or anywhere else on
# purpose; review's [a]sk takes no such option, because a request is filed
# against the policy that governs the project and nowhere else.
#
# Neither layer is a path in this tree, so policy_defaults leaves both
# empty and the two resolvers answer for them. That split is also what
# keeps `checks --instance DIR` from fetching a repository whose layer it
# was told to ignore, and `checks --project DIR` from reading a tip whose
# layer it was told to ignore.
POLICY_SCHEMA=""
POLICY_INSTANCE=""
POLICY_INSTANCE_LABEL=""
POLICY_PROJECT=""
POLICY_PROJECT_LABEL=""
policy_defaults() {
  POLICY_SCHEMA="$1/schema/verification.cue"
  POLICY_INSTANCE=""
  POLICY_INSTANCE_LABEL=""
  POLICY_PROJECT=""
  POLICY_PROJECT_LABEL=""
}

# The floor, copied out of a fetch of the owning valley's repository, and
# the project's own layer, copied out of the target's tip. Globals, so the
# traps clean them up whatever happens.
INSTANCE_TMP=""
cleanup_instance_tmp() {
  [ -n "$INSTANCE_TMP" ] || return 0
  rm -rf "$INSTANCE_TMP"
  INSTANCE_TMP=""
}

PROJECT_TMP=""
cleanup_project_tmp() {
  [ -n "$PROJECT_TMP" ] || return 0
  rm -rf "$PROJECT_TMP"
  PROJECT_TMP=""
}

# The directory each layer lives in, the file naming this project's owning
# valley, and the ref of that valley whose tip carries the floor. The floor
# resolves at the integrated tip, because a floor a project could pin is
# not a floor (dcr-f41f718).
INSTANCE_DIR=policy/instance
PROJECT_DIR=policy/project
VALLEY_POINTER=policy/valley
VALLEY_POINTER_REF=refs/heads/main

# The *.cue documents of one directory at one tree-ish, copied out of a
# repository into a directory on disk. Reading a tip with ls-tree and
# cat-file rather than checking it out is what lets the layers come from
# the target while the checkout stays on whatever branch the reviewer is
# on. 0 copied something, 1 the directory holds no *.cue, 2 the read
# failed.
#
# -z because a path may hold anything but NUL, and *.cue because the layer
# is the directory's documents — the same reading the composer takes.
copy_layer() {
  local gitdir="$1" treeish="$2" dir="$3" dest="$4" path name copied=0
  while IFS= read -r -d '' path; do
    case "$path" in *.cue) ;; *) continue ;; esac
    name="${path##*/}"
    git -C "$gitdir" cat-file blob "$treeish:$path" > "$dest/$name" || return 2
    copied=1
  done < <(git -C "$gitdir" ls-tree --name-only -z "$treeish" "$dir/")
  [ "$copied" -eq 1 ]
}

# The ref whose tip supplies the policy, printed the way a person names it,
# with the commit it stood at. Staleness in a remote-tracking ref is a real
# thing to see, so the report says which commit the layers came out of
# rather than only which ref.
target_label() {
  local ref="$1" short
  short="$(git rev-parse --short "$ref")" || short='?'
  ref="${ref#refs/remotes/}"
  ref="${ref#refs/heads/}"
  printf '%s %s' "$ref" "$short"
}

# Resolve the project's own layer, out of the target's tip, into
# POLICY_PROJECT, and set POLICY_PROJECT_LABEL to where it came from.
#
# A target carrying no layer of its own is derived under the floor alone.
# The project layer only ever adds (dcr-f41f718), so the identity of "adds"
# is "adds nothing"; refusing instead would make a repository underivable
# until its first policy commit, and that commit could not derive either.
# This is the integrator's own reading (integrator/policy.go), and the two
# have to agree about an absent layer as much as about a present one.
#
# Absence is answered with a document that adds nothing rather than with an
# argument left off, because the composer is handed a directory of *.cue
# and has no spelling for "no layer".
#
# It reports and returns rather than dying, for the reason derive_owed
# does: a refusal inside the review loop is not the end of the session.
resolve_project_layer() {
  local root="$1" target="$2" rc

  cleanup_project_tmp
  PROJECT_TMP="$(mktemp -d)" || {
    refuse "no scratch directory to read the project layer into; nothing derived"
    return 1
  }
  copy_layer "$root" "$target" "$PROJECT_DIR" "$PROJECT_TMP" && rc=0 || rc=$?
  case "$rc" in
    0)
      POLICY_PROJECT="$PROJECT_TMP"
      POLICY_PROJECT_LABEL="$PROJECT_DIR@$(target_label "$target")"
      ;;
    1)
      printf 'package verification\n' > "$PROJECT_TMP/adds-nothing.cue" || {
        cleanup_project_tmp
        refuse "could not compose an empty project layer; nothing derived"
        return 1
      }
      POLICY_PROJECT="$PROJECT_TMP"
      POLICY_PROJECT_LABEL="no $PROJECT_DIR@$(target_label "$target") — the floor alone"
      ;;
    *)
      cleanup_project_tmp
      refuse "could not read $PROJECT_DIR/ at $(target_label "$target"); nothing derived"
      return 1
      ;;
  esac
}

# The first line of the pointer that is neither blank nor a comment. Read
# in the shell so that naming an owning valley needs nothing beyond what
# the rest of this script needs.
pointer_url() {
  local line url=""
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] || continue
    url="$line"
    break
  done < "$1"
  printf '%s' "$url"
}

# Resolve the floor to a directory on disk, into POLICY_INSTANCE, and set
# POLICY_INSTANCE_LABEL to where it came from — a temporary directory is
# not an answer a reader can check.
#
# Every project has exactly one owning valley, and the floor is that
# valley's (dcr-9b5da04). It is read from the valley's own repository and
# never from the project's tree, which is the tree under judgment. Two
# shapes, and the first is a special case of the second:
#
#   - a valley's config repository carries policy/instance itself, and is
#     governed by that floor like every other project. It uses its own,
#     and fetches nothing.
#   - every other project names its owning valley at policy/valley. That
#     repository is fetched into scratch and its policy/instance is read
#     at the integrated tip. Fetching is all this needs, and anyone the
#     valley governs necessarily holds fetch on it.
#
# Both the pointer and a valley's own floor are read from the TARGET's tip
# and never from the working tree. The pointer is a file a branch can edit,
# so reading it from the branch would let a change name the valley that
# gates it; reading it from the checkout would let whoever is reviewing
# decide the same thing by accident, which is the failure this fixes. An
# absent floor is refused — that is the direction absence defaults in for
# this layer, because the floor is the minimum (dcr-f41f718).
#
# It reports and returns rather than dying, for the reason derive_owed
# does: a refusal inside the review loop is not the end of the session.
resolve_instance_layer() {
  local root="$1" target="$2" url bare dest rc
  cleanup_instance_tmp
  INSTANCE_TMP="$(mktemp -d)" || {
    refuse "no scratch directory to read the floor into; nothing derived"
    return 1
  }
  dest="$INSTANCE_TMP/instance"
  mkdir -p "$dest"

  copy_layer "$root" "$target" "$INSTANCE_DIR" "$dest" && rc=0 || rc=$?
  case "$rc" in
    0)
      POLICY_INSTANCE="$dest"
      POLICY_INSTANCE_LABEL="$INSTANCE_DIR@$(target_label "$target") (this repository is its own valley)"
      return 0
      ;;
    1) ;; # no floor of its own: the pointer names the valley that has one
    *)
      cleanup_instance_tmp
      refuse "could not read $INSTANCE_DIR/ at $(target_label "$target"); nothing derived"
      return 1
      ;;
  esac

  git -C "$root" cat-file blob "$target:$VALLEY_POINTER" > "$INSTANCE_TMP/pointer" 2> /dev/null || {
    cleanup_instance_tmp
    refuse "no owning valley: $VALLEY_POINTER names the repository whose $INSTANCE_DIR is this project's floor, and $(target_label "$target") carries no such file. A valley's own config repository carries $INSTANCE_DIR instead. Nothing derived"
    return 1
  }
  url="$(pointer_url "$INSTANCE_TMP/pointer")"
  [ -n "$url" ] || {
    cleanup_instance_tmp
    refuse "$VALLEY_POINTER at $(target_label "$target") names no repository — it wants one line, the owning valley as git fetch takes it; nothing derived"
    return 1
  }

  bare="$INSTANCE_TMP/valley.git"
  git init --quiet --bare "$bare" || {
    cleanup_instance_tmp
    refuse "no scratch repository to fetch the floor into; nothing derived"
    return 1
  }
  git -C "$bare" fetch --quiet --depth 1 "$url" "$VALLEY_POINTER_REF" || {
    cleanup_instance_tmp
    refuse "could not fetch the owning valley $url at $VALLEY_POINTER_REF (named by $VALLEY_POINTER at $(target_label "$target")); nothing derived"
    return 1
  }

  copy_layer "$bare" FETCH_HEAD "$INSTANCE_DIR" "$dest" && rc=0 || rc=$?
  case "$rc" in
    0) ;;
    1)
      cleanup_instance_tmp
      refuse "the owning valley $url holds no *.cue in $INSTANCE_DIR/ at $VALLEY_POINTER_REF; nothing derived"
      return 1
      ;;
    *)
      cleanup_instance_tmp
      refuse "could not read $INSTANCE_DIR/ from $url; nothing derived"
      return 1
      ;;
  esac

  POLICY_INSTANCE="$dest"
  POLICY_INSTANCE_LABEL="$url $INSTANCE_DIR@$VALLEY_POINTER_REF"
}

# Is this check mandatory in this class, or a default the project left
# alone? The bit is the form of the composed value, so the test is CUE's
# own: a project supplying `false` either conflicts or unifies cleanly.
# Answering by unifying rather than by inspecting syntax means the script
# cannot disagree with `cue vet`.
check_is_mandatory() {
  local class="$1" check="$2" field
  if [ "$class" = unclassified ]; then
    field="policy: unclassified: \"$check\": false"
  else
    field="policy: classes: \"$class\": requires: \"$check\": false"
  fi
  printf 'package verification\n%s\n' "$field" > "$POLICY_TMP/probe.cue"
  ! cue vet "${POLICY_LAYER[@]}" "$POLICY_TMP/probe.cue" > /dev/null 2>&1
}

# Every side of the diff: an added, modified or deleted path, and both the
# old and the new path of a rename or copy. -z because a path may contain
# anything but NUL.
diff_paths() {
  local base="$1" head="$2" status path
  while IFS= read -r -d '' status; do
    IFS= read -r -d '' path || die "truncated diff output; nothing derived"
    printf '%s\n' "$path"
    case "$status" in
      R* | C*)
        IFS= read -r -d '' path || die "truncated diff output; nothing derived"
        printf '%s\n' "$path"
        ;;
    esac
  done < <(git diff --no-relative --name-status -M -z "$base" "$head")
}

# Lines in, one comma-separated line out.
join_lines() {
  local out="" line
  while IFS= read -r line; do out="${out:+$out, }$line"; done
  printf '%s' "$out"
}

# The target: the ref a change is derived against, and the tip both policy
# layers are read out of. origin's answer is preferred, because the target
# is the branch as the integrator holds it and not as this checkout last
# built it.
target_ref() {
  git rev-parse --verify --quiet refs/remotes/origin/main > /dev/null \
    && { echo refs/remotes/origin/main; return; }
  git rev-parse --verify --quiet refs/heads/main > /dev/null \
    && { echo refs/heads/main; return; }
  return 1
}

# ----------------------------------------------------------------------
# The derivation itself, and the globals it answers with. Everything a
# caller could want from the policy comes out of one pass, because every
# part of it is a function of the same composition: `checks` prints the
# answer, review's [a]sk runs what it names.
#
# It reports and returns rather than dying, so that a caller inside the
# review loop is refused rather than ended. Its callers are all in a
# condition, which suspends `set -e` for the whole call, so every step is
# checked by hand.
DERIVED_PATHS=()     # every side of the diff, sorted
DERIVED_MATCHED=()   # the class names at least one path matched, sorted
DERIVED_UNCOVERED=() # the paths no class covered
DERIVED_OWES=0       # whether `unclassified` is what owes something
declare -A DERIVED_OWED=()    # check -> the classes that required it
declare -A DERIVED_PINNED=()  # check -> mandatory | default
declare -A CHECK_RUNNER=()    # check -> nix | command
declare -A CHECK_ATTRIBUTE=() # check -> the flake check attribute
declare -A CHECK_COMMAND=()   # check -> the command line

derive_owed() {
  local schema="$1" instance="$2" project="$3" base="$4" head="$5"

  need_cue
  [ -f "$schema" ] || {
    refuse "no policy schema at $schema; nothing derived"
    return 1
  }
  # An unmatched glob stays literal, so the first entry is a real file
  # exactly when the directory holds a document.
  local -a instance_docs=("$instance"/*.cue) project_docs=("$project"/*.cue)
  [ -f "${instance_docs[0]}" ] || {
    refuse "no instance policy layer at $instance; nothing derived"
    return 1
  }
  [ -f "${project_docs[0]}" ] || {
    refuse "no project policy layer at $project: a project's own layer is the *.cue documents under $PROJECT_DIR/ (dcr-f41f718). Nothing derived"
    return 1
  }

  DERIVED_PATHS=()
  mapfile -t DERIVED_PATHS < <(diff_paths "$base" "$head" | sort -u)

  cleanup_policy_tmp
  POLICY_LAYER=("$schema" "${instance_docs[@]}" "${project_docs[@]}")
  POLICY_TMP="$(mktemp -d)" || {
    refuse "no scratch directory to compose the policy in; nothing derived"
    return 1
  }
  render_cue > "$POLICY_TMP/render.cue"
  cue vet -c "${POLICY_LAYER[@]}" || {
    refuse "the policy layers do not compose; nothing derived"
    return 1
  }

  # Sorted once here, so every list below comes out in a stable order.
  local -a rendered=()
  mapfile -t rendered < <(cue eval --out text -e _render \
    "${POLICY_LAYER[@]}" "$POLICY_TMP/render.cue" | sort)

  unset CHECK_RUNNER CHECK_ATTRIBUTE CHECK_COMMAND DERIVED_OWED DERIVED_PINNED
  declare -gA CHECK_RUNNER=() CHECK_ATTRIBUTE=() CHECK_COMMAND=() \
    DERIVED_OWED=() DERIVED_PINNED=()

  # The middle field is a class name for a coverage or requirement line and
  # a check name for a catalogue one; `key` is what both are.
  local -a pat_class=() pat_ere=() req_class=() req_check=()
  local line kind key value
  for line in "${rendered[@]}"; do
    kind="${line%%$'\t'*}"
    key="${line#*$'\t'}"
    value="${key#*$'\t'}"
    key="${key%%$'\t'*}"
    case "$kind" in
      path)
        pat_class+=("$key")
        pat_ere+=("$(glob_ere "$value")")
        ;;
      requires)
        req_class+=("$key")
        req_check+=("$value")
        ;;
      runner) CHECK_RUNNER["$key"]="$value" ;;
      attribute) CHECK_ATTRIBUTE["$key"]="$value" ;;
      command) CHECK_COMMAND["$key"]="$value" ;;
    esac
  done

  local -A matched=()
  local path i hit
  DERIVED_UNCOVERED=()
  for path in "${DERIVED_PATHS[@]}"; do
    hit=0
    for ((i = 0; i < ${#pat_ere[@]}; i++)); do
      if [[ "$path" =~ ${pat_ere[i]} ]]; then
        matched["${pat_class[i]}"]=1
        hit=1
      fi
    done
    [ "$hit" -eq 1 ] || DERIVED_UNCOVERED+=("$path")
  done
  # A path no class covers is answered by the policy's `unclassified` set,
  # which is why it is treated as one more matched class rather than as an
  # absence.
  [ "${#DERIVED_UNCOVERED[@]}" -eq 0 ] || matched[unclassified]=1

  local check
  DERIVED_OWES=0
  for ((i = 0; i < ${#req_check[@]}; i++)); do
    key="${req_class[i]}"
    check="${req_check[i]}"
    [ -n "${matched[$key]:-}" ] || continue
    [ "$key" != unclassified ] || DERIVED_OWES=1
    DERIVED_OWED["$check"]="${DERIVED_OWED[$check]:+${DERIVED_OWED[$check]}, }$key"
    if check_is_mandatory "$key" "$check"; then
      DERIVED_PINNED["$check"]=mandatory
    else
      DERIVED_PINNED["$check"]="${DERIVED_PINNED[$check]:-default}"
    fi
  done

  DERIVED_MATCHED=()
  [ "${#matched[@]}" -eq 0 ] \
    || mapfile -t DERIVED_MATCHED < <(printf '%s\n' "${!matched[@]}" | sort)
}

cmd_checks() {
  local root schema instance="" label project="" plabel base head target=""
  root="$(git rev-parse --show-toplevel 2> /dev/null)" \
    || die "not a git repository"
  policy_defaults "$root"
  schema="$POLICY_SCHEMA"
  while [ $# -gt 0 ]; do
    case "$1" in
      --schema) [ $# -ge 2 ] || die "--schema needs a file"; schema="$2"; shift 2 ;;
      --instance) [ $# -ge 2 ] || die "--instance needs a directory"; instance="$2"; shift 2 ;;
      --project) [ $# -ge 2 ] || die "--project needs a directory"; project="$2"; shift 2 ;;
      --) shift; break ;;
      -*) die "unknown option: $1" ;;
      *) break ;;
    esac
  done
  [ $# -le 2 ] || die "usage: valley checks [options] [<base> [<head>]]"

  head="$(git rev-parse --verify --quiet "${2:-HEAD}^{commit}")" \
    || die "no such commit: ${2:-HEAD}"
  # The target is what the layers are read out of, so it is needed whenever
  # either layer is left to its default — and it is what an unnamed base
  # is the merge base with.
  if [ -z "$instance" ] || [ -z "$project" ] || [ $# -lt 1 ]; then
    target="$(target_ref)" \
      || die "no main branch: the target's tip is where the policy layers are read from, and there is none here"
  fi
  if [ $# -ge 1 ]; then
    base="$(git rev-parse --verify --quiet "$1^{commit}")" \
      || die "no such commit: $1"
  else
    base="$(git merge-base "$target" "$head")" \
      || die "$head and ${target#refs/} do not share history — name a base"
  fi

  trap 'cleanup_policy_tmp; cleanup_instance_tmp; cleanup_project_tmp' EXIT
  # Each layer is resolved only when nobody named one. --instance and
  # --project are a reader pointing this at a layer on purpose, and
  # honouring that means not fetching the repository, and not reading the
  # tip, that the named layer replaced.
  if [ -n "$instance" ]; then
    label="${instance#"$root"/}"
  else
    resolve_instance_layer "$root" "$target" || exit 1
    instance="$POLICY_INSTANCE"
    label="$POLICY_INSTANCE_LABEL"
  fi
  if [ -n "$project" ]; then
    plabel="${project#"$root"/}"
  else
    resolve_project_layer "$root" "$target" || exit 1
    project="$POLICY_PROJECT"
    plabel="$POLICY_PROJECT_LABEL"
  fi
  derive_owed "$schema" "$instance" "$project" "$base" "$head" || exit 1

  local check width=0
  for check in "${!DERIVED_OWED[@]}"; do
    [ "${#check}" -le "$width" ] || width="${#check}"
  done

  printf '%s..%s: %d changed path(s)\n' \
    "$(git rev-parse --short "$base")" "$(git rev-parse --short "$head")" \
    "${#DERIVED_PATHS[@]}"
  printf 'policy: %s + %s\n' "$label" "$plabel"
  if [ "${#DERIVED_MATCHED[@]}" -eq 0 ]; then
    printf 'classes matched: none\n\n'
  else
    printf 'classes matched: %s\n\n' \
      "$(printf '%s\n' "${DERIVED_MATCHED[@]}" | join_lines)"
  fi

  if [ "${#DERIVED_OWED[@]}" -eq 0 ]; then
    echo "required checks: none"
  else
    echo "required checks:"
    while IFS= read -r check; do
      printf '  %-*s  %-9s  %s\n' \
        "$width" "$check" "${DERIVED_PINNED[$check]}" "${DERIVED_OWED[$check]}"
    done < <(printf '%s\n' "${!DERIVED_OWED[@]}" | sort)
  fi

  if [ "${#DERIVED_UNCOVERED[@]}" -gt 0 ]; then
    printf '\nunclassified: %d path(s) matched no class\n' "${#DERIVED_UNCOVERED[@]}"
    printf '  %s\n' "${DERIVED_UNCOVERED[@]}"
    # The failure the `unclassified` field exists to prevent: paths outside
    # every class that the policy then asks nothing of.
    [ "$DERIVED_OWES" -eq 1 ] \
      || echo "  the policy requires nothing of them — it is behind the tree"
  fi
}

main() {
  local verb="${1:-help}"
  if [ $# -gt 0 ]; then shift; fi
  # The verb set is mirrored in completions/ (valley.bash, _valley) —
  # update both when it changes.
  case "$verb" in
    pending) cmd_pending "$@" ;;
    review) cmd_review "$@" ;;
    status) cmd_status "$@" ;;
    checks) cmd_checks "$@" ;;
    tail) cmd_tail "$@" ;;
    replay) cmd_replay "$@" ;;
    help | -h | --help) usage ;;
    *)
      printf 'valley: unknown verb: %s\n\n' "$verb" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
