#compdef valley
# zsh completion for valley. The verb list mirrors the case statement in
# bin/valley — update both together.
#
# NEVER fetch from here: completion runs on every <TAB> and must be instant.
# Candidates come from the remote-tracking refs of the last fetch and from
# the handle cache the last valley pending or valley changes wrote; valley's
# own verbs resolve a name against origin before acting, so stale candidates
# cost nothing.

_valley() {
  if (( CURRENT == 2 )); then
    local -a verbs=(
      'pending:list the changes not yet landed, the unrecorded branches, and the drafts'
      'changes:print every change, across the host, as valley-changes/v1 JSON'
      'review:page through a change, or a stack bottom-up, then approve, reject, or skip'
      'approve:approve a change without paging it, filing its integration request'
      'rebase:rebase a change onto origin/main and push it with a lease'
      'status:read the integration result for a change from origin'
      'ready:mark a head of a branch ready as a new version of its change'
      'unready:make a ready change a draft'
      'withdraw:mark a ready change or a draft withdrawn'
      'checks:print the checks the composed policy requires of a change'
      'tail:watch bus events scroll by'
      'replay:publish ref-updated events for the current refs of a repo'
      'help:show help'
    )
    _describe -t verbs 'valley verb' verbs
  elif (( CURRENT == 3 )) && [[ ${words[2]} == replay ]]; then
    _files -/
  elif [[ ${words[2]} == checks && ${words[CURRENT-1]} == --cost ]]; then
    compadd quick slow
  elif [[ ${words[2]} == checks && ${words[CURRENT]} == -* ]]; then
    local -a opts=(
      '--schema:the policy schema to compose against'
      '--instance:the instance policy layer directory'
      '--project:the project policy layer directory'
      '--names:print only the required check names, one per line'
      '--cost:with --names, only the quick or the slow checks'
    )
    _describe -t options 'valley checks option' opts
  elif [[ ${words[2]} == ready && ${words[CURRENT]} == -* ]]; then
    local -a opts=(
      '--head:the head to mark ready, already on origin'
      '--change:the change ID to record the version under'
      '--if-active:add the version only while the change is ready at this active head'
      '--stamp:carry the change ID in the head as a Change-Id trailer'
    )
    _describe -t options 'valley ready option' opts
  elif [[ ${words[2]} == ready && ${words[CURRENT-1]} == --(head|change|if-active) ]]; then
    return
  elif [[ ${words[2]} == approve && ${words[CURRENT]} == -* ]]; then
    local -a opts=('--head:the exact head to approve, one of the change'"'"'s version heads')
    _describe -t options 'valley approve option' opts
  elif [[ ${words[2]} == approve && ${words[CURRENT-1]} == --head ]]; then
    return
  elif [[ ${words[2]} == pending && ${words[CURRENT]} == -* ]]; then
    local -a opts=(
      '--all:every project the serving host publishes'
      '--repo:that one project'
      '--checks:the checks each change requires, by cost'
      '--json:print valley-pending/v1 JSON'
    )
    _describe -t options 'valley pending option' opts
  elif [[ ${words[2]} == changes && ${words[CURRENT]} == -* ]]; then
    local -a opts=(
      '--json:print valley-changes/v1 JSON'
      '--all:every project the serving host publishes'
      '--repo:that one project'
    )
    _describe -t options 'valley changes option' opts
  elif [[ ${words[2]} == status && ${words[CURRENT]} == -* ]]; then
    local -a opts=('--json:print the status as one valley-status/v1 JSON object')
    _describe -t options 'valley status option' opts
  elif [[ ${words[2]} == (review|approve|rebase|status|unready|withdraw) ]] \
    && { (( CURRENT == 3 )) || [[ ${words[2]} == (status|approve) ]]; }; then
    _valley_change_names ${words[2]}
  elif [[ ${words[2]} == ready ]]; then
    _valley_branch_names ready
  fi
}

# Cached topic branches on origin. Review, approve, rebase, unready, withdraw
# and ready filter out merged branches; status needs those too. Silent
# outside a git repo — no errors mid-typing.
_valley_branch_names() {
  local -a branches selection
  selection=()
  [[ $1 != status ]] && selection=(--no-merged=origin/main)
  branches=(${(f)"$(git for-each-ref refs/remotes/origin \
    --format='%(refname)' "${selection[@]}" 2>/dev/null)"})
  branches=(${branches:#refs/remotes/origin/HEAD})
  branches=(${branches:#refs/remotes/origin/main})
  branches=(${branches#refs/remotes/origin/})
  (( ${#branches} )) && compadd -a branches
  return 0
}

# What a verb that takes a change offers: the handles in the cache valley
# pending and valley changes write, each described by its title and ready
# changes first, then the branches. Without the cache, the branches alone.
# The cache is $(git rev-parse --git-common-dir)/valley/handles, one line
# per change: handle, state, branch, title, tab-separated.
_valley_change_names() {
  local dir cache line
  local -a fields described
  dir=$(git rev-parse --git-common-dir 2>/dev/null)
  cache=$dir/valley/handles
  if [[ -n $dir && -r $cache ]]; then
    while IFS= read -r line; do
      fields=("${(@ps:\t:)line}")
      [[ -n ${fields[1]} ]] || continue
      described+=("${fields[1]//:/\\:}:${fields[4]}")
    done < $cache
    (( ${#described} )) && _describe -V -t handles 'change handle' described
  fi
  _valley_branch_names $1
}

_valley "$@"
