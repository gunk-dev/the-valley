{{define "content"}}
{{template "project-head" .Head}}
<header class="knot-head">
  <div class="meta"><span class="eyebrow">History</span><span class="mono">{{.Short}}</span>{{if .AtTip}}<span class="chip">main's published tip</span>{{end}}</div>
  <h1>History of {{.Project}}</h1>
</header>
<div class="card">
  <table class="listing">
    <tbody>
      {{- range .Commits}}
      <tr><td class="name"><a href="{{.URL}}">{{.Short}}</a></td><td>{{.Subject}}{{with .Parents}}<p class="notice">{{.}}</p>{{end}}</td><td class="kind">{{.Author}}</td><td class="kind">{{.Date}}</td></tr>
      {{- end}}
    </tbody>
  </table>
  {{- if .Partial}}
  <p class="notice">This page ends early: its commits are larger than a page reads.</p>
  {{- end}}
  {{- if .Crowded}}
  <p class="notice">This page ends early, before a commit that would leave more lines of history than one page can link to.</p>
  {{- end}}
  {{- with .Others}}
  <p class="notice">Older history continues along {{$.Lines}} lines at once, more than the Older link follows. Each link below follows one of the remaining lines.</p>
  <p class="mono">{{range .}}<a href="{{.URL}}">{{.Text}}</a> {{end}}</p>
  {{- end}}
</div>
<nav class="pager" aria-label="Pages of history">{{with .Newest}}<a href="{{.}}">Newest</a>{{end}}{{with .Older}}<a href="{{.}}">Older</a>{{end}}</nav>
{{end}}
