{{define "content"}}
{{template "project-head" .Head}}
<h1>{{.Project}}</h1>
{{template "source-head" .}}
<div class="card">
  <table class="listing">
    <tbody>
      {{- range .Entries}}
      <tr><td class="name">{{if .URL}}<a href="{{.URL}}">{{.Name}}{{if eq .Kind "directory"}}/{{end}}</a>{{else}}{{.Name}}{{end}}</td><td class="kind">{{.Kind}}</td><td class="size">{{.Size}}</td></tr>
      {{- else}}
      <tr><td class="muted">This directory is empty.</td></tr>
      {{- end}}
    </tbody>
  </table>
  {{- if .Partial}}
  <p class="notice">This directory is larger than a page reads, so only part of it is listed.</p>
  {{- else if .Omitted}}
  <p class="notice">{{.Omitted}} more entries are not listed.</p>
  {{- end}}
</div>
{{- with .Readme}}
<section class="panel" aria-labelledby="README">
  <h2 id="README"><a href="{{.URL}}">{{.Name}}</a></h2>
  <div class="card">{{if .Notice}}<p class="notice">{{.Notice}}</p>{{else}}{{if .Partial}}<p class="notice">This README is longer than a page shows, and only its start is shown.</p>{{end}}{{with .Doc}}{{template "document" .}}{{else}}<pre class="text">{{.Text}}</pre>{{end}}{{end}}</div>
</section>
{{- end}}
{{end}}
{{define "source-download"}}
    <a href="{{.ArchiveURL}}">Download .tar.gz</a>
{{- end}}
